{"version":2,"surah":101,"verses":[{"n":1,"key":"101:1","arabic":" ٱلْقَارِعَةُ","page":600,"juz":30,"en":"The Striking Calamity -","id":"Hari Kiamat,","latinEn":"AlqariAAa","latinId":"Al-qāri‘ah(tu).","words":[{"a":"ٱلْقَارِعَةُ","en":"The Striking Calamity","id":"The Striking Calamity","t":"al-qāriʿatu"}]},{"n":2,"key":"101:2","arabic":"مَا ٱلْقَارِعَةُ","page":600,"juz":30,"en":"What is the Striking Calamity?","id":"Apakah hari Kiamat itu?","latinEn":"Ma alqariAAa","latinId":"Mal-qāri‘ah(tu).","words":[{"a":"مَا","en":"What","id":"What","t":"mā"},{"a":"ٱلْقَارِعَةُ","en":"(is) the Striking Calamity","id":"(is) the Striking Calamity","t":"l-qāriʿatu"}]},{"n":3,"key":"101:3","arabic":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ","page":600,"juz":30,"en":"And what can make you know what is the Striking Calamity?","id":"Dan tahukah kamu apakah hari Kiamat itu?","latinEn":"Wama adraka ma alqariAAa","latinId":"Wa mā adrāka mal-qāri‘ah(tu).","words":[{"a":"وَمَآ","en":"And what","id":"And what","t":"wamā"},{"a":"أَدْرَىٰكَ","en":"will make you know","id":"will make you know","t":"adrāka"},{"a":"مَا","en":"what","id":"what","t":"mā"},{"a":"ٱلْقَارِعَةُ","en":"(is) the Striking Calamity","id":"(is) the Striking Calamity","t":"l-qāriʿatu"}]},{"n":4,"key":"101:4","arabic":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ","page":600,"juz":30,"en":"It is the Day when people will be like moths, dispersed,","id":"Pada hari itu manusia seperti laron yang beterbangan,","latinEn":"Yawma yakoonu annasu kalfarashialmabthooth","latinId":"Yauma yakūnun-nāsu kal-farāsyil-mabṡūṡ(i).","words":[{"a":"يَوْمَ","en":"(The) Day","id":"(The) Day","t":"yawma"},{"a":"يَكُونُ","en":"will be","id":"will be","t":"yakūnu"},{"a":"ٱلنَّاسُ","en":"the mankind","id":"the mankind","t":"l-nāsu"},{"a":"كَٱلْفَرَاشِ","en":"like moths","id":"like moths","t":"kal-farāshi"},{"a":"ٱلْمَبْثُوثِ","en":"scattered","id":"scattered","t":"l-mabthūthi"}]},{"n":5,"key":"101:5","arabic":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ","page":600,"juz":30,"en":"And the mountains will be like wool, fluffed up.","id":"dan gunung-gunung seperti bulu yang dihambur-hamburkan.","latinEn":"Watakoonu aljibalu kalAAihnialmanfoosh","latinId":"Wa takūnul-jibālu kal-‘ihnil-manfūsy(i).","words":[{"a":"وَتَكُونُ","en":"And will be","id":"And will be","t":"watakūnu"},{"a":"ٱلْجِبَالُ","en":"the mountains","id":"the mountains","t":"l-jibālu"},{"a":"كَٱلْعِهْنِ","en":"like wool","id":"like wool","t":"kal-ʿih'ni"},{"a":"ٱلْمَنفُوشِ","en":"fluffed up","id":"fluffed up","t":"l-manfūshi"}]},{"n":6,"key":"101:6","arabic":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ","page":600,"juz":30,"en":"Then as for one whose scales are heavy [with good deeds],","id":"Maka adapun orang yang berat timbangan (kebaikan)nya,","latinEn":"Faamma man thaqulat mawazeenuh","latinId":"Fa ammā man ṡaqulat mawāzīnuh(ū).","words":[{"a":"فَأَمَّا","en":"Then as for","id":"Then as for","t":"fa-ammā"},{"a":"مَن","en":"(him) whose","id":"(him) whose","t":"man"},{"a":"ثَقُلَتْ","en":"(are) heavy","id":"(are) heavy","t":"thaqulat"},{"a":"مَوَٰزِينُهُۥ","en":"his scales","id":"his scales","t":"mawāzīnuhu"}]},{"n":7,"key":"101:7","arabic":"فَهُوَ فِى عِيشَةٍ رَّاضِيَةٍ","page":600,"juz":30,"en":"He will be in a pleasant life.","id":"maka dia berada dalam kehidupan yang memuaskan (senang).","latinEn":"Fahuwa fee AAeeshatin radiya","latinId":"Fa huwa fī ‘īsyatir rāḍiyah(tin).","words":[{"a":"فَهُوَ","en":"Then he","id":"Then he","t":"fahuwa"},{"a":"فِى","en":"(will be) in","id":"(will be) in","t":"fī"},{"a":"عِيشَةٍۢ","en":"a life","id":"a life","t":"ʿīshatin"},{"a":"رَّاضِيَةٍۢ","en":"pleasant","id":"pleasant","t":"rāḍiyatin"}]},{"n":8,"key":"101:8","arabic":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ","page":600,"juz":30,"en":"But as for one whose scales are light,","id":"Dan adapun orang yang ringan timbangan (kebaikan)nya,","latinEn":"Waamma man khaffat mawazeenuh","latinId":"Wa ammā man khaffat mawāzīnuh(ū).","words":[{"a":"وَأَمَّا","en":"But as for","id":"But as for","t":"wa-ammā"},{"a":"مَنْ","en":"(him) whose","id":"(him) whose","t":"man"},{"a":"خَفَّتْ","en":"(are) light","id":"(are) light","t":"khaffat"},{"a":"مَوَٰزِينُهُۥ","en":"his scales","id":"his scales","t":"mawāzīnuhu"}]},{"n":9,"key":"101:9","arabic":"فَأُمُّهُۥ هَاوِيَةٌ","page":600,"juz":30,"en":"His refuge will be an abyss.","id":"maka tempat kembalinya adalah neraka Hāwiyah.","latinEn":"Faommuhu hawiya","latinId":"Fa ummuhū hāwiyah(tun).","words":[{"a":"فَأُمُّهُۥ","en":"His abode","id":"His abode","t":"fa-ummuhu"},{"a":"هَاوِيَةٌۭ","en":"(will be the) Pit","id":"(will be the) Pit","t":"hāwiyatun"}]},{"n":10,"key":"101:10","arabic":"وَمَآ أَدْرَىٰكَ مَا هِيَهْ","page":600,"juz":30,"en":"And what can make you know what that is?","id":"Dan tahukah kamu apakah neraka Hāwiyah itu?","latinEn":"Wama adraka ma hiya","latinId":"Wa mā adrāka mā hiyah.","words":[{"a":"وَمَآ","en":"And what","id":"And what","t":"wamā"},{"a":"أَدْرَىٰكَ","en":"will make you know","id":"will make you know","t":"adrāka"},{"a":"مَا","en":"what","id":"what","t":"mā"},{"a":"هِيَهْ","en":"it is","id":"it is","t":"hiyah"}]},{"n":11,"key":"101:11","arabic":"نَارٌ حَامِيَةٌۢ","page":600,"juz":30,"en":"It is a Fire, intensely hot.","id":"(Yaitu) api yang sangat panas.","latinEn":"Narun hamiya","latinId":"Nārun ḥāmiyah(tun).","words":[{"a":"نَارٌ","en":"A Fire","id":"A Fire","t":"nārun"},{"a":"حَامِيَةٌۢ","en":"intensely hot","id":"intensely hot","t":"ḥāmiyatun"}]}]}