{"version":2,"surah":102,"verses":[{"n":1,"key":"102:1","arabic":" أَلْهَىٰكُمُ ٱلتَّكَاثُرُ","page":600,"juz":30,"en":"Competition in [worldly] increase diverts you","id":"Bermegah-megahan telah melalaikan kamu,","latinEn":"Alhakumu attakathur","latinId":"Alhākumut-takāṡur(u).","words":[{"a":"أَلْهَىٰكُمُ","en":"Diverts you","id":"Diverts you","t":"alhākumu"},{"a":"ٱلتَّكَاثُرُ","en":"the competition to increase","id":"the competition to increase","t":"l-takāthuru"}]},{"n":2,"key":"102:2","arabic":"حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ","page":600,"juz":30,"en":"Until you visit the graveyards.","id":"sampai kamu masuk ke dalam kubur.","latinEn":"Hatta zurtumu almaqabir","latinId":"Ḥattā zurtumul-maqābir(a).","words":[{"a":"حَتَّىٰ","en":"Until","id":"Until","t":"ḥattā"},{"a":"زُرْتُمُ","en":"you visit","id":"you visit","t":"zur'tumu"},{"a":"ٱلْمَقَابِرَ","en":"the graves","id":"the graves","t":"l-maqābira"}]},{"n":3,"key":"102:3","arabic":"كَلَّا سَوْفَ تَعْلَمُونَ","page":600,"juz":30,"en":"No! You are going to know.","id":"Sekali-kali tidak! Kelak kamu akan mengetahui (akibat perbuatanmu itu),","latinEn":"Kalla sawfa taAAlamoon","latinId":"Kallā saufa ta‘lamūn(a).","words":[{"a":"كَلَّا","en":"Nay","id":"Nay","t":"kallā"},{"a":"سَوْفَ","en":"Soon","id":"Soon","t":"sawfa"},{"a":"تَعْلَمُونَ","en":"you will know","id":"you will know","t":"taʿlamūna"}]},{"n":4,"key":"102:4","arabic":"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ","page":600,"juz":30,"en":"Then, no! You are going to know.","id":"kemudian sekali-kali tidak! Kelak kamu akan mengetahui.","latinEn":"Thumma kalla sawfa taAAlamoon","latinId":"Ṡumma kallā saufa ta‘lamūn(a).","words":[{"a":"ثُمَّ","en":"Then","id":"Then","t":"thumma"},{"a":"كَلَّا","en":"nay","id":"nay","t":"kallā"},{"a":"سَوْفَ","en":"Soon","id":"Soon","t":"sawfa"},{"a":"تَعْلَمُونَ","en":"you will know","id":"you will know","t":"taʿlamūna"}]},{"n":5,"key":"102:5","arabic":"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ","page":600,"juz":30,"en":"No! If you only knew with knowledge of certainty...","id":"Sekali-kali tidak! Sekiranya kamu mengetahui dengan pasti,","latinEn":"Kalla law taAAlamoona AAilma alyaqeen","latinId":"Kallā lau ta‘lamūna ‘ilmal-yaqīn(i).","words":[{"a":"كَلَّا","en":"Nay","id":"Nay","t":"kallā"},{"a":"لَوْ","en":"If","id":"If","t":"law"},{"a":"تَعْلَمُونَ","en":"you know","id":"you know","t":"taʿlamūna"},{"a":"عِلْمَ","en":"(with) a knowledge","id":"(with) a knowledge","t":"ʿil'ma"},{"a":"ٱلْيَقِينِ","en":"(of) certainty","id":"(of) certainty","t":"l-yaqīni"}]},{"n":6,"key":"102:6","arabic":"لَتَرَوُنَّ ٱلْجَحِيمَ","page":600,"juz":30,"en":"You will surely see the Hellfire.","id":"niscaya kamu benar-benar akan melihat neraka Jahim,","latinEn":"Latarawunna aljaheem","latinId":"Latarawunnal-jaḥīm(a).","words":[{"a":"لَتَرَوُنَّ","en":"Surely you will see","id":"Surely you will see","t":"latarawunna"},{"a":"ٱلْجَحِيمَ","en":"the Hellfire","id":"the Hellfire","t":"l-jaḥīma"}]},{"n":7,"key":"102:7","arabic":"ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ","page":600,"juz":30,"en":"Then you will surely see it with the eye of certainty.","id":"kemudian kamu benar-benar akan melihatnya dengan mata kepala sendiri,","latinEn":"Thumma latarawunnaha AAayna alyaqeen","latinId":"Ṡumma latarawunnahā ‘ainal-yaqīn(i).","words":[{"a":"ثُمَّ","en":"Then","id":"Then","t":"thumma"},{"a":"لَتَرَوُنَّهَا","en":"surely you will see it","id":"surely you will see it","t":"latarawunnahā"},{"a":"عَيْنَ","en":"(with the) eye","id":"(with the) eye","t":"ʿayna"},{"a":"ٱلْيَقِينِ","en":"(of) certainty","id":"(of) certainty","t":"l-yaqīni"}]},{"n":8,"key":"102:8","arabic":"ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ","page":600,"juz":30,"en":"Then you will surely be asked that Day about pleasure.","id":"kemudian kamu benar-benar akan ditanya pada hari itu tentang kenikmatan (yang megah di dunia itu).","latinEn":"Thumma latus-alunna yawma-ithin AAaniannaAAeem","latinId":"Ṡumma latus'alunna yauma'iżin ‘anin-na‘īm(i).","words":[{"a":"ثُمَّ","en":"Then","id":"Then","t":"thumma"},{"a":"لَتُسْـَٔلُنَّ","en":"surely you will be asked","id":"surely you will be asked","t":"latus'alunna"},{"a":"يَوْمَئِذٍ","en":"that Day","id":"that Day","t":"yawma-idhin"},{"a":"عَنِ","en":"about","id":"about","t":"ʿani"},{"a":"ٱلنَّعِيمِ","en":"the pleasures","id":"the pleasures","t":"l-naʿīmi"}]}]}