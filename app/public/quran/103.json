{"version":2,"surah":103,"verses":[{"n":1,"key":"103:1","arabic":" وَٱلْعَصْرِ","page":601,"juz":30,"en":"By time,","id":"Demi masa.","latinEn":"WalAAasr","latinId":"Wal-‘aṣr(i).","words":[{"a":"وَٱلْعَصْرِ","en":"By the time","id":"By the time","t":"wal-ʿaṣri"}]},{"n":2,"key":"103:2","arabic":"إِنَّ ٱلْإِنسَـٰنَ لَفِى خُسْرٍ","page":601,"juz":30,"en":"Indeed, mankind is in loss,","id":"Sungguh, manusia berada dalam kerugian,","latinEn":"Inna al-insana lafee khusr","latinId":"Innal-insāna lafī khusr(in).","words":[{"a":"إِنَّ","en":"Indeed","id":"Indeed","t":"inna"},{"a":"ٱلْإِنسَـٰنَ","en":"mankind","id":"mankind","t":"l-insāna"},{"a":"لَفِى","en":"(is) surely, in","id":"(is) surely, in","t":"lafī"},{"a":"خُسْرٍ","en":"loss","id":"loss","t":"khus'rin"}]},{"n":3,"key":"103:3","arabic":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ وَتَوَاصَوْا۟ بِٱلْحَقِّ وَتَوَاصَوْا۟ بِٱلصَّبْرِ","page":601,"juz":30,"en":"Except for those who have believed and done righteous deeds and advised each other to truth and advised each other to patience.","id":"kecuali orang-orang yang beriman dan mengerjakan kebajikan serta saling menasihati untuk kebenaran dan saling menasihati untuk kesabaran.","latinEn":"Illa allatheena amanoowaAAamiloo assalihati watawasaw bilhaqqiwatawasaw bissabr","latinId":"Illal-lażīna āmanū wa ‘amiluṣ-ṣāliḥāti wa tawāṣau bil-ḥaqq(i), wa tawāṣau biṣ-ṣabr(i).","words":[{"a":"إِلَّا","en":"Except","id":"Except","t":"illā"},{"a":"ٱلَّذِينَ","en":"those who","id":"those who","t":"alladhīna"},{"a":"ءَامَنُوا۟","en":"believe","id":"believe","t":"āmanū"},{"a":"وَعَمِلُوا۟","en":"and do","id":"and do","t":"waʿamilū"},{"a":"ٱلصَّـٰلِحَـٰتِ","en":"righteous deeds","id":"righteous deeds","t":"l-ṣāliḥāti"},{"a":"وَتَوَاصَوْا۟","en":"and enjoin (each other)","id":"and enjoin (each other)","t":"watawāṣaw"},{"a":"بِٱلْحَقِّ","en":"to the truth","id":"to the truth","t":"bil-ḥaqi"},{"a":"وَتَوَاصَوْا۟","en":"and enjoin (each other)","id":"and enjoin (each other)","t":"watawāṣaw"},{"a":"بِٱلصَّبْرِ","en":"to [the] patience","id":"to [the] patience","t":"bil-ṣabri"}]}]}