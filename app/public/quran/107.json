{"version":2,"surah":107,"verses":[{"n":1,"key":"107:1","arabic":" أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ","page":602,"juz":30,"en":"Have you seen the one who denies the Recompense?","id":"Tahukah kamu (orang) yang mendustakan agama?","latinEn":"Araayta allathee yukaththibu biddeen","latinId":"Ara'aital-lażī yukażżibu bid-dīn(i).","words":[{"a":"أَرَءَيْتَ","en":"Have you seen","id":"Have you seen","t":"ara-ayta"},{"a":"ٱلَّذِى","en":"the one who","id":"the one who","t":"alladhī"},{"a":"يُكَذِّبُ","en":"denies","id":"denies","t":"yukadhibu"},{"a":"بِٱلدِّينِ","en":"the Judgment","id":"the Judgment","t":"bil-dīni"}]},{"n":2,"key":"107:2","arabic":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ","page":602,"juz":30,"en":"For that is the one who drives away the orphan","id":"Maka itulah orang yang menghardik anak yatim,","latinEn":"Fathalika allathee yaduAAAAualyateem","latinId":"Fa żālikal-lażī yadu‘‘ul-yatīm(a).","words":[{"a":"فَذَٰلِكَ","en":"Then that","id":"Then that","t":"fadhālika"},{"a":"ٱلَّذِى","en":"(is) the one who","id":"(is) the one who","t":"alladhī"},{"a":"يَدُعُّ","en":"repulses","id":"repulses","t":"yaduʿʿu"},{"a":"ٱلْيَتِيمَ","en":"the orphan","id":"the orphan","t":"l-yatīma"}]},{"n":3,"key":"107:3","arabic":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","page":602,"juz":30,"en":"And does not encourage the feeding of the poor.","id":"dan tidak mengajak memberi makan orang miskin.","latinEn":"Wala yahuddu AAalataAAami almiskeen","latinId":"Wa lā yaḥuḍḍu ‘alā ṭa‘āmil-miskīn(i).","words":[{"a":"وَلَا","en":"And (does) not","id":"And (does) not","t":"walā"},{"a":"يَحُضُّ","en":"feel the urge","id":"feel the urge","t":"yaḥuḍḍu"},{"a":"عَلَىٰ","en":"to","id":"to","t":"ʿalā"},{"a":"طَعَامِ","en":"feed","id":"feed","t":"ṭaʿāmi"},{"a":"ٱلْمِسْكِينِ","en":"the poor","id":"the poor","t":"l-mis'kīni"}]},{"n":4,"key":"107:4","arabic":"فَوَيْلٌ لِّلْمُصَلِّينَ","page":602,"juz":30,"en":"So woe to those who pray","id":"Maka celakalah orang yang salat,","latinEn":"Fawaylun lilmusalleen","latinId":"Fawailul lil-muṣallīn(a).","words":[{"a":"فَوَيْلٌۭ","en":"So woe","id":"So woe","t":"fawaylun"},{"a":"لِّلْمُصَلِّينَ","en":"to those who pray","id":"to those who pray","t":"lil'muṣallīna"}]},{"n":5,"key":"107:5","arabic":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","page":602,"juz":30,"en":"[But] who are heedless of their prayer -","id":"(yaitu) orang-orang yang lalai terhadap salatnya,","latinEn":"Allatheena hum AAan salatihimsahoon","latinId":"Allażīna hum ‘an ṣalātihim sāhūn(a).","words":[{"a":"ٱلَّذِينَ","en":"Those who","id":"Those who","t":"alladhīna"},{"a":"هُمْ","en":"[they]","id":"[they]","t":"hum"},{"a":"عَن","en":"about","id":"about","t":"ʿan"},{"a":"صَلَاتِهِمْ","en":"their prayers","id":"their prayers","t":"ṣalātihim"},{"a":"سَاهُونَ","en":"(are) neglectful","id":"(are) neglectful","t":"sāhūna"}]},{"n":6,"key":"107:6","arabic":"ٱلَّذِينَ هُمْ يُرَآءُونَ","page":602,"juz":30,"en":"Those who make show [of their deeds]","id":"yang berbuat riya`,","latinEn":"Allatheena hum yuraoon","latinId":"Allażīna hum yurā'ūn(a).","words":[{"a":"ٱلَّذِينَ","en":"Those who","id":"Those who","t":"alladhīna"},{"a":"هُمْ","en":"[they]","id":"[they]","t":"hum"},{"a":"يُرَآءُونَ","en":"make show","id":"make show","t":"yurāūna"}]},{"n":7,"key":"107:7","arabic":"وَيَمْنَعُونَ ٱلْمَاعُونَ","page":602,"juz":30,"en":"And withhold [simple] assistance.","id":"dan enggan (memberikan) bantuan.","latinEn":"WayamnaAAoona almaAAoon","latinId":"Wa yamna‘ūnal-mā‘ūn(a).","words":[{"a":"وَيَمْنَعُونَ","en":"And they deny","id":"And they deny","t":"wayamnaʿūna"},{"a":"ٱلْمَاعُونَ","en":"[the] small kindnesses","id":"[the] small kindnesses","t":"l-māʿūna"}]}]}