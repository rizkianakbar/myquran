{"version":2,"surah":111,"verses":[{"n":1,"key":"111:1","arabic":" تَبَّتْ يَدَآ أَبِى لَهَبٍ وَتَبَّ","page":603,"juz":30,"en":"May the hands of Abū Lahab be ruined, and ruined is he.","id":"Binasalah kedua tangan Abu Lahab dan benar-benar binasa dia!","latinEn":"Tabbat yada abee lahabin watab","latinId":"Tabbat yadā abī lahabiw wa tabb(a).","words":[{"a":"تَبَّتْ","en":"Perish","id":"Perish","t":"tabbat"},{"a":"يَدَآ","en":"(the) hands","id":"(the) hands","t":"yadā"},{"a":"أَبِى","en":"(of) Abu","id":"(of) Abu","t":"abī"},{"a":"لَهَبٍۢ","en":"Lahab","id":"Lahab","t":"lahabin"},{"a":"وَتَبَّ","en":"and perish he","id":"and perish he","t":"watabba"}]},{"n":2,"key":"111:2","arabic":"مَآ أَغْنَىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَ","page":603,"juz":30,"en":"His wealth will not avail him or that which he gained.","id":"Tidaklah berguna baginya hartanya dan apa yang dia usahakan.","latinEn":"Ma aghna AAanhu maluhuwama kasab","latinId":"Mā agnā ‘anhu māluhū wa mā kasab(a).","words":[{"a":"مَآ","en":"Not","id":"Not","t":"mā"},{"a":"أَغْنَىٰ","en":"(will) avail","id":"(will) avail","t":"aghnā"},{"a":"عَنْهُ","en":"him","id":"him","t":"ʿanhu"},{"a":"مَالُهُۥ","en":"his wealth","id":"his wealth","t":"māluhu"},{"a":"وَمَا","en":"and what","id":"and what","t":"wamā"},{"a":"كَسَبَ","en":"he earned","id":"he earned","t":"kasaba"}]},{"n":3,"key":"111:3","arabic":"سَيَصْلَىٰ نَارًا ذَاتَ لَهَبٍ","page":603,"juz":30,"en":"He will [enter to] burn in a Fire of [blazing] flame","id":"Kelak dia akan masuk ke dalam api yang bergejolak (neraka).","latinEn":"Sayasla naran thatalahab","latinId":"Sayaṣlā nāran żāta lahab(in).","words":[{"a":"سَيَصْلَىٰ","en":"He will be burnt","id":"He will be burnt","t":"sayaṣlā"},{"a":"نَارًۭا","en":"(in) a Fire","id":"(in) a Fire","t":"nāran"},{"a":"ذَاتَ","en":"of","id":"of","t":"dhāta"},{"a":"لَهَبٍۢ","en":"Blazing Flames","id":"Blazing Flames","t":"lahabin"}]},{"n":4,"key":"111:4","arabic":"وَٱمْرَأَتُهُۥ حَمَّالَةَ ٱلْحَطَبِ","page":603,"juz":30,"en":"