{"version":2,"surah":112,"verses":[{"n":1,"key":"112:1","arabic":" قُلْ هُوَ ٱللَّهُ أَحَدٌ","page":604,"juz":30,"en":"Say, \"He is Allāh, [who is] One,","id":"Katakanlah (Muhammad), \"Dialah Allah, Yang Maha Esa.","latinEn":"Qul huwa Allahu ahad","latinId":"Qul huwallāhu aḥad(un).","words":[{"a":"قُلْ","en":"Say","id":"Say","t":"qul"},{"a":"هُوَ","en":"He","id":"He","t":"huwa"},{"a":"ٱللَّهُ","en":"(is) Allah","id":"(is) Allah","t":"l-lahu"},{"a":"أَحَدٌ","en":"the One","id":"the One","t":"aḥadun"}]},{"n":2,"key":"112:2","arabic":"ٱللَّهُ ٱلصَّمَدُ","page":604,"juz":30,"en":"Allāh, the Eternal Refuge.","id":"Allah tempat meminta segala sesuatu.","latinEn":"Allahu assamad","latinId":"Allāhuṣ-ṣamad(u).","words":[{"a":"ٱللَّهُ","en":"Allah","id":"Allah","t":"al-lahu"},{"a":"ٱلصَّمَدُ","en":"the Eternal, the Absolute","id":"the Eternal, the Absolute","t":"l-ṣamadu"}]},{"n":3,"key":"112:3","arabic":"لَمْ يَلِدْ وَلَمْ يُولَدْ","page":604,"juz":30,"en":"He neither begets nor is born,","id":"(Allah) tidak beranak dan tidak pula diperanakkan.","latinEn":"Lam yalid walam yoolad","latinId":"Lam yalid wa lam yūlad.","words":[{"a":"لَمْ","en":"Not","id":"Not","t":"lam"},{"a":"يَلِدْ","en":"He begets","id":"He begets","t":"yalid"},{"a":"وَلَمْ","en":"and not","id":"and not","t":"walam"},{"a":"يُولَدْ","en":"He is begotten","id":"He is begotten","t":"yūlad"}]},{"n":4,"key":"112:4","arabic":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","page":604,"juz":30,"en":"Nor is there to Him any equivalent.\"","id":"Dan tidak ada sesuatu yang setara dengan Dia.\"","latinEn":"Walam yakun lahu kufuwan ahad","latinId":"Wa lam yakul lahū kufuwan aḥad(un).","words":[{"a":"وَلَمْ","en":"And not","id":"And not","t":"walam"},{"a":"يَكُن","en":"is","id":"is","t":"yakun"},{"a":"لَّهُۥ","en":"for Him","id":"for Him","t":"lahu"},{"a":"كُفُوًا","en":"equivalent","id":"equivalent","t":"kufuwan"},{"a":"أَحَدٌۢ","en":"any [one]","id":"any [one]","t":"aḥadun"}]}]}