lahu"},{"a":"مَن","en":"whom","id":"whom","t":"man"},{"a":"يَشَآءُ","en":"He wills","id":"He wills","t":"yashāu"},{"a":"وَيَهْدِى","en":"and guides","id":"and guides","t":"wayahdī"},{"a":"مَن","en":"whom","id":"whom","t":"man"},{"a":"يَشَآءُ ۚ","en":"He wills","id":"He wills","t":"yashāu"},{"a":"وَمَا","en":"And none","id":"And none","t":"wamā"},{"a":"يَعْلَمُ","en":"knows","id":"knows","t":"yaʿlamu"},{"a":"جُنُودَ","en":"(the) hosts","id":"(the) hosts","t":"junūda"},{"a":"رَبِّكَ","en":"(of) your Lord","id":"(of) your Lord","t":"rabbika"},{"a":"إِلَّا","en":"except","id":"except","t":"illā"},{"a":"هُوَ ۚ","en":"Him","id":"Him","t":"huwa"},{"a":"وَمَا","en":"And not","id":"And not","t":"wamā"},{"a":"هِىَ","en":"it","id":"it","t":"hiya"},{"a":"إِلَّا","en":"(is) but","id":"(is) but","t":"illā"},{"a":"ذِكْرَىٰ","en":"a reminder","id":"a reminder","t":"dhik'rā"},{"a":"لِلْبَشَرِ","en":"to (the) human beings","id":"to (the) human beings","t":"lil'bashari"}]},{"n":32,"key":"74:32","arabic":"كَلَّا وَٱلْقَمَرِ","page":576,"juz":29,"en":"No! By the moon.","id":"Tidak! Demi bulan,","latinEn":"Kalla walqamar","latinId":"Kallā wal-qamar(i).","words":[{"a":"كَلَّا","en":"Nay","id":"Nay","t":"kallā"},{"a":"وَٱلْقَمَرِ","en":"By the moon","id":"By the moon","t":"wal-qamari"}]},{"n":33,"key":"74:33","arabic":"وَٱلَّيْلِ إِذْ أَدْبَرَ","page":576,"juz":29,"en":"And [by] the night when it departs.","id":"dan demi malam ketika telah berlalu,","latinEn":"Wallayli ith adbar","latinId":"Wal-laili iż adbar(a).","words":[{"a":"وَٱلَّيْلِ","en":"And the night","id":"And the night","t":"wa-al-layli"},{"a":"إِذْ","en":"when","id":"when","t":"idh"},{"a":"أَدْبَرَ","en":"it departs","id":"it departs","t":"adbara"}]},{"n":34,"key":"74:34","arabic":"وَٱلصُّبْحِ إِذَآ أَسْفَرَ","page":576,"juz":29,"en":"And [by] the morning when it brightens,","id":"dan demi subuh apabila mulai terang,","latinEn":"Wassubhi ithaasfar","latinId":"Waṣ-ṣubḥi iżā asfar(a).","words":[{"a":"وَٱلصُّبْحِ","en":"And th