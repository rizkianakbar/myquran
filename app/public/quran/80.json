{"version":2,"surah":80,"verses":[{"n":1,"key":"80:1","arabic":" عَبَسَ وَتَوَلَّىٰٓ","page":585,"juz":30,"en":"He [i.e., the Prophet (ﷺ) ] frowned and turned away","id":"Dia (Muhammad) berwajah masam dan berpaling,","latinEn":"AAabasa watawalla","latinId":"‘Abasa wa tawallā.","words":[{"a":"عَبَسَ","en":"He frowned","id":"He frowned","t":"ʿabasa"},{"a":"وَتَوَلَّىٰٓ","en":"and turned away","id":"and turned away","t":"watawallā"}]},{"n":2,"key":"80:2","arabic":"أَن جَآءَهُ ٱلْأَعْمَىٰ","page":585,"juz":30,"en":"Because there came to him the blind man, [interrupting].","id":"karena seorang buta telah datang kepadanya (Abdullah bin Ummi Maktum).","latinEn":"An jaahu al-aAAma","latinId":"An jā'ahul-a‘mā.","words":[{"a":"أَن","en":"Because","id":"Because","t":"an"},{"a":"جَآءَهُ","en":"came to him","id":"came to him","t":"jāahu"},{"a":"ٱلْأَعْمَىٰ","en":"the blind man","id":"the blind man","t":"l-aʿmā"}]},{"n":3,"key":"80:3","arabic":"وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ","page":585,"juz":30,"en":"But what would make you perceive, [O Muḥammad], that perhaps he might be purified","id":"Dan tahukah engkau (Muhammad) barangkali dia ingin menyucikan dirinya (dari dosa),","latinEn":"Wama yudreeka laAAallahu yazzakka","latinId":"Wa mā yudrīka la‘allahū yazzakkā.","words":[{"a":"وَمَا","en":"But what","id":"But what","t":"wamā"},{"a":"يُدْرِيكَ","en":"would make you know","id":"would make you know","t":"yud'rīka"},{"a":"لَعَلَّهُۥ","en":"that he might","id":"that he might","t":"laʿallahu"},{"a":"يَزَّكَّىٰٓ","en":"purify himself","id":"purify himself","t":"yazzakkā"}]},{"n":4,"key":"80:4","arabic":"أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ","page":585,"juz":30,"en":"Or be reminded and the remembrance would benefit him?","id":"atau dia (ingin) mendapatkan pengajaran, yang memberi manfaat kepadanya?","latinEn":"Aw yaththakkaru fatanfaAAahu aththikra","latinId":"Au yażżakkaru fatanfa‘ahuż-żikrā.","words":[{"a":"أَوْ","en":"Or","id":"Or","t":"aw"},{"a":"يَذَّكَّرُ","en":"be reminded","id":"be reminded","t":"yadhakkaru"},{"a":"فَتَنفَعَهُ","en":"so would benefit him","id":"so would benefit him","t":"fatanfaʿahu"},{"a":"ٱلذِّكْرَىٰٓ","en":"the reminder","id":"the reminder","t":"l-dhik'rā"}]},{"n":5,"key":"80:5","arabic":"أَمَّا مَنِ ٱسْتَغْنَىٰ","page":585,"juz":30,"en":"As for he who thinks himself without need,","id":"Adapun orang yang merasa dirinya serba cukup (pembesar-pembesar Quraisy),","latinEn":"Amma mani istaghna","latinId":"Ammā manistagnā.","words":[{"a":"أَمَّا","en":"As for","id":"As for","t":"ammā"},{"a":"مَنِ","en":"(him) who","id":"(him) who","t":"mani"},{"a":"ٱسْتَغْنَىٰ","en":"considers himself free from need","id":"considers himself free from need","t":"is'taghnā"}]},{"n":6,"key":"80:6","arabic":"فَأَنتَ لَهُۥ تَصَدَّىٰ","page":585,"juz":30,"en":"To him you give attention.","id":"maka engkau (Muhammad) memberi perhatian kepadanya,","latinEn":"Faanta lahu tasadda","latinId":"Fa anta lahū taṣaddā.","words":[{"a":"فَأَنتَ","en":"So you","id":"So you","t":"fa-anta"},{"a":"لَهُۥ","en":"to him","id":"to him","t":"lahu"},{"a":"تَصَدَّىٰ","en":"give attention","id":"give attention","t":"taṣaddā"}]},{"n":7,"key":"80:7","arabic":"وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ","page":585,"juz":30,"en":"And not upon you [is any blame] if he will not be purified.","id":"padahal tidak ada (cela) atasmu kalau dia tidak menyucikan diri (beriman).","latinEn":"Wama AAalayka alla yazzakka","latinId":"Wa mā ‘alaika allā yazzakkā.","words":[{"a":"وَمَا","en":"And not","id":"And not","t":"wamā"},{"a":"عَلَيْكَ","en":"upon you","id":"upon you","t":"ʿalayka"},{"a":"أَلَّا","en":"that not","id":"that not","t":"allā"},{"a":"يَزَّكَّىٰ","en":"he purifies himself","id":"he purifies himself","t":"yazzakkā"}]},{"n":8,"key":"80:8","arabic":"وَأَمَّا مَن جَآءَكَ يَسْعَىٰ","page":585,"juz":30,"en":"But as for he who came to you striving [for knowledge]","id":"Dan adapun orang yang datang kepadamu dengan bersegera (untuk mendapatkan pengajaran),","latinEn":"Waamma man jaaka yasAAa","latinId":"Wa ammā man jā'aka yas‘ā.","words":[{"a":"وَأَمَّا","en":"But as for","id":"But as for","t":"wa-ammā"},{"a":"مَن","en":"(he) who","id":"(he) who","t":"man"},{"a":"جَآءَكَ","en":"came to you","id":"came to you","t":"jāaka"},{"a":"يَسْعَىٰ","en":"striving","id":"striving","t":"yasʿā"}]},{"n":9,"key":"80:9","arabic":"وَهُوَ يَخْشَىٰ","page":585,"juz":30,"en":"While he fears [Allāh],","id":"sedang dia takut (kepada Allah),","latinEn":"Wahuwa yakhsha","latinId":"Wa huwa yakhsyā.","words":[{"a":"وَهُوَ","en":"While he","id":"While he","t":"wahuwa"},{"a":"يَخْشَىٰ","en":"fears","id":"fears","t":"yakhshā"}]},{"n":10,"key":"80:10","arabic":"فَأَنتَ عَنْهُ تَلَهَّىٰ","page":585,"juz":30,"en":"From him you are distracted.","id":"engkau (Muhammad) malah mengabaikannya.","latinEn":"Faanta AAanhu talahha","latinId":"Fa anta ‘anhu talahhā.","words":[{"a":"فَأَنتَ","en":"But you","id":"But you","t":"fa-anta"},{"a":"عَنْهُ","en":"from him","id":"from him","t":"ʿanhu"},{"a":"تَلَهَّىٰ","en":"(are) distracted","id":"(are) distracted","t":"talahhā"}]},{"n":11,"key":"80:11","arabic":"كَلَّآ إِنَّهَا تَذْكِرَةٌ","page":585,"juz":30,"en":"No! Indeed, they [i.e., these verses] are a reminder;","id":"Sekali-kali jangan (begitu)! Sungguh, (ajaran-ajaran Allah) itu suatu peringatan,","latinEn":"Kalla innaha tathkira","latinId":"Kallā innahā tażkirah(tun).","words":[{"a":"كَلَّآ","en":"Nay","id":"Nay","t":"kallā"},{"a":"إِنَّهَا","en":"Indeed, it","id":"Indeed, it","t":"innahā"},{"a":"تَذْكِرَةٌۭ","en":"(is) a reminder","id":"(is) a reminder","t":"tadhkiratun"}]},{"n":12,"key":"80:12","arabic":"فَمَن شَآءَ ذَكَرَهُۥ","page":585,"juz":30,"en":"So whoever wills may remember it.","id":"maka barangsiapa menghendaki, tentulah dia akan memperhatikannya,","latinEn":"Faman shaa thakarah","latinId":"Faman syā'a żakarah(ū).","words":[{"a":"فَمَن","en":"So whosoever","id":"So whosoever","t":"faman"},{"a":"شَآءَ","en":"wills","id":"wills","t":"shāa"},{"a":"ذَكَرَهُۥ","en":"may remember it","id":"may remember it","t":"dhakarahu"}]},{"n":13,"key":"80:13","arabic":"فِى صُحُفٍ مُّكَرَّمَةٍ","page":585,"juz":30,"en":"[It is recorded] in honored sheets,","id":"di dalam kitab-kitab yang dimuliakan (di sisi Allah),","latinEn":"Fee suhufin mukarrama","latinId":"Fī ṣuḥufim mukarrmah(tin).","words":[{"a":"فِى","en":"In","id":"In","t":"fī"},{"a":"صُحُفٍۢ","en":"sheets","id":"sheets","t":"ṣuḥufin"},{"a":"مُّكَرَّمَةٍۢ","en":"honored","id":"honored","t":"mukarramatin"}]},{"n":14,"key":"80:14","arabic":"مَّرْفُوعَةٍ مُّطَهَّرَةٍۭ","page":585,"juz":30,"en":"Exalted and purified,","id":"yang ditinggikan (dan) disucikan,","latinEn":"MarfooAAatin mutahhara","latinId":"Marfū‘atim muṭahharah(tin).","words":[{"a":"مَّرْفُوعَةٍۢ","en":"Exalted","id":"Exalted","t":"marfūʿatin"},{"a":"مُّطَهَّرَةٍۭ","en":"purified","id":"purified","t":"muṭahharatin"}]},{"n":15,"key":"80:15","arabic":"بِأَيْدِى سَفَرَةٍ","page":585,"juz":30,"en":"[Carried] by the hands of messenger-angels,","id":"di tangan para utusan (malaikat),","latinEn":"Bi-aydee safara","latinId":"Bi'aidī safarah(tin).","words":[{"a":"بِأَيْدِى","en":"In (the) hands","id":"In (the) hands","t":"bi-aydī"},{"a":"سَفَرَةٍۢ","en":"(of) scribes","id":"(of) scribes","t":"safaratin"}]},{"n":16,"key":"80:16","arabic":"كِرَامٍۭ بَرَرَةٍ","page":585,"juz":30,"en":"Noble and dutiful.","id":"yang mulia lagi berbakti.","latinEn":"Kiramin barara","latinId":"Kirāmim bararah(tin).","words":[{"a":"كِرَامٍۭ","en":"Noble","id":"Noble","t":"kirāmin"},{"a":"بَرَرَةٍۢ","en":"dutiful","id":"dutiful","t":"bararatin"}]},{"n":17,"key":"80:17","arabic":"قُتِلَ ٱلْإِنسَـٰنُ مَآ أَكْفَرَهُۥ","page":585,"juz":30,"en":"Destroyed [i.e., cursed] is man; how disbelieving is he.","id":"Celakalah manusia! Alangkah kufurnya dia!","latinEn":"Qutila al-insanu ma akfarah","latinId":"Qutilal-insānu mā akfarah(ū).","words":[{"a":"قُتِلَ","en":"Is destroyed","id":"Is destroyed","t":"qutila"},{"a":"ٱلْإِنسَـٰنُ","en":"[the] man","id":"[the] man","t":"l-insānu"},{"a":"مَآ","en":"how","id":"how","t":"mā"},{"a":"أَكْفَرَهُۥ","en":"ungrateful is he","id":"ungrateful is he","t":"akfarahu"}]},{"n":18,"key":"80:18","arabic":"مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ","page":585,"juz":30,"en":"From what thing [i.e., substance] did He create him?","id":"Dari apakah Dia (Allah) menciptakannya?","latinEn":"Min ayyi shay-in khalaqah","latinId":"Min ayyi syai'in khalaqah(ū).","words":[{"a":"مِنْ","en":"From","id":"From","t":"min"},{"a":"أَىِّ","en":"what","id":"what","t":"ayyi"},{"a":"شَىْءٍ","en":"thing","id":"thing","t":"shayin"},{"a":"خَلَقَهُۥ","en":"He created him","id":"He created him","t":"khalaqahu"}]},{"n":19,"key":"80:19","arabic":"مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ","page":585,"juz":30,"en":"From a sperm-drop He created him and destined for him;","id":"Dari setetes mani, Dia menciptakannya lalu menentukannya.","latinEn":"Min nutfatin khalaqahu faqaddarah","latinId":"Min nuṭfah(tin), khalaqahū fa qaddarah(ū).","words":[{"a":"مِن","en":"From","id":"From","t":"min"},{"a":"نُّطْفَةٍ","en":"a semen-drop","id":"a semen-drop","t":"nuṭ'fatin"},{"a":"خَلَقَهُۥ","en":"He created him","id":"He created him","t":"khalaqahu"},{"a":"فَقَدَّرَهُۥ","en":"then He proportioned him","id":"then He proportioned him","t":"faqaddarahu"}]},{"n":20,"key":"80:20","arabic":"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ","page":585,"juz":30,"en":"Then He eased the way for him;","id":"Kemudian jalannya Dia mudahkan,","latinEn":"Thumma assabeela yassarah","latinId":"Ṡummas-sabīla yassarah(ū).","words":[{"a":"ثُمَّ","en":"Then","id":"Then","t":"thumma"},{"a":"ٱلسَّبِيلَ","en":"the way","id":"the way","t":"l-sabīla"},{"a":"يَسَّرَهُۥ","en":"He made easy for him","id":"He made easy for him","t":"yassarahu"}]},{"n":21,"key":"80:21","arabic":"ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ","page":585,"juz":30,"en":"Then He causes his death and provides a grave for him.","id":"kemudian Dia mematikannya lalu menguburkannya,","latinEn":"Thumma amatahu faaqbarah","latinId":"Ṡumma amātahū fa aqbarah(ū).","words":[{"a":"ثُمَّ","en":"Then","id":"Then","t":"thumma"},{"a":"أَمَاتَهُۥ","en":"He causes him to die","id":"He causes him to die","t":"amātahu"},{"a":"فَأَقْبَرَهُۥ","en":"and provides a grave for him","id":"and provides a grave for him","t":"fa-aqbarahu"}]},{"n":22,"key":"80:22","arabic":"ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ","page":585,"juz":30,"en":"Then when He wills, He will resurrect him.","id":"kemudian jika Dia menghendaki, Dia membangkitkannya kembali.","latinEn":"Thumma itha shaa ansharah","latinId":"Ṡumma iżā syā'a ansyarah(ū).","words":[{"a":"ثُمَّ","en":"Then","id":"Then","t":"thumma"},{"a":"إِذَا","en":"when","id":"when","t":"idhā"},{"a":"شَآءَ","en":"He wills","id":"He wills","t":"shāa"},{"a":"أَنشَرَهُۥ","en":"He will resurrect him","id":"He will resurrect him","t":"ansharahu"}]},{"n":23,"key":"80:23","arabic":"كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ","page":585,"juz":30,"en":"No! He [i.e., man] has not yet accomplished what He commanded him.","id":"Sekali-kali jangan (begitu)! Dia (manusia) itu belum melaksanakan apa yang Dia (Allah) perintahkan kepadanya.","latinEn":"Kalla lamma yaqdi maamarah","latinId":"Kallā lammā yaqḍi mā amarah(ū).","words":[{"a":"كَلَّا","en":"Nay","id":"Nay","t":"kallā"},{"a":"لَمَّا","en":"Not","id":"Not","t":"lammā"},{"a":"يَقْضِ","en":"he has accomplished","id":"he has accomplished","t":"yaqḍi"},{"a":"مَآ","en":"what","id":"what","t":"mā"},{"a":"أَمَرَهُۥ","en":"He commanded him","id":"He commanded him","t":"amarahu"}]},{"n":24,"key":"80:24","arabic":"فَلْيَنظُرِ ٱلْإِنسَـٰنُ إِلَىٰ طَعَامِهِۦٓ","page":585,"juz":30,"en":"Then let mankind look at his food -","id":"Maka hendaklah manusia itu memperhatikan makanannya,","latinEn":"Falyanthuri al-insanuila taAAamih","latinId":"Falyanẓuril-insānu ilā ṭa‘āmih(ī).","words":[{"a":"فَلْيَنظُرِ","en":"Then let look","id":"Then let look","t":"falyanẓuri"},{"a":"ٱلْإِنسَـٰنُ","en":"the man","id":"the man","t":"l-insānu"},{"a":"إِلَىٰ","en":"at","id":"at","t":"ilā"},{"a":"طَعَامِهِۦٓ","en":"his food","id":"his food","t":"ṭaʿāmihi"}]},{"n":25,"key":"80:25","arabic":"أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّا","page":585,"juz":30,"en":"How We poured down water in torrents,","id":"Kamilah yang telah mencurahkan air melimpah (dari langit),","latinEn":"Anna sababna almaasabba","latinId":"Annā ṣababnal-mā'a ṣabbā(n).","words":[{"a":"اَنَّا","en":"That [We]","id":"That [We]","t":"annā"},{"a":"صَبَبْنَا","en":"[We] poured","id":"[We] poured","t":"ṣababnā"},{"a":"ٱلْمَآءَ","en":"the water","id":"the water","t":"l-māa"},{"a":"صَبًّۭا","en":"(in) abundance","id":"(in) abundance","t":"ṣabban"}]},{"n":26,"key":"80:26","arabic":"ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّا","page":585,"juz":30,"en":"Then We broke open the earth, splitting [it with sprouts],","id":"kemudian Kami belah bumi dengan sebaik-baiknya,","latinEn":"Thumma shaqaqna al-arda shaqqa","latinId":"Ṡumma syaqaqnal-arḍa syaqqā(n).","words":[{"a":"ثُمَّ","en":"Then","id":"Then","t":"thumma"},{"a":"شَقَقْنَا","en":"We cleaved","id":"We cleaved","t":"shaqaqnā"},{"a":"ٱلْأَرْضَ","en":"the earth","id":"the earth","t":"l-arḍa"},{"a":"شَقًّۭا","en":"splitting","id":"splitting","t":"shaqqan"}]},{"n":27,"key":"80:27","arabic":"فَأَنۢبَتْنَا فِيهَا حَبًّا","page":585,"juz":30,"en":"And caused to grow within it grain","id":"lalu di sana Kami tumbuhkan biji-bijian,","latinEn":"Faanbatna feeha habba","latinId":"Fa'ambatnā fīhā ḥabbā(n).","words":[{"a":"فَأَنۢبَتْنَا","en":"Then We caused to grow","id":"Then We caused to grow","t":"fa-anbatnā"},{"a":"فِيهَا","en":"therein","id":"therein","t":"fīhā"},{"a":"حَبًّۭا","en":"grain","id":"grain","t":"ḥabban"}]},{"n":28,"key":"80:28","arabic":"وَعِنَبًا وَقَضْبًا","page":585,"juz":30,"en":"And grapes and herbage","id":"dan anggur dan sayur-sayuran,","latinEn":"WaAAinaban waqadba","latinId":"Wa ‘inabaw wa qaḍbā(n).","words":[{"a":"وَعِنَبًۭا","en":"And grapes","id":"And grapes","t":"waʿinaban"},{"a":"وَقَضْبًۭا","en":"and green fodder","id":"and green fodder","t":"waqaḍban"}]},{"n":29,"key":"80:29","arabic":"وَزَيْتُونًا وَنَخْلًا","page":585,"juz":30,"en":"And olive and palm trees","id":"dan zaitun dan pohon kurma,","latinEn":"Wazaytoonan wanakhla","latinId":"Wa zaitūnaw wa nakhlā(n).","words":[{"a":"وَزَيْتُونًۭا","en":"And olive","id":"And olive","t":"wazaytūnan"},{"a":"وَنَخْلًۭا","en":"and date-palms","id":"and date-palms","t":"wanakhlan"}]},{"n":30,"key":"80:30","arabic":"وَحَدَآئِقَ غُلْبًا","page":585,"juz":30,"en":"And gardens of dense shrubbery","id":"dan kebun-kebun (yang) rindang,","latinEn":"Wahada-iqa ghulba","latinId":"Wa ḥadā'iqa gulbā(n).","words":[{"a":"وَحَدَآئِقَ","en":"And gardens","id":"And gardens","t":"waḥadāiqa"},{"a":"غُلْبًۭا","en":"(of) thick foliage","id":"(of) thick foliage","t":"ghul'ban"}]},{"n":31,"key":"80:31","arabic":"وَفَـٰكِهَةً وَأَبًّا","page":585,"juz":30,"en":"And fruit and grass -","id":"dan buah-buahan serta rerumputan.","latinEn":"Wafakihatan waabba","latinId":"Wa fākihataw wa abbā(n).","words":[{"a":"وَفَـٰكِهَةًۭ","en":"And fruits","id":"And fruits","t":"wafākihatan"},{"a":"وَأَبًّۭا","en":"and grass","id":"and grass","t":"wa-abban"}]},{"n":32,"key":"80:32","arabic":"مَّتَـٰعًا لَّكُمْ وَلِأَنْعَـٰمِكُمْ","page":585,"juz":30,"en":"[As] enjoyment [i.e., provision] for you and your grazing livestock.","id":"(Semua itu) untuk kesenanganmu dan untuk hewan-hewan ternakmu.","latinEn":"MataAAan lakum wali-anAAamikum","latinId":"Matā‘al lakum wa li'an‘āmikum.","words":[{"a":"مَّتَـٰعًۭا","en":"(As) a provision","id":"(As) a provision","t":"matāʿan"},{"a":"لَّكُمْ","en":"for you","id":"for you","t":"lakum"},{"a":"وَلِأَنْعَـٰمِكُمْ","en":"and for your cattle","id":"and for your cattle","t":"wali-anʿāmikum"}]},{"n":33,"key":"80:33","arabic":"فَإِذَا جَآءَتِ ٱلصَّآخَّةُ","page":585,"juz":30,"en":"But when there comes the Deafening Blast","id":"Maka apabila datang suara yang memekakkan (tiupan sangkakala yang kedua),","latinEn":"Fa-itha jaati assakhkha","latinId":"Fa iżā jā'atiṣ-ṣākhkhah(tu).","words":