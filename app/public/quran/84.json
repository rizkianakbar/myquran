{"version":2,"surah":84,"verses":[{"n":1,"key":"84:1","arabic":" إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ","page":589,"juz":30,"en":"When the sky has split [open]","id":"Apabila langit terbelah,","latinEn":"Itha assamao inshaqqat","latinId":"Iżas-samā'unsyaqqat.","words":[{"a":"إِذَا","en":"When","id":"When","t":"idhā"},{"a":"ٱلسَّمَآءُ","en":"the sky","id":"the sky","t":"l-samāu"},{"a":"ٱنشَقَّتْ","en":"is split asunder","id":"is split asunder","t":"inshaqqat"}]},{"n":2,"key":"84:2","arabic":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ","page":589,"juz":30,"en":"And has listened [i.e., responded] to its Lord and was obligated [to do so]","id":"dan patuh kepada Tuhannya, dan sudah semestinya patuh,","latinEn":"Waathinat lirabbiha wahuqqat","latinId":"Wa ażinat lirabbihā wa ḥuqqat.","words":[{"a":"وَأَذِنَتْ","en":"And has listened","id":"And has listened","t":"wa-adhinat"},{"a":"لِرَبِّهَا","en":"to its Lord","id":"to its Lord","t":"lirabbihā"},{"a":"وَحُقَّتْ","en":"and was obligated","id":"and was obligated","t":"waḥuqqat"}]},{"n":3,"key":"84:3","arabic":"وَإِذَا ٱلْأَرْضُ مُدَّتْ","page":589,"juz":30,"en":"And when the earth has been extended","id":"dan apabila bumi diratakan,","latinEn":"Wa-itha al-ardu muddat","latinId":"Wa iẓal-arḍu muddat.","words":[{"a":"وَإِذَا","en":"And when","id":"And when","t":"wa-idhā"},{"a":"ٱلْأَرْضُ","en":"the earth","id":"the earth","t":"l-arḍu"},{"a":"مُدَّتْ","en":"is spread","id":"is spread","t":"muddat"}]},{"n":4,"key":"84:4","arabic":"وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ","page":589,"juz":30,"en":"And has cast out that within it and relinquished [it].","id":"dan memuntahkan apa yang ada di dalamnya dan menjadi kosong,","latinEn":"Waalqat ma feeha watakhallat","latinId":"Wa alqat mā fīhā wa takhallat.","words":[{"a":"وَأَلْقَتْ","en":"And has cast out","id":"And has cast out","t":"wa-alqat"},{"a":"مَا","en":"what","id":"what","t":"mā"},{"a":"فِيهَا","en":"(is) in it","id":"(is) in it","t":"fīhā"},{"a":"وَتَخَلَّتْ","en":"and becomes empty","id":"and becomes empty","t":"watakhallat"}]},{"n":5,"key":"84:5","arabic":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ","page":589,"juz":30,"en":"And has listened [i.e., responded] to its Lord and was obligated [to do so] -","id":"dan patuh kepada Tuhannya, dan sudah semestinya patuh.","latinEn":"Waathinat lirabbiha wahuqqat","latinId":"Wa ażinat lirabbihā wa ḥuqqat.","words":[{"a":"وَأَذِنَتْ","en":"And has listened","id":"And has listened","t":"wa-adhinat"},{"a":"لِرَبِّهَا","en":"to its Lord","id":"to its Lord","t":"lirabbihā"},{"a":"وَحُقَّتْ","en":"and was obligated","id":"and was obligated","t":"waḥuqqat"}]},{"n":6,"key":"84:6","arabic":"يَـٰٓأَيُّهَا ٱلْإِنسَـٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًا فَمُلَـٰقِيهِ","page":589,"juz":30,"en":"O mankind, indeed you are laboring toward your Lord with [great] exertion and will meet it.","id":"Wahai manusia! Sesungguhnya kamu telah bekerja keras menuju Tuhanmu, maka kamu akan menemui-Nya.","latinEn":"Ya ayyuha al-insanuinnaka kadihun ila rabbika kadhanfamulaqeeh","latinId":"Yā ayyuhal-insānu innaka kādiḥun ilā rabbika kadḥan fa mulāqīh(i).","words":[{"a":"يَـٰٓأَيُّهَا","en":"O","id":"O","t":"yāayyuhā"},{"a":"ٱلْإِنسَـٰنُ","en":"mankind","id":"mankind","t":"l-insānu"},{"a":"إِنَّكَ","en":"Indeed, you","id":"Indeed, you","t":"innaka"},{"a":"كَادِحٌ","en":"(are) laboring","id":"(are) laboring","t":"kādiḥun"},{"a":"إِلَىٰ","en":"to","id":"to","t":"ilā"},{"a":"رَبِّكَ","en":"your Lord","id":"your Lord","t":"rabbika"},{"a":"كَدْحًۭا","en":"(with) exertion","id":"(with) exertion","t":"kadḥan"},{"a":"فَمُلَـٰقِيهِ","en":"and you (will) meet Him","id":"and you (will) meet Him","t":"famulāqīhi"}]},{"n":7,"key":"84:7","arabic":"فَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ بِيَمِينِهِۦ","page":589,"juz":30,"en":"Then as for he who is given his record in his right hand,","id":"Maka adapun orang yang catatanya diberikan dari sebelah kanannya,","latinEn":"Faama man ootiya kitabahubiyameenih","latinId":"Fa ammā man ūtiya kitābahū biyamīnih(ī).","words":[{"a":"فَأَمَّا","en":"Then as for","id":"Then as for","t":"fa-ammā"},{"a":"مَنْ","en":"(him) who","id":"(him) who","t":"man"},{"a":"أُوتِىَ","en":"is given","id":"is given","t":"ūtiya"},{"a":"كِتَـٰبَهُۥ","en":"his record","id":"his record","t":"kitābahu"},{"a":"بِيَمِينِهِۦ","en":"in his right (hand)","id":"in his right (hand)","t":"biyamīnihi"}]},{"n":8,"key":"84:8","arabic":"فَسَوْفَ يُحَاسَبُ حِسَابًا يَسِيرًا","page":589,"juz":30,"en":"He will be judged with an easy account","id":"maka dia akan diperiksa dengan pemeriksaan yang mudah,","latinEn":"Fasawfa yuhasabu hisabanyaseera","latinId":"Fa saufa yuḥāsabu ḥisābay yasīrā(n).","words":[{"a":"فَسَوْفَ","en":"Then soon","id":"Then soon","t":"fasawfa"},{"a":"يُحَاسَبُ","en":"his account will be taken","id":"his account will be taken","t":"yuḥāsabu"},{"a":"حِسَابًۭا","en":"an account","id":"an account","t":"ḥisāban"},{"a":"يَسِيرًۭا","en":"easy","id":"easy","t":"yasīran"}]},{"n":9,"key":"84:9","arabic":"وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُورًا","page":589,"juz":30,"en":"And return to his people in happiness.","id":"dan dia akan kembali kepada keluarganya (yang sama-sama beriman) dengan gembira.","latinEn":"Wayanqalibu ila ahlihi masroora","latinId":"Wa yanqalibu ilā ahlihī masrūrā(n).","words":[{"a":"وَيَنقَلِبُ","en":"And he will return","id":"And he will return","t":"wayanqalibu"},{"a":"إِلَىٰٓ","en":"to","id":"to","t":"ilā"},{"a":"أَهْلِهِۦ","en":"his people","id":"his people","t":"ahlihi"},{"a":"مَسْرُورًۭا","en":"happily","id":"happily","t":"masrūran"}]},{"n":10,"key":"84:10","arabic":"وَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ وَرَآءَ ظَهْرِهِۦ","page":589,"juz":30,"en":"But as for he who is given his record behind his back,","id":"Dan adapun orang yang catatannya diberikan dari arah belakang,","latinEn":"Waamma man ootiya kitabahu waraathahrih","latinId":"Wa ammā man ūtiya kitābahū warā'a ẓahrih(ī).","words":[{"a":"وَأَمَّا","en":"But as for","id":"But as for","t":"wa-ammā"},{"a":"مَنْ","en":"(him) who","id":"(him) who","t":"man"},{"a":"أُوتِىَ","en":"is given","id":"is given","t":"ūtiya"},{"a":"كِتَـٰبَهُۥ","en":"his record","id":"his record","t":"kitābahu"},{"a":"وَرَآءَ","en":"behind","id":"behind","t":"warāa"},{"a":"ظَهْرِهِۦ","en":"his back","id":"his back","t":"ẓahrihi"}]},{"n":11,"key":"84:11","arabic":"فَسَوْفَ يَدْعُوا۟ ثُبُورًا","page":589,"juz":30,"en":"He will cry out for destruction","id":"maka dia akan berteriak, \"Celakalah aku!\"","latinEn":"Fasawfa yadAAoo thuboora","latinId":"Fa saufa yad‘ū ṡubūrā(n).","words":[{"a":"فَسَوْفَ","en":"Then soon","id":"Then soon","t":"fasawfa"},{"a":"يَدْعُوا۟","en":"he will call","id":"he will call","t":"yadʿū"},{"a":"ثُبُورًۭا","en":"(for) destruction","id":"(for) destruction","t":"thubūran"}]},{"n":12,"key":"84:12","arabic":"وَيَصْلَىٰ سَعِيرًا","page":589,"juz":30,"en":"And [enter to] burn in a Blaze.","id":"Dan dia akan masuk ke dalam api yang menyala-nyala (neraka).","latinEn":"Wayasla saAAeera","latinId":"Wa yaṣlā sa‘īrā(n).","words":[{"a":"وَيَصْلَىٰ","en":"And he will burn","id":"And he will burn","t":"wayaṣlā"},{"a":"سَعِيرًا","en":"(in) a Blaze","id":"(in) a Blaze","t":"saʿīran"}]},{"n":13,"key":"84:13","arabic":"إِنَّهُۥ كَانَ فِىٓ أَهْلِهِۦ مَسْرُورًا","page":589,"juz":30,"en":"Indeed, he had [once] been among his people in happiness;","id":"Sungguh, dia dahulu (di dunia) bergembira di kalangan keluarganya (yang sama-sama kafir).","latinEn":"Innahu kana fee ahlihi masroora","latinId":"Innahū kāna fī ahlihī masrūrā(n).","words":[{"a":"إِنَّهُۥ","en":"Indeed, he","id":"Indeed, he","t":"innahu"},{"a":"كَانَ","en":"had been","id":"had been","t":"kāna"},{"a":"فِىٓ","en":"among","id":"among","t":"fī"},{"a":"أَهْلِهِۦ","en":"his people","id":"his people","t":"ahlihi"},{"a":"مَسْرُورًا","en":"happy","id":"happy","t":"masrūran"}]},{"n":14,"key":"84:14","arabic":"إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ","page":589,"juz":30,"en":"Indeed, he had thought he would never return [to Allāh].","id":"Sesungguhnya dia mengira bahwa dia tidak akan kembali (kepada Tuhannya).","latinEn":"Innahu thanna an lan yahoor","latinId":"Innahū ẓanna allay yaḥūr(a).","words":[{"a":"إِنَّهُۥ","en":"Indeed, he","id":"Indeed, he","t":"innahu"},{"a":"ظَنَّ","en":"(had) thought","id":"(had) thought","t":"ẓanna"},{"a":"أَن","en":"that","id":"that","t":"an"},{"a":"لَّن","en":"never","id":"never","t":"lan"},{"a":"يَحُورَ","en":"he would return","id":"he would return","t":"yaḥūra"}]},{"n":15,"key":"84:15","arabic":"بَلَىٰٓ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرًا","page":589,"juz":30,"en":"But yes! Indeed, his Lord was ever, of him, Seeing.","id":"Tidak demikian, sesungguhnya Tuhannya selalu melihatnya.","latinEn":"Bala inna rabbahu kana bihi baseera","latinId":"Balā, inna rabbahū kāna bihī baṣīrā(n).","words":[{"a":"بَلَىٰٓ","en":"Yes","id":"Yes","t":"balā"},{"a":"إِنَّ","en":"Indeed","id":"Indeed","t":"inna"},{"a":"رَبَّهُۥ","en":"his Lord","id":"his Lord","t":"rabbahu"},{"a":"كَانَ","en":"was","id":"was","t":"kāna"},{"a":"بِهِۦ","en":"of him","id":"of him","t":"bihi"},{"a":"بَصِيرًۭا","en":"All-Seer","id":"All-Seer","t":"baṣīran"}]},{"n":16,"key":"84:16","arabic":"فَلَآ أُقْسِمُ بِٱلشَّفَقِ","page":589,"juz":30,"en":"So I swear by the twilight glow","id":"Maka Aku bersumpah demi cahaya merah pada waktu senja,","latinEn":"Fala oqsimu bishshafaq","latinId":"Falā uqsimu bisy-syafaq(i).","words":[{"a":"فَلَآ","en":"But nay","id":"But nay","t":"falā"},{"a":"أُقْسِمُ","en":"I swear","id":"I swear","t":"uq'simu"},{"a":"بِٱلشَّفَقِ","en":"by the twilight glow","id":"by the twilight glow","t":"bil-shafaqi"}]},{"n":17,"key":"84:17","arabic":"وَٱلَّيْلِ وَمَا وَسَقَ","page":589,"juz":30,"en":"And [by] the night and what it envelops","id":"demi malam dan apa yang diselubunginya,","latinEn":"Wallayli wama wasaq","latinId":"Wal-laili wa mā wasaq(a).","words":[{"a":"وَٱلَّيْلِ","en":"And the night","id":"And the night","t":"wa-al-layli"},{"a":"وَمَا","en":"and what","id":"and what","t":"wamā"},{"a":"وَسَقَ","en":"it envelops","id":"it envelops","t":"wasaqa"}]},{"n":18,"key":"84:18","arabic":"وَٱلْقَمَرِ إِذَا ٱتَّسَقَ","page":589,"juz":30,"en":"And [by] the moon when it becomes full","id":"demi bulan apabila jadi purnama,","latinEn":"Walqamari itha ittasaq","latinId":"Wal-qamari iżattasaq(a).","words":[{"a":"وَٱلْقَمَرِ","en":"And the moon","id":"And the moon","t":"wal-qamari"},{"a":"إِذَا","en":"when","id":"when","t":"idhā"},{"a":"ٱتَّسَقَ","en":"it becomes full","id":"it becomes full","t":"ittasaqa"}]},{"n":19,"key":"84:19","arabic":"لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍ","page":589,"juz":30,"en":"[That] you will surely embark upon [i.e., experience] state after state.","id":"sungguh, akan kamu jalani tingkat demi tingkat (dalam kehidupan).","latinEn":"Latarkabunna tabaqan AAan tabaq","latinId":"Latarkabunna ṭabaqan ‘an ṭabaq(in).","words":[{"a":"لَتَرْكَبُنَّ","en":"You will surely embark","id":"You will surely embark","t":"latarkabunna"},{"a":"طَبَقًا","en":"(to) stage","id":"(to) stage","t":"ṭabaqan"},{"a":"عَن","en":"from","id":"from","t":"ʿan"},{"a":"طَبَقٍۢ","en":"stage","id":"stage","t":"ṭabaqin"}]},{"n":20,"key":"84:20","arabic":"فَمَا لَهُمْ لَا يُؤْمِنُونَ","page":589,"juz":30,"en":"So what is [the matter] with them [that] they do not believe,","id":"Maka mengapa mereka tidak mau beriman?","latinEn":"Fama lahum la yu/minoon","latinId":"Famā lahum lā yu'minūn(a).","words":[{"a":"فَمَا","en":"So what","id":"So what","t":"famā"},{"a":"لَهُمْ","en":"(is) for them","id":"(is) for them","t":"lahum"},{"a":"لَا","en":"not","id":"not","t":"lā"},{"a":"يُؤْمِنُونَ","en":"they believe","id":"they believe","t":"yu'minūna"}]},{"n":21,"key":"84:21","arabic":"وَإِذَا قُرِئَ عَلَيْهِمُ ٱلْقُرْءَانُ لَا يَسْجُدُونَ ۩","page":589,"juz":30,"en":"And when the Qur’ān is recited to them, they do not prostrate [to Allāh]?","id":"Dan apabila Alquran dibacakan kepada mereka, mereka tidak (mau) bersujud,","latinEn":"Wa-itha quri-a AAalayhimu alqur-anula yasjudoon","latinId":"Wa iżā quri'a ‘alaihimul-qur'ānu lā yasjudūn(a).","words":[{"a":"وَإِذَا","en":"And when","id":"And when","t":"wa-idhā"},{"a":"قُرِئَ","en":"is recited","id":"is recited","t":"quri-a"},{"a":"عَلَيْهِمُ","en":"to them","id":"to them","t":"ʿalayhimu"},{"a":"ٱلْقُرْءَانُ","en":"the Quran","id":"the Quran","t":"l-qur'ānu"},{"a":"لَا","en":"not","id":"not","t":"lā"},{"a":"يَسْجُدُونَ ۩","en":"they prostrate","id":"they prostrate","t":"yasjudūna"}]},{"n":22,"key":"84:22","arabic":"بَلِ ٱلَّذِينَ كَفَرُوا۟ يُكَذِّبُونَ","page":589,"juz":30,"en":"But those who have disbelieved deny,","id":"bahkan orang-orang kafir itu mendustakan-(nya).","latinEn":"Bali allatheena kafaroo yukaththiboon","latinId":"Balil-lażīna kafarū yukażżibūn(a).","words":[{"a":"بَلِ","en":"Nay","id":"Nay","t":"bali"},{"a":"ٱلَّذِينَ","en":"Those who","id":"Those who","t":"alladhīna"},{"a":"كَفَرُوا۟","en":"disbelieved","id":"disbelieved","t":"kafarū"},{"a":"يُكَذِّبُونَ","en":"deny","id":"deny","t":"yukadhibūna"}]},{"n":23,"key":"84:23","arabic":"وَٱللَّهُ أَعْلَمُ بِمَا يُوعُونَ","page":589,"juz":30,"en":"And Allāh is most knowing of what they keep within themselves.","id":"Dan Allah lebih mengetahui apa yang mereka sembunyikan (dalam hati mereka).","latinEn":"Wallahu aAAlamu bimayooAAoon","latinId":"Wallāhu a‘lamu bimā yū‘ūn(a).","words":[{"a":"وَٱللَّهُ","en":"And Allah","id":"And Allah","t":"wal-lahu"},{"a":"أَعْلَمُ","en":"(is) most knowing","id":"(is) most knowing","t":"aʿlamu"},{"a":"بِمَا","en":"of what","id":"of what","t":"bimā"},{"a":"يُوعُونَ","en":"they keep within themselves","id":"they keep within themselves","t":"yūʿūna"}]},{"n":24,"key":"84:24","arabic":"فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ","page":589,"juz":30,"en":"So give them tidings of a painful punishment,","id":"Maka sampaikanlah kepada mereka (ancaman) azab yang pedih,","latinEn":"Fabashshirhum biAAathabin aleem","latinId":"Fa basysyirhum bi‘ażābin alīm(in).","words":[{"a":"فَبَشِّرْهُم","en":"so give them tidings","id":"so give them tidings","t":"fabashir'hum"},{"a":"بِعَذَابٍ","en":"of a punishment","id":"of a punishment","t":"biʿadhābin"},{"a":"أَلِيمٍ","en":"painful","id":"painful","t":"alīmin"}]},{"n":25,"key":"84:25","arabic":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۭ","page":590,"juz":30,"en":"Except for those who believe and do righteous deeds. For them is a reward uninterrupted.","id":"kecuali orang-orang yang beriman dan mengerjakan kebajikan, mereka akan mendapat pahala yang tidak putus-putusnya.","latinEn":"Illa allatheena amanoowaAAamiloo assalihati lahum ajrun ghayrumamnoon","latinId":"Illal-lażīna āmanū wa ‘amiluṣ-ṣāliḥāti lahum ajrun gairu mamnūn(in).","words":[{"a":"إِلَّا","en":"Except","id":"Except","t":"illā"},{"a":"ٱلَّذِينَ","en":"those who","id":"those who","t":"alladhīna"},{"a":"ءَامَنُوا۟","en":"believe","id":"believe","t":"āmanū"},{"a":"وَعَمِلُوا۟","en":"and do","id":"and do","t":"waʿamilū"},{"a":"ٱلصَّـٰلِحَـٰتِ","en":"righteous deeds","id":"righteous deeds","t":"l-ṣāliḥāti"},{"a":"لَهُمْ","en":"For them","id":"For them","t":"lahum"},{"a":"أَجْرٌ","en":"(is) a reward","id":"(is) a reward","t":"ajrun"},{"a":"غَيْرُ","en":"never","id":"never","t":"ghayru"},{"a":"مَمْنُونٍۭ","en":"ending","id":"ending","t":"mamnūnin"}]}]}