{"version":2,"surah":86,"verses":[{"n":1,"key":"86:1","arabic":" وَٱلسَّمَآءِ وَٱلطَّارِقِ","page":591,"juz":30,"en":"By the sky and the night comer","id":"Demi langit dan yang datang pada malam hari.","latinEn":"Wassama-i wattariq","latinId":"Was-samā'i waṭ-ṭāriq(i).","words":[{"a":"وَٱلسَّمَآءِ","en":"By the sky","id":"By the sky","t":"wal-samāi"},{"a":"وَٱلطَّارِقِ","en":"and the night comer","id":"and the night comer","t":"wal-ṭāriqi"}]},{"n":2,"key":"86:2","arabic":"وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ","page":591,"juz":30,"en":"And what can make you know what is the night comer?","id":"Dan tahukah kamu apakah yang datang pada malam hari itu?","latinEn":"Wama adraka ma attariq","latinId":"Wa mā adrāka maṭ-ṭāriq(u).","words":[{"a":"وَمَآ","en":"And what","id":"And what","t":"wamā"},{"a":"أَدْرَىٰكَ","en":"can make you know","id":"can make you know","t":"adrāka"},{"a":"مَا","en":"what","id":"what","t":"mā"},{"a":"ٱلطَّارِقُ","en":"the night comer (is)","id":"the night comer (is)","t":"l-ṭāriqu"}]},{"n":3,"key":"86:3","arabic":"ٱلنَّجْمُ ٱلثَّاقِبُ","page":591,"juz":30,"en":"It is the piercing star","id":"(Yaitu) bintang yang bersinar tajam,","latinEn":"Annajmu aththaqib","latinId":"An-najmuṡ-ṡāqib(u).","words":[{"a":"ٱلنَّجْمُ","en":"(It is) the star","id":"(It is) the star","t":"al-najmu"},{"a":"ٱلثَّاقِبُ","en":"the piercing","id":"the piercing","t":"l-thāqibu"}]},{"n":4,"key":"86:4","arabic":"إِن كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ","page":591,"juz":30,"en":"There is no soul but that it has over it a protector.","id":"setiap orang pasti ada penjaganya.","latinEn":"In kullu nafsin lamma AAalayha hafith","latinId":"In kullu nafsil lammā ‘alaihā ḥāfiẓ(un).","words":[{"a":"إِن","en":"Not","id":"Not","t":"in"},{"a":"كُلُّ","en":"(is) every","id":"(is) every","t":"kullu"},{"a":"نَفْسٍۢ","en":"soul","id":"soul","t":"nafsin"},{"a":"لَّمَّا","en":"but","id":"but","t":"lammā"},{"a":"عَلَيْهَا","en":"over it","id":"over it","t":"ʿalayhā"},{"a":"حَافِظٌۭ","en":"(is) a protector","id":"(is) a protector","t":"ḥāfiẓun"}]},{"n":5,"key":"86:5","arabic":"فَلْيَنظُرِ ٱلْإِنسَـٰنُ مِمَّ خُلِقَ","page":591,"juz":30,"en":"So let man observe from what he was created.","id":"Maka hendaklah manusia memperhatikan dari apa dia diciptakan.","latinEn":"Falyanthuri al-insanumimma khuliq","latinId":"Falyanẓuril-insānu mimma khuliq(a).","words":[{"a":"فَلْيَنظُرِ","en":"So let see","id":"So let see","t":"falyanẓuri"},{"a":"ٱلْإِنسَـٰنُ","en":"man","id":"man","t":"l-insānu"},{"a":"مِمَّ","en":"from what","id":"from what","t":"mimma"},{"a":"خُلِقَ","en":"he is created","id":"he is created","t":"khuliqa"}]},{"n":6,"key":"86:6","arabic":"خُلِقَ مِن مَّآءٍ دَافِقٍ","page":591,"juz":30,"en":"He was created from a fluid, ejected,","id":"Dia diciptakan dari air (mani) yang terpancar,","latinEn":"Khuliqa min ma-in dafiq","latinId":"Khuliqa mim mā'in dāfiq(in).","words":[{"a":"خُلِقَ","en":"He is created","id":"He is created","t":"khuliqa"},{"a":"مِن","en":"from","id":"from","t":"min"},{"a":"مَّآءٍۢ","en":"a water","id":"a water","t":"māin"},{"a":"دَافِقٍۢ","en":"ejected","id":"ejected","t":"dāfiqin"}]},{"n":7,"key":"86:7","arabic":"يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ","page":591,"juz":30,"en":"Emerging from between the backbone and the ribs.","id":"yang keluar dari antara tulang punggung (sulbi) dan tulang dada.","latinEn":"Yakhruju min bayni assulbi wattara-ib","latinId":"Yakhruju mim bainiṣ-ṣulbi wat-tarā'ib(i).","words":[{"a":"يَخْرُجُ","en":"Coming forth","id":"Coming forth","t":"yakhruju"},{"a":"مِنۢ","en":"from","id":"from","t":"min"},{"a":"بَيْنِ","en":"between","id":"between","t":"bayni"},{"a":"ٱلصُّلْبِ","en":"the backbone","id":"the backbone","t":"l-ṣul'bi"},{"a":"وَٱلتَّرَآئِبِ","en":"and the ribs","id":"and the ribs","t":"wal-tarāibi"}]},{"n":8,"key":"86:8","arabic":"إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌ","page":591,"juz":30,"en":"Indeed, He [i.e., Allāh], to return him [to life], is Able.","id":"Sungguh, Allah benar-benar kuasa untuk mengembalikannya (hidup setelah mati).","latinEn":"Innahu AAala rajAAihi laqadir","latinId":"Innahū ‘alā raj‘ihī laqādir(un).","words":[{"a":"إِنَّهُۥ","en":"Indeed, He","id":"Indeed, He","t":"innahu"},{"a":"عَلَىٰ","en":"to","id":"to","t":"ʿalā"},{"a":"رَجْعِهِۦ","en":"return him","id":"return him","t":"rajʿihi"},{"a":"لَقَادِرٌۭ","en":"(is) Able","id":"(is) Able","t":"laqādirun"}]},{"n":9,"key":"86:9","arabic":"يَوْمَ تُبْلَى ٱلسَّرَآئِرُ","page":591,"juz":30,"en":"The Day when secrets will be put on trial,","id":"Pada hari ditampakkan segala rahasia,","latinEn":"Yawma tubla assara-ir","latinId":"Yauma tublas-sarā'ir(u).","words":[{"a":"يَوْمَ","en":"(The) Day","id":"(The) Day","t":"yawma"},{"a":"تُبْلَى","en":"will be tested","id":"will be tested","t":"tub'lā"},{"a":"ٱلسَّرَآئِرُ","en":"the secrets","id":"the secrets","t":"l-sarāiru"}]},{"n":10,"key":"86:10","arabic":"فَمَا لَهُۥ مِن قُوَّةٍ وَلَا نَاصِرٍ","page":591,"juz":30,"en":"Then he [i.e., man] will have no power or any helper.","id":"maka manusia tidak lagi mempunyai suatu kekuatan dan tidak (pula) ada penolong.","latinEn":"Fama lahu min quwwatin wala nasir","latinId":"Famā lahū min quwwatiw wa lā nāṣir(in).","words":[{"a":"فَمَا","en":"Then not","id":"Then not","t":"famā"},{"a":"لَهُۥ","en":"(is) for him","id":"(is) for him","t":"lahu"},{"a":"مِن","en":"any","id":"any","t":"min"},{"a":"قُوَّةٍۢ","en":"power","id":"power","t":"quwwatin"},{"a":"وَلَا","en":"and not","id":"and not","t":"walā"},{"a":"نَاصِرٍۢ","en":"any helper","id":"any helper","t":"nāṣirin"}]},{"n":11,"key":"86:11","arabic":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ","page":591,"juz":30,"en":"By the sky which sends back","id":"Demi langit yang mengandung hujan,","latinEn":"Wassama-i thati arrajAA","latinId":"Was-samā'i żātir-raj‘(i).","words":[{"a":"وَٱلسَّمَآءِ","en":"By the sky","id":"By the sky","t":"wal-samāi"},{"a":"ذَاتِ","en":"which","id":"which","t":"dhāti"},{"a":"ٱلرَّجْعِ","en":"returns","id":"returns","t":"l-rajʿi"}]},{"n":12,"key":"86:12","arabic":"وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ","page":591,"juz":30,"en":"And [by] the earth which splits,","id":"dan bumi yang mempunyai tumbuh-tumbuhan,","latinEn":"Wal-ardi thati assadAA","latinId":"Wal-arḍi żātiṣ-ṣad‘(i).","words":[{"a":"وَٱلْأَرْضِ","en":"And the earth","id":"And the earth","t":"wal-arḍi"},{"a":"ذَاتِ","en":"which","id":"which","t":"dhāti"},{"a":"ٱلصَّدْعِ","en":"cracks open","id":"cracks open","t":"l-ṣadʿi"}]},{"n":13,"key":"86:13","arabic":"إِنَّهُۥ لَقَوْلٌ فَصْلٌ","page":591,"juz":30,"en":"Indeed, it [i.e., the Qur’ān] is a decisive statement,","id":"sungguh, (Alquran) itu benar-benar firman pemisah (antara yang hak dan yang batil),","latinEn":"Innahu laqawlun fasl","latinId":"Innahū laqaulun faṣl(un).","words":[{"a":"إِنَّهُۥ","en":"Indeed, it","id":"Indeed, it","t":"innahu"},{"a":"لَقَوْلٌۭ","en":"(is) surely a Word","id":"(is) surely a Word","t":"laqawlun"},{"a":"فَصْلٌۭ","en":"decisive","id":"decisive","t":"faṣlun"}]},{"n":14,"key":"86:14","arabic":"وَمَا هُوَ بِٱلْهَزْلِ","page":591,"juz":30,"en":"And it is not amusement.","id":"dan (Alquran) itu bukanlah senda gurauan.","latinEn":"Wama huwa bilhazl","latinId":"Wa mā huwa bil-hazl(i).","words":[{"a":"وَمَا","en":"And not","id":"And not","t":"wamā"},{"a":"هُوَ","en":"it","id":"it","t":"huwa"},{"a":"بِٱلْهَزْلِ","en":"(is) for amusement","id":"(is) for amusement","t":"bil-hazli"}]},{"n":15,"key":"86:15","arabic":"إِنَّهُمْ يَكِيدُونَ كَيْدًا","page":591,"juz":30,"en":"Indeed, they are planning a plan,","id":"Sungguh, mereka (orang kafir) merencanakan tipu daya yang jahat,","latinEn":"Innahum yakeedoona kayda","latinId":"Innahum yakīdūna kaidā(n).","words":[{"a":"إِنَّهُمْ","en":"Indeed, they","id":"Indeed, they","t":"innahum"},{"a":"يَكِيدُونَ","en":"are plotting","id":"are plotting","t":"yakīdūna"},{"a":"كَيْدًۭا","en":"a plot","id":"a plot","t":"kaydan"}]},{"n":16,"key":"86:16","arabic":"وَأَكِيدُ كَيْدًا","page":591,"juz":30,"en":"But I am planning a plan.","id":"dan Aku pun membuat rencana (tipu daya) yang jitu.","latinEn":"Waakeedu kayda","latinId":"Wa akīdu kaidā(n).","words":[{"a":"وَأَكِيدُ","en":"But I am planning","id":"But I am planning","t":"wa-akīdu"},{"a":"كَيْدًۭا","en":"a plan","id":"a plan","t":"kaydan"}]},{"n":17,"key":"86:17","arabic":"فَمَهِّلِ ٱلْكَـٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا","page":591,"juz":30,"en":"So allow time for the disbelievers. Leave them awhile.","id":"Karena itu berilah penangguhan kepada orang-orang kafir. Berilah mereka kesempatan untuk sementara waktu.","latinEn":"Famahhili alkafireena amhilhum ruwayda","latinId":"Fa mahhilil-kāfirīna amhilhum ruwaidā(n).","words":[{"a":"فَمَهِّلِ","en":"So give respite","id":"So give respite","t":"famahhili"},{"a":"ٱلْكَـٰفِرِينَ","en":"(to) the disbelievers","id":"(to) the disbelievers","t":"l-kāfirīna"},{"a":"أَمْهِلْهُمْ","en":"Give respite to them","id":"Give respite to them","t":"amhil'hum"},{"a":"رُوَيْدًۢا","en":"little","id":"little","t":"ruwaydan"}]}]}