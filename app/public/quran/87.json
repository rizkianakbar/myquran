{"version":2,"surah":87,"verses":[{"n":1,"key":"87:1","arabic":" سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى","page":591,"juz":30,"en":"Exalt the name of your Lord, the Most High,","id":"Sucikanlah nama Tuhanmu Yang Mahatinggi,","latinEn":"Sabbihi isma rabbika al-aAAla","latinId":"Sabbiḥisma rabbikal-a‘lā.","words":[{"a":"سَبِّحِ","en":"Glorify","id":"Glorify","t":"sabbiḥi"},{"a":"ٱسْمَ","en":"(the) name","id":"(the) name","t":"is'ma"},{"a":"رَبِّكَ","en":"(of) your Lord","id":"(of) your Lord","t":"rabbika"},{"a":"ٱلْأَعْلَى","en":"the Most High","id":"the Most High","t":"l-aʿlā"}]},{"n":2,"key":"87:2","arabic":"ٱلَّذِى خَلَقَ فَسَوَّىٰ","page":591,"juz":30,"en":"Who created and proportioned","id":"yang menciptakan, lalu menyempurnakan (penciptaan-Nya),","latinEn":"Allathee khalaqa fasawwa","latinId":"Allażī khalaqa fasawwā.","words":[{"a":"ٱلَّذِى","en":"The One Who","id":"The One Who","t":"alladhī"},{"a":"خَلَقَ","en":"created","id":"created","t":"khalaqa"},{"a":"فَسَوَّىٰ","en":"then proportioned","id":"then proportioned","t":"fasawwā"}]},{"n":3,"key":"87:3","arabic":"وَٱلَّذِى قَدَّرَ فَهَدَىٰ","page":591,"juz":30,"en":"And who destined and [then] guided","id":"yang menentukan kadar (masing-masing) dan memberi petunjuk,","latinEn":"Wallathee qaddara fahada","latinId":"Wal-lażī qaddara fahadā.","words":[{"a":"وَٱلَّذِى","en":"And the One Who","id":"And the One Who","t":"wa-alladhī"},{"a":"قَدَّرَ","en":"measured","id":"measured","t":"qaddara"},{"a":"فَهَدَىٰ","en":"then guided","id":"then guided","t":"fahadā"}]},{"n":4,"key":"87:4","arabic":"وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ","page":591,"juz":30,"en":"And who brings out the pasture","id":"dan Yang menumbuhkan rerumputan,","latinEn":"Wallathee akhraja almarAAa","latinId":"Wal-lażī akhrajal-mar‘ā.","words":[{"a":"وَٱلَّذِىٓ","en":"And the One Who","id":"And the One Who","t":"wa-alladhī"},{"a":"أَخْرَجَ","en":"brings forth","id":"brings forth","t":"akhraja"},{"a":"ٱلْمَرْعَىٰ","en":"the pasture","id":"the pasture","t":"l-marʿā"}]},{"n":5,"key":"87:5","arabic":"فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ","page":591,"juz":30,"en":"And [then] makes it black stubble.","id":"lalu dijadikan-Nya (rumput-rumput) itu kering kehitam-hitaman.","latinEn":"FajaAAalahu ghuthaan ahwa","latinId":"Fa ja‘alahū guṡā'an aḥwā.","words":[{"a":"فَجَعَلَهُۥ","en":"And then makes it","id":"And then makes it","t":"fajaʿalahu"},{"a":"غُثَآءً","en":"stubble","id":"stubble","t":"ghuthāan"},{"a":"أَحْوَىٰ","en":"dark","id":"dark","t":"aḥwā"}]},{"n":6,"key":"87:6","arabic":"سَنُقْرِئُكَ فَلَا تَنسَىٰٓ","page":591,"juz":30,"en":"We will make you recite, [O Muḥammad], and you will not forget,","id":"Kami akan membacakan (Alquran) kepadamu (Muhammad) sehingga engkau tidak akan lupa,","latinEn":"Sanuqri-oka fala tansa","latinId":"Sanuqri'uka falā tansā.","words":[{"a":"سَنُقْرِئُكَ","en":"We will make you recite","id":"We will make you recite","t":"sanuq'ri-uka"},{"a":"فَلَا","en":"so not","id":"so not","t":"falā"},{"a":"تَنسَىٰٓ","en":"you will forget","id":"you will forget","t":"tansā"}]},{"n":7,"key":"87:7","arabic":"إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ","page":591,"juz":30,"en":"Except what Allāh should will. Indeed, He knows what is declared and what is hidden.","id":"kecuali jika Allah menghendaki. Sungguh, Dia mengetahui yang terang dan yang tersembunyi.","latinEn":"Illa ma shaa Allahuinnahu yaAAlamu aljahra wama yakhfa","latinId":"Illā mā syā'allāh(u), innahū ya‘lamul-jahra wa mā yakhfā.","words":[{"a":"إِلَّا","en":"Except","id":"Except","t":"illā"},{"a":"مَا","en":"what","id":"what","t":"mā"},{"a":"شَآءَ","en":"wills","id":"wills","t":"shāa"},{"a":"ٱللَّهُ ۚ","en":"Allah","id":"Allah","t":"l-lahu"},{"a":"إِنَّهُۥ","en":"Indeed, He","id":"Indeed, He","t":"innahu"},{"a":"يَعْلَمُ","en":"knows","id":"knows","t":"yaʿlamu"},{"a":"ٱلْجَهْرَ","en":"the manifest","id":"the manifest","t":"l-jahra"},{"a":"وَمَا","en":"and what","id":"and what","t":"wamā"},{"a":"يَخْفَىٰ","en":"is hidden","id":"is hidden","t":"yakhfā"}]},{"n":8,"key":"87:8","arabic":"وَنُيَسِّرُكَ لِلْيُسْرَىٰ","page":591,"juz":30,"en":"And We will ease you toward ease.","id":"Dan Kami akan memudahkan bagimu ke jalan kemudahan (mencapai kebahagian dunia dan akhirat),","latinEn":"Wanuyassiruka lilyusra","latinId":"Wa nuyassiruka lil-yusrā.","words":[{"a":"وَنُيَسِّرُكَ","en":"And We will ease you","id":"And We will ease you","t":"wanuyassiruka"},{"a":"لِلْيُسْرَىٰ","en":"to the ease","id":"to the ease","t":"lil'yus'rā"}]},{"n":9,"key":"87:9","arabic":"فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ","page":591,"juz":30,"en":"So remind, if the reminder should benefit;","id":"oleh sebab itu berikanlah peringatan, karena peringatan itu bermanfaat,","latinEn":"Fathakkir in nafaAAati aththikra","latinId":"Fa żakkir in nafa‘atiż-żikrā.","words":[{"a":"فَذَكِّرْ","en":"So remind","id":"So remind","t":"fadhakkir"},{"a":"إِن","en":"if","id":"if","t":"in"},{"a":"نَّفَعَتِ","en":"benefits","id":"benefits","t":"nafaʿati"},{"a":"ٱلذِّكْرَىٰ","en":"the reminder","id":"the reminder","t":"l-dhik'rā"}]},{"n":10,"key":"87:10","arabic":"سَيَذَّكَّرُ مَن يَخْشَىٰ","page":591,"juz":30,"en":"He who fears [Allāh] will be reminded.","id":"orang yang takut (kepada Allah) akan mendapat pelajaran,","latinEn":"Sayaththakkaru man yakhsha","latinId":"Sayażżakkaru may yakhsyā.","words":[{"a":"سَيَذَّكَّرُ","en":"He will pay heed","id":"He will pay heed","t":"sayadhakkaru"},{"a":"مَن","en":"(one) who","id":"(one) who","t":"man"},{"a":"يَخْشَىٰ","en":"fears (Allah)","id":"fears (Allah)","t":"yakhshā"}]},{"n":11,"key":"87:11","arabic":"وَيَتَجَنَّبُهَا ٱلْأَشْقَى","page":592,"juz":30,"en":"But the wretched one will avoid it","id":"dan orang yang celaka (kafir) akan menjauhinya,","latinEn":"Wayatajannabuha al-ashqa","latinId":"Wa yatajannabuhal-asyqā.","words":[{"a":"وَيَتَجَنَّبُهَا","en":"And will avoid it","id":"And will avoid it","t":"wayatajannabuhā"},{"a":"ٱلْأَشْقَى","en":"the wretched one","id":"the wretched one","t":"l-ashqā"}]},{"n":12,"key":"87:12","arabic":"ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ","page":592,"juz":30,"en":"[He] who will [enter and] burn in the greatest Fire,","id":"(yaitu) orang yang akan memasuki api yang besar (neraka),","latinEn":"Allathee yasla annaraalkubra","latinId":"Allażī yaṣlan-nāral-kubrā.","words":[{"a":"ٱلَّذِى","en":"The one who","id":"The one who","t":"alladhī"},{"a":"يَصْلَى","en":"will burn","id":"will burn","t":"yaṣlā"},{"a":"ٱلنَّارَ","en":"(in) the Fire","id":"(in) the Fire","t":"l-nāra"},{"a":"ٱلْكُبْرَىٰ","en":"[the] great","id":"[the] great","t":"l-kub'rā"}]},{"n":13,"key":"87:13","arabic":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ","page":592,"juz":30,"en":"Neither dying therein nor living.","id":"selanjutnya dia di sana tidak mati dan tidak (pula) hidup.","latinEn":"Thumma la yamootu feeha walayahya","latinId":"Ṡumma lā yamūtu fīhā wa lā yaḥyā.","words":[{"a":"ثُمَّ","en":"Then","id":"Then","t":"thumma"},{"a":"لَا","en":"not","id":"not","t":"lā"},{"a":"يَمُوتُ","en":"he will die","id":"he will die","t":"yamūtu"},{"a":"فِيهَا","en":"therein","id":"therein","t":"fīhā"},{"a":"وَلَا","en":"and not","id":"and not","t":"walā"},{"a":"يَحْيَىٰ","en":"will live","id":"will live","t":"yaḥyā"}]},{"n":14,"key":"87:14","arabic":"قَدْ أَفْلَحَ مَن تَزَكَّىٰ","page":592,"juz":30,"en":"He has certainly succeeded who purifies himself","id":"Sungguh beruntung orang yang menyucikan diri (dengan beriman),","latinEn":"Qad aflaha man tazakka","latinId":"Qad aflaḥa man tazakkā.","words":[{"a":"قَدْ","en":"Certainly","id":"Certainly","t":"qad"},{"a":"أَفْلَحَ","en":"has succeeded","id":"has succeeded","t":"aflaḥa"},{"a":"مَن","en":"(one) who","id":"(one) who","t":"man"},{"a":"تَزَكَّىٰ","en":"purifies (himself)","id":"purifies (himself)","t":"tazakkā"}]},{"n":15,"key":"87:15","arabic":"وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ","page":592,"juz":30,"en":"And mentions the name of his Lord and prays.","id":"dan mengingat nama Tuhannya, lalu dia salat.","latinEn":"Wathakara isma rabbihi fasalla","latinId":"Wa żakarasma rabbihī fa ṣallā.","words":[{"a":"وَذَكَرَ","en":"And remembers","id":"And remembers","t":"wadhakara"},{"a":"ٱسْمَ","en":"(the) name","id":"(the) name","t":"is'ma"},{"a":"رَبِّهِۦ","en":"(of) his Lord","id":"(of) his Lord","t":"rabbihi"},{"a":"فَصَلَّىٰ","en":"and prays","id":"and prays","t":"faṣallā"}]},{"n":16,"key":"87:16","arabic":"بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا","page":592,"juz":30,"en":"But you prefer the worldly life,","id":"Sedangkan kamu (orang-orang kafir) memilih kehidupan dunia,","latinEn":"Bal tu/thiroona alhayata addunya","latinId":"Bal tu'ṡirūnal-ḥayātad-dun-yā.","words":[{"a":"بَلْ","en":"Nay","id":"Nay","t":"bal"},{"a":"تُؤْثِرُونَ","en":"You prefer","id":"You prefer","t":"tu'thirūna"},{"a":"ٱلْحَيَوٰةَ","en":"the life","id":"the life","t":"l-ḥayata"},{"a":"ٱلدُّنْيَا","en":"(of) the world","id":"(of) the world","t":"l-dun'yā"}]},{"n":17,"key":"87:17","arabic":"وَٱلْـَٔاخِرَةُ خَيْرٌ وَأَبْقَىٰٓ","page":592,"juz":30,"en":"While the Hereafter is better and more enduring.","id":"padahal kehidupan akhirat itu lebih baik dan lebih kekal.","latinEn":"Wal-akhiratu khayrun waabqa","latinId":"Wal-ākhiratu khairuw wa abqā.","words":[{"a":"وَٱلْـَٔاخِرَةُ","en":"While the Hereafter","id":"While the Hereafter","t":"wal-ākhiratu"},{"a":"خَيْرٌۭ","en":"(is) better","id":"(is) better","t":"khayrun"},{"a":"وَأَبْقَىٰٓ","en":"and everlasting","id":"and everlasting","t":"wa-abqā"}]},{"n":18,"key":"87:18","arabic":"إِنَّ هَـٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ","page":592,"juz":30,"en":"Indeed, this is in the former scriptures,","id":"Sesungguhnya ini terdapat dalam kitab-kitab yang dahulu,","latinEn":"Inna hatha lafee assuhufial-oola","latinId":"Inna hāżā lafiṣ-ṣuḥufil-ūlā.","words":[{"a":"إِنَّ","en":"Indeed","id":"Indeed","t":"inna"},{"a":"هَـٰذَا","en":"this","id":"this","t":"hādhā"},{"a":"لَفِى","en":"surely (is) in","id":"surely (is) in","t":"lafī"},{"a":"ٱلصُّحُفِ","en":"the Scriptures","id":"the Scriptures","t":"l-ṣuḥufi"},{"a":"ٱلْأُولَىٰ","en":"[the] former","id":"[the] former","t":"l-ūlā"}]},{"n":19,"key":"87:19","arabic":"صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ","page":592,"juz":30,"en":"The scriptures of Abraham and Moses.","id":"(yaitu) kitab-kitab Ibrahim dan Musa.","latinEn":"Suhufi ibraheema wamoosa","latinId":"Ṣuḥufi ibrāhīma wa mūsā.","words":[{"a":"صُحُفِ","en":"(The) Scriptures","id":"(The) Scriptures","t":"ṣuḥufi"},{"a":"إِبْرَٰهِيمَ","en":"(of) Ibrahim","id":"(of) Ibrahim","t":"ib'rāhīma"},{"a":"وَمُوسَىٰ","en":"and Musa","id":"and Musa","t":"wamūsā"}]}]}