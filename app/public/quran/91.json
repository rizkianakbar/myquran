{"version":2,"surah":91,"verses":[{"n":1,"key":"91:1","arabic":" وَٱلشَّمْسِ وَضُحَىٰهَا","page":595,"juz":30,"en":"By the sun and its brightness","id":"Demi matahari dan sinarnya pada pagi hari,","latinEn":"Washshamsi waduhaha","latinId":"Wasy-syamsi wa ḍuḥāhā.","words":[{"a":"وَٱلشَّمْسِ","en":"By the sun","id":"By the sun","t":"wal-shamsi"},{"a":"وَضُحَىٰهَا","en":"and its brightness","id":"and its brightness","t":"waḍuḥāhā"}]},{"n":2,"key":"91:2","arabic":"وَٱلْقَمَرِ إِذَا تَلَىٰهَا","page":595,"juz":30,"en":"And [by] the moon when it follows it","id":"demi bulan apabila mengiringinya,","latinEn":"Walqamari itha talaha","latinId":"Wal-qamari iżā talāhā.","words":[{"a":"وَٱلْقَمَرِ","en":"And the moon","id":"And the moon","t":"wal-qamari"},{"a":"إِذَا","en":"when","id":"when","t":"idhā"},{"a":"تَلَىٰهَا","en":"it follows it","id":"it follows it","t":"talāhā"}]},{"n":3,"key":"91:3","arabic":"وَٱلنَّهَارِ إِذَا جَلَّىٰهَا","page":595,"juz":30,"en":"And [by] the day when it displays it","id":"demi siang apabila menampakkannya,","latinEn":"Wannahari itha jallaha","latinId":"Wan-nahāri iżā jallāhā.","words":[{"a":"وَٱلنَّهَارِ","en":"And the day","id":"And the day","t":"wal-nahāri"},{"a":"إِذَا","en":"when","id":"when","t":"idhā"},{"a":"جَلَّىٰهَا","en":"it displays it","id":"it displays it","t":"jallāhā"}]},{"n":4,"key":"91:4","arabic":"وَٱلَّيْلِ إِذَا يَغْشَىٰهَا","page":595,"juz":30,"en":"And [by] the night when it covers [i.e., conceals] it","id":"demi malam apabila menutupinya (gelap gulita),","latinEn":"Wallayli itha yaghshaha","latinId":"Wal-laili iżā yagsyāhā.","words":[{"a":"وَٱلَّيْلِ","en":"And the night","id":"And the night","t":"wa-al-layli"},{"a":"إِذَا","en":"when","id":"when","t":"idhā"},{"a":"يَغْشَىٰهَا","en":"it covers it","id":"it covers it","t":"yaghshāhā"}]},{"n":5,"key":"91:5","arabic":"وَٱلسَّمَآءِ وَمَا بَنَىٰهَا","page":595,"juz":30,"en":"And [by] the sky and He who constructed it","id":"demi langit serta perancangannya (yang menakjubkan),","latinEn":"Wassama-i wama banaha","latinId":"Was-samā'i wa mā banāhā.","words":[{"a":"وَٱلسَّمَآءِ","en":"And the heaven","id":"And the heaven","t":"wal-samāi"},{"a":"وَمَا","en":"and (He) Who","id":"and (He) Who","t":"wamā"},{"a":"بَنَىٰهَا","en":"constructed it","id":"constructed it","t":"banāhā"}]},{"n":6,"key":"91:6","arabic":"وَٱلْأَرْضِ وَمَا طَحَىٰهَا","page":595,"juz":30,"en":"And [by] the earth and He who spread it","id":"demi bumi serta penghamparannya,","latinEn":"Wal-ardi wama tahaha","latinId":"Wal-arḍi wa mā ṭaḥāhā.","words":[{"a":"وَٱلْأَرْضِ","en":"And the earth","id":"And the earth","t":"wal-arḍi"},{"a":"وَمَا","en":"and by (He) Who","id":"and by (He) Who","t":"wamā"},{"a":"طَحَىٰهَا","en":"spread it","id":"spread it","t":"ṭaḥāhā"}]},{"n":7,"key":"91:7","arabic":"وَنَفْسٍ وَمَا سَوَّىٰهَا","page":595,"juz":30,"en":"And [by] the soul and He who proportioned it","id":"demi jiwa serta penyempurnaan (ciptaan)nya,","latinEn":"Wanafsin wama sawwaha","latinId":"Wa nafsiw wa mā sawwāhā.","words":[{"a":"وَنَفْسٍۢ","en":"And (the) soul","id":"And (the) soul","t":"wanafsin"},{"a":"وَمَا","en":"and (He) Who","id":"and (He) Who","t":"wamā"},{"a":"سَوَّىٰهَا","en":"proportioned it","id":"proportioned it","t":"sawwāhā"}]},{"n":8,"key":"91:8","arabic":"فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا","page":595,"juz":30,"en":"And inspired it [with discernment of] its wickedness and its righteousness,","id":"maka Dia mengilhamkan kepadanya (jalan) kejahatan dan ketakwaannya,","latinEn":"Faalhamaha fujooraha wataqwaha","latinId":"Fa alhamahā fujūrahā wa taqwāhā.","words":[{"a":"فَأَلْهَمَهَا","en":"And He inspired it","id":"And He inspired it","t":"fa-alhamahā"},{"a":"فُجُورَهَا","en":"(to distinguish) its wickedness","id":"(to distinguish) its wickedness","t":"fujūrahā"},{"a":"وَتَقْوَىٰهَا","en":"and its righteousness","id":"and its righteousness","t":"wataqwāhā"}]},{"n":9,"key":"91:9","arabic":"قَدْ أَفْلَحَ مَن زَكَّىٰهَا","page":595,"juz":30,"en":"He has succeeded who purifies it,","id":"sungguh beruntung orang yang menyucikannya (jiwa itu),","latinEn":"Qad aflaha man zakkaha","latinId":"Qad aflaḥa man zakkāhā.","words":[{"a":"قَدْ","en":"Indeed","id":"Indeed","t":"qad"},{"a":"أَفْلَحَ","en":"he succeeds","id":"he succeeds","t":"aflaḥa"},{"a":"مَن","en":"who","id":"who","t":"man"},{"a":"زَكَّىٰهَا","en":"purifies it","id":"purifies it","t":"zakkāhā"}]},{"n":10,"key":"91:10","arabic":"وَقَدْ خَابَ مَن دَسَّىٰهَا","page":595,"juz":30,"en":"And he has failed who instills it [with corruption].","id":"dan sungguh rugi orang yang mengotorinya.","latinEn":"Waqad khaba man dassaha","latinId":"Wa qad khāba man dassāhā.","words":[{"a":"وَقَدْ","en":"And indeed","id":"And indeed","t":"waqad"},{"a":"خَابَ","en":"he fails","id":"he fails","t":"khāba"},{"a":"مَن","en":"who","id":"who","t":"man"},{"a":"دَسَّىٰهَا","en":"buries it","id":"buries it","t":"dassāhā"}]},{"n":11,"key":"91:11","arabic":"كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ","page":595,"juz":30,"en":"Thamūd denied [their prophet] by reason of their transgression,","id":"(Kaum) Samud telah mendustakan (rasulnya) karena mereka melampaui batas (zalim),","latinEn":"Kaththabat thamoodu bitaghwaha","latinId":"Każżabat ṡamūdu biṭagwāhā.","words":[{"a":"كَذَّبَتْ","en":"Denied","id":"Denied","t":"kadhabat"},{"a":"ثَمُودُ","en":"Thamud","id":"Thamud","t":"thamūdu"},{"a":"بِطَغْوَىٰهَآ","en":"by their transgression","id":"by their transgression","t":"biṭaghwāhā"}]},{"n":12,"key":"91:12","arabic":"إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا","page":595,"juz":30,"en":"When the most wretched of them was sent forth.","id":"ketika bangkit orang yang paling celaka di antara mereka,","latinEn":"Ithi inbaAAatha ashqaha","latinId":"Iżimba‘aṡa asyqāhā.","words":[{"a":"إِذِ","en":"When","id":"When","t":"idhi"},{"a":"ٱنۢبَعَثَ","en":"(was) sent forth","id":"(was) sent forth","t":"inbaʿatha"},{"a":"أَشْقَىٰهَا","en":"(the) most wicked of them","id":"(the) most wicked of them","t":"ashqāhā"}]},{"n":13,"key":"91:13","arabic":"فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَـٰهَا","page":595,"juz":30,"en":"And the messenger of Allāh [i.e., Ṣāliḥ] said to them, \"[Do not harm] the she-camel of Allāh or [prevent her from] her drink.\"","id":"lalu Rasul Allah (Saleh) berkata kepada mereka, \"(Biarkanlah) unta betina dari Allah ini dengan minumannya.\"","latinEn":"Faqala lahum rasoolu Allahi naqataAllahi wasuqyaha","latinId":"Fa qāla lahum rasūlullāhi nāqatallāhi wa suqyāhā.","words":[{"a":"فَقَالَ","en":"But said","id":"But said","t":"faqāla"},{"a":"لَهُمْ","en":"to them","id":"to them","t":"lahum"},{"a":"رَسُولُ","en":"(the) Messenger","id":"(the) Messenger","t":"rasūlu"},{"a":"ٱللَّهِ","en":"(of) Allah","id":"(of) Allah","t":"l-lahi"},{"a":"نَاقَةَ","en":"(It is the) she-camel","id":"(It is the) she-camel","t":"nāqata"},{"a":"ٱللَّهِ","en":"(of) Allah","id":"(of) Allah","t":"l-lahi"},{"a":"وَسُقْيَـٰهَا","en":"and her drink","id":"and her drink","t":"wasuq'yāhā"}]},{"n":14,"key":"91:14","arabic":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا","page":595,"juz":30,"en":"But they denied him and hamstrung her. So their Lord brought down upon them destruction for their sin and made it equal [upon all of them].","id":"Namun mereka mendustakannya dan menyembelihnya, karena itu Tuhan membinasakan mereka karena dosanya, lalu diratakan-Nya (dengan tanah).","latinEn":"Fakaththaboohu faAAaqaroohafadamdama AAalayhim rabbuhum bithanbihim fasawwaha","latinId":"Fa każżabūhu fa ‘aqarūhā fa damdama ‘alaihim rabbuhum biżambihim fa sawwāhā.","words":[{"a":"فَكَذَّبُوهُ","en":"But they denied him","id":"But they denied him","t":"fakadhabūhu"},{"a":"فَعَقَرُوهَا","en":"and they hamstrung her","id":"and they hamstrung her","t":"faʿaqarūhā"},{"a":"فَدَمْدَمَ","en":"So destroyed","id":"So destroyed","t":"fadamdama"},{"a":"عَلَيْهِمْ","en":"them","id":"them","t":"ʿalayhim"},{"a":"رَبُّهُم","en":"their Lord","id":"their Lord","t":"rabbuhum"},{"a":"بِذَنۢبِهِمْ","en":"for their sin","id":"for their sin","t":"bidhanbihim"},{"a":"فَسَوَّىٰهَا","en":"and leveled them","id":"and leveled them","t":"fasawwāhā"}]},{"n":15,"key":"91:15","arabic":"وَلَا يَخَافُ عُقْبَـٰهَا","page":595,"juz":30,"en":"And He does not fear the consequence thereof.","id":"Dan Dia tidak takut terhadap akibatnya.","latinEn":"Wala yakhafu AAuqbaha","latinId":"Wa lā yakhāfu ‘uqbāhā.","words":[{"a":"وَلَا","en":"And not","id":"And not","t":"walā"},{"a":"يَخَافُ","en":"He fears","id":"He fears","t":"yakhāfu"},{"a":"عُقْبَـٰهَا","en":"its consequences","id":"its consequences","t":"ʿuq'bāhā"}]}]}