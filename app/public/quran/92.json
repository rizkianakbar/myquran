{"version":2,"surah":92,"verses":[{"n":1,"key":"92:1","arabic":" وَٱلَّيْلِ إِذَا يَغْشَىٰ","page":595,"juz":30,"en":"By the night when it covers","id":"Demi malam apabila menutupi (cahaya siang),","latinEn":"Wallayli itha yaghsha","latinId":"Wal-laili iżā yagsyā.","words":[{"a":"وَٱلَّيْلِ","en":"By the night","id":"By the night","t":"wa-al-layli"},{"a":"إِذَا","en":"when","id":"when","t":"idhā"},{"a":"يَغْشَىٰ","en":"it covers","id":"it covers","t":"yaghshā"}]},{"n":2,"key":"92:2","arabic":"وَٱلنَّهَارِ إِذَا تَجَلَّىٰ","page":595,"juz":30,"en":"And [by] the day when it appears","id":"demi siang bila terang benderang,","latinEn":"Wannahari itha tajalla","latinId":"Wan-nahāri iżā tajallā.","words":[{"a":"وَٱلنَّهَارِ","en":"And the day","id":"And the day","t":"wal-nahāri"},{"a":"إِذَا","en":"when","id":"when","t":"idhā"},{"a":"تَجَلَّىٰ","en":"it shines in brightness","id":"it shines in brightness","t":"tajallā"}]},{"n":3,"key":"92:3","arabic":"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ","page":595,"juz":30,"en":"And [by] He who created the male and female,","id":"demi penciptaan laki-laki dan perempuan,","latinEn":"Wama khalaqa aththakarawal-ontha","latinId":"Wa mā khalaqaż-żakara wal-unṡā.","words":[{"a":"وَمَا","en":"And He Who","id":"And He Who","t":"wamā"},{"a":"خَلَقَ","en":"created","id":"created","t":"khalaqa"},{"a":"ٱلذَّكَرَ","en":"the male","id":"the male","t":"l-dhakara"},{"a":"وَٱلْأُنثَىٰٓ","en":"and the female","id":"and the female","t":"wal-unthā"}]},{"n":4,"key":"92:4","arabic":"إِنَّ سَعْيَكُمْ لَشَتَّىٰ","page":595,"juz":30,"en":"Indeed, your efforts are diverse.","id":"sungguh, usahamu memang beraneka macam.","latinEn":"Inna saAAyakum lashatta","latinId":"Inna sa‘yakum lasyattā.","words":[{"a":"إِنَّ","en":"Indeed","id":"Indeed","t":"inna"},{"a":"سَعْيَكُمْ","en":"your efforts","id":"your efforts","t":"saʿyakum"},{"a":"لَشَتَّىٰ","en":"(are) surely diverse","id":"(are) surely diverse","t":"lashattā"}]},{"n":5,"key":"92:5","arabic":"فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ","page":595,"juz":30,"en":"As for he who gives and fears Allāh","id":"Maka barangsiapa memberikan (hartanya di jalan Allah) dan bertakwa,","latinEn":"Faamma man aAAta wattaqa","latinId":"Fa ammā man a‘ṭā wattaqā.","words":[{"a":"فَأَمَّا","en":"Then as for","id":"Then as for","t":"fa-ammā"},{"a":"مَنْ","en":"(him) who","id":"(him) who","t":"man"},{"a":"أَعْطَىٰ","en":"gives","id":"gives","t":"aʿṭā"},{"a":"وَٱتَّقَىٰ","en":"and fears","id":"and fears","t":"wa-ittaqā"}]},{"n":6,"key":"92:6","arabic":"وَصَدَّقَ بِٱلْحُسْنَىٰ","page":595,"juz":30,"en":"And believes in the best [reward],","id":"dan membenarkan (adanya pahala) yang terbaik (surga),","latinEn":"Wasaddaqa bilhusna","latinId":"Wa ṣaddaqa bil-ḥusnā.","words":[{"a":"وَصَدَّقَ","en":"And believes","id":"And believes","t":"waṣaddaqa"},{"a":"بِٱلْحُسْنَىٰ","en":"in the best","id":"in the best","t":"bil-ḥus'nā"}]},{"n":7,"key":"92:7","arabic":"فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ","page":595,"juz":30,"en":"We will ease him toward ease.","id":"maka akan Kami mudahkan baginya jalan menuju kemudahan (kebahagiaan).","latinEn":"Fasanuyassiruhu lilyusra","latinId":"Fa sanuyassiruhū lil-yusrā.","words":[{"a":"فَسَنُيَسِّرُهُۥ","en":"Then We will ease him","id":"Then We will ease him","t":"fasanuyassiruhu"},{"a":"لِلْيُسْرَىٰ","en":"towards [the] ease","id":"towards [the] ease","t":"lil'yus'rā"}]},{"n":8,"key":"92:8","arabic":"وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ","page":595,"juz":30,"en":"But as for he who withholds and considers himself free of need","id":"Dan adapun orang yang kikir dan merasa dirinya cukup (tidak perlu pertolongan Allah),","latinEn":"Waamma man bakhila wastaghna","latinId":"Wa ammā man bakhila wastagnā.","words":[{"a":"وَأَمَّا","en":"But as for","id":"But as for","t":"wa-ammā"},{"a":"مَنۢ","en":"(him) who","id":"(him) who","t":"man"},{"a":"بَخِلَ","en":"withholds","id":"withholds","t":"bakhila"},{"a":"وَٱسْتَغْنَىٰ","en":"and considers himself free from need","id":"and considers himself free from need","t":"wa-is'taghnā"}]},{"n":9,"key":"92:9","arabic":"وَكَذَّبَ بِٱلْحُسْنَىٰ","page":595,"juz":30,"en":"And denies the best [reward],","id":"serta mendustakan (pahala) yang terbaik,","latinEn":"Wakaththaba bilhusna","latinId":"Wa każżaba bil-ḥusnā.","words":[{"a":"وَكَذَّبَ","en":"And denies","id":"And denies","t":"wakadhaba"},{"a":"بِٱلْحُسْنَىٰ","en":"the best","id":"the best","t":"bil-ḥus'nā"}]},{"n":10,"key":"92:10","arabic":"فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ","page":596,"juz":30,"en":"We will ease him toward difficulty.","id":"maka akan Kami mudahkan baginya jalan menuju kesukaran (kesengsaraan).","latinEn":"Fasanuyassiruhu lilAAusra","latinId":"Fa sanuyassiruhū lil-‘usrā.","words":[{"a":"فَسَنُيَسِّرُهُۥ","en":"Then We will ease him","id":"Then We will ease him","t":"fasanuyassiruhu"},{"a":"لِلْعُسْرَىٰ","en":"towards [the] difficulty","id":"towards [the] difficulty","t":"lil'ʿus'rā"}]},{"n":11,"key":"92:11","arabic":"وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ","page":596,"juz":30,"en":"And what will his wealth avail him when he falls?","id":"Dan hartanya tidak bermanfaat baginya apabila dia telah binasa.","latinEn":"Wama yughnee AAanhu maluhu ithataradda","latinId":"Wa mā yugnī ‘anhu māluhū iżā taraddā.","words":[{"a":"وَمَا","en":"And not","id":"And not","t":"wamā"},{"a":"يُغْنِى","en":"will avail","id":"will avail","t":"yugh'nī"},{"a":"عَنْهُ","en":"him","id":"him","t":"ʿanhu"},{"a":"مَالُهُۥٓ","en":"his wealth","id":"his wealth","t":"māluhu"},{"a":"إِذَا","en":"when","id":"when","t":"idhā"},{"a":"تَرَدَّىٰٓ","en":"he falls","id":"he falls","t":"taraddā"}]},{"n":12,"key":"92:12","arabic":"إِنَّ عَلَيْنَا لَلْهُدَىٰ","page":596,"juz":30,"en":"Indeed, [incumbent] upon Us is guidance.","id":"Sesungguhnya Kami lah yang memberi petunjuk,","latinEn":"Inna AAalayna lalhuda","latinId":"Inna ‘alainā lal-hudā.","words":[{"a":"إِنَّ","en":"Indeed","id":"Indeed","t":"inna"},{"a":"عَلَيْنَا","en":"upon Us","id":"upon Us","t":"ʿalaynā"},{"a":"لَلْهُدَىٰ","en":"(is) the guidance","id":"(is) the guidance","t":"lalhudā"}]},{"n":13,"key":"92:13","arabic":"وَإِنَّ لَنَا لَلْـَٔاخِرَةَ وَٱلْأُولَىٰ","page":596,"juz":30,"en":"And indeed, to us belongs the Hereafter and the first [life].","id":"dan sesungguhnya milik Kami lah akhirat dan dunia.","latinEn":"Wa-inna lana lal-akhirata wal-oola","latinId":"Wa inna lanā lal-ākhirata wal-ūlā.","words":[{"a":"وَإِنَّ","en":"And indeed","id":"And indeed","t":"wa-inna"},{"a":"لَنَا","en":"for Us","id":"for Us","t":"lanā"},{"a":"لَلْـَٔاخِرَةَ","en":"(is) the Hereafter","id":"(is) the Hereafter","t":"lalākhirata"},{"a":"وَٱلْأُولَىٰ","en":"and the first (life)","id":"and the first (life)","t":"wal-ūlā"}]},{"n":14,"key":"92:14","arabic":"فَأَنذَرْتُكُمْ نَارًا تَلَظَّىٰ","page":596,"juz":30,"en":"So I have warned you of a Fire which is blazing.","id":"Maka aku memperingatkan kamu dengan neraka yang menyala-nyala,","latinEn":"Faanthartukum naran talaththa","latinId":"Fa anżartukum nāran talaẓẓā.","words":[{"a":"فَأَنذَرْتُكُمْ","en":"So I warn you","id":"So I warn you","t":"fa-andhartukum"},{"a":"نَارًۭا","en":"(of) a Fire","id":"(of) a Fire","t":"nāran"},{"a":"تَلَظَّىٰ","en":"blazing","id":"blazing","t":"talaẓẓā"}]},{"n":15,"key":"92:15","arabic":"لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى","page":596,"juz":30,"en":"None will [enter to] burn therein except the most wretched one","id":"yang hanya dimasuki oleh orang yang paling celaka,","latinEn":"La yaslaha illaal-ashqa","latinId":"Lā yaṣlāhā illal-asyqā.","words":[{"a":"لَا","en":"Not","id":"Not","t":"lā"},{"a":"يَصْلَىٰهَآ","en":"will burn (in) it","id":"will burn (in) it","t":"yaṣlāhā"},{"a":"إِلَّا","en":"except","id":"except","t":"illā"},{"a":"ٱلْأَشْقَى","en":"the most wretched","id":"the most wretched","t":"l-ashqā"}]},{"n":16,"key":"92:16","arabic":"ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ","page":596,"juz":30,"en":"Who had denied and turned away.","id":"yang mendustakan (kebenaran) dan berpaling (dari iman).","latinEn":"Allathee kaththaba watawalla","latinId":"Allażī każżaba wa tawallā.","words":[{"a":"ٱلَّذِى","en":"The one who","id":"The one who","t":"alladhī"},{"a":"كَذَّبَ","en":"denied","id":"denied","t":"kadhaba"},{"a":"وَتَوَلَّىٰ","en":"and turned away","id":"and turned away","t":"watawallā"}]},{"n":17,"key":"92:17","arabic":"وَسَيُجَنَّبُهَا ٱلْأَتْقَى","page":596,"juz":30,"en":"But the righteous one will avoid it","id":"Dan akan dijauhkan darinya (neraka) orang yang paling bertakwa,","latinEn":"Wasayujannabuha al-atqa","latinId":"Wa sayujannabuhal-atqā.","words":[{"a":"وَسَيُجَنَّبُهَا","en":"But will be removed from it","id":"But will be removed from it","t":"wasayujannabuhā"},{"a":"ٱلْأَتْقَى","en":"the righteous","id":"the righteous","t":"l-atqā"}]},{"n":18,"key":"92:18","arabic":"ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ","page":596,"juz":30,"en":"[He] who gives [from] his wealth to purify himself","id":"yang menginfakkan hartanya (di jalan Allah) untuk membersihkan (dirinya),","latinEn":"Allathee yu/tee malahuyatazakka","latinId":"Allażī yu'tī mālahū yatazakkā.","words":[{"a":"ٱلَّذِى","en":"The one who","id":"The one who","t":"alladhī"},{"a":"يُؤْتِى","en":"gives","id":"gives","t":"yu'tī"},{"a":"مَالَهُۥ","en":"his wealth","id":"his wealth","t":"mālahu"},{"a":"يَتَزَكَّىٰ","en":"(to) purify himself","id":"(to) purify himself","t":"yatazakkā"}]},{"n":19,"key":"92:19","arabic":"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍ تُجْزَىٰٓ","page":596,"juz":30,"en":"And not [giving] for anyone who has [done him] a favor to be rewarded","id":"dan tidak ada seorang pun memberikan suatu nikmat padanya yang harus dibalasnya,","latinEn":"Wama li-ahadin AAindahu minniAAmatin tujza","latinId":"Wa mā li'aḥadin ‘indahū min ni‘matin tujzā.","words":[{"a":"وَمَا","en":"And not","id":"And not","t":"wamā"},{"a":"لِأَحَدٍ","en":"for anyone","id":"for anyone","t":"li-aḥadin"},{"a":"عِندَهُۥ","en":"with him","id":"with him","t":"ʿindahu"},{"a":"مِن","en":"any","id":"any","t":"min"},{"a":"نِّعْمَةٍۢ","en":"favor","id":"favor","t":"niʿ'matin"},{"a":"تُجْزَىٰٓ","en":"to be recompensed","id":"to be recompensed","t":"tuj'zā"}]},{"n":20,"key":"92:20","arabic":"إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ","page":596,"juz":30,"en":"But only seeking the face [i.e., acceptance] of his Lord, Most High.","id":"tetapi (dia memberikan itu semata-mata) karena mencari keridaan Tuhannya Yang Mahatinggi.","latinEn":"Illa ibtighaa wajhi rabbihial-aAAla","latinId":"Illabtigā'a wajhi rabbihil-a‘lā.","words":[{"a":"إِلَّا","en":"Except","id":"Except","t":"illā"},{"a":"ٱبْتِغَآءَ","en":"seeking","id":"seeking","t":"ib'tighāa"},{"a":"وَجْهِ","en":"(the) Countenance","id":"(the) Countenance","t":"wajhi"},{"a":"رَبِّهِ","en":"(of) his Lord","id":"(of) his Lord","t":"rabbihi"},{"a":"ٱلْأَعْلَىٰ","en":"the Most High","id":"the Most High","t":"l-aʿlā"}]},{"n":21,"key":"92:21","arabic":"وَلَسَوْفَ يَرْضَىٰ","page":596,"juz":30,"en":"And he is going to be satisfied.","id":"Dan niscaya kelak dia akan mendapat kesenangan (yang sempurna).","latinEn":"Walasawfa yarda","latinId":"Wa lasaufa yarḍā.","words":[{"a":"وَلَسَوْفَ","en":"And soon, surely","id":"And soon, surely","t":"walasawfa"},{"a":"يَرْضَىٰ","en":"he will be pleased","id":"he will be pleased","t":"yarḍā"}]}]}