{"version":2,"surah":95,"verses":[{"n":1,"key":"95:1","arabic":"وَٱلتِّينِ وَٱلزَّيْتُونِ","page":597,"juz":30,"en":"By the fig and the olive","id":"Demi (buah) Tin dan (buah) Zaitun,","latinEn":"Watteeni wazzaytoon","latinId":"Wat-tīni waz-zaitūn(i).","words":[{"a":"وَٱلتِّينِ","en":"By the fig","id":"By the fig","t":"wal-tīni"},{"a":"وَٱلزَّيْتُونِ","en":"and the olive","id":"and the olive","t":"wal-zaytūni"}]},{"n":2,"key":"95:2","arabic":"وَطُورِ سِينِينَ","page":597,"juz":30,"en":"And [by] Mount Sinai","id":"demi gunung Sinai,","latinEn":"Watoori seeneen","latinId":"Wa ṭūri sīnīn(a).","words":[{"a":"وَطُورِ","en":"And (the) Mount","id":"And (the) Mount","t":"waṭūri"},{"a":"سِينِينَ","en":"Sinai","id":"Sinai","t":"sīnīna"}]},{"n":3,"key":"95:3","arabic":"وَهَـٰذَا ٱلْبَلَدِ ٱلْأَمِينِ","page":597,"juz":30,"en":"And [by] this secure city [i.e., Makkah],","id":"dan demi negeri (Mekkah) yang aman ini.","latinEn":"Wahatha albaladi al-ameen","latinId":"Wa hāżal-baladil-amīn(i).","words":[{"a":"وَهَـٰذَا","en":"And this","id":"And this","t":"wahādhā"},{"a":"ٱلْبَلَدِ","en":"[the] city","id":"[the] city","t":"l-baladi"},{"a":"ٱلْأَمِينِ","en":"[the] secure","id":"[the] secure","t":"l-amīni"}]},{"n":4,"key":"95:4","arabic":"لَقَدْ خَلَقْنَا ٱلْإِنسَـٰنَ فِىٓ أَحْسَنِ تَقْوِيمٍ","page":597,"juz":30,"en":"We have certainly created man in the best of stature;","id":"Sungguh, Kami telah menciptakan manusia dalam bentuk yang sebaik-baiknya,","latinEn":"Laqad khalaqna al-insana fee ahsanitaqweem","latinId":"Laqad khalaqnal-insāna fī aḥsani taqwīm(in).","words":[{"a":"لَقَدْ","en":"Indeed","id":"Indeed","t":"laqad"},{"a":"خَلَقْنَا","en":"We created","id":"We created","t":"khalaqnā"},{"a":"ٱلْإِنسَـٰنَ","en":"man","id":"man","t":"l-insāna"},{"a":"فِىٓ","en":"in","id":"in","t":"fī"},{"a":"أَحْسَنِ","en":"(the) best","id":"(the) best","t":"aḥsani"},{"a":"تَقْوِيمٍۢ","en":"mould","id":"mould","t":"taqwīmin"}]},{"n":5,"key":"95:5","arabic":"ثُمَّ رَدَدْنَـٰهُ أَسْفَلَ سَـٰفِلِينَ","page":597,"juz":30,"en":"Then We return him to the lowest of the low,","id":"kemudian Kami kembalikan dia ke tempat yang serendah-rendahnya,","latinEn":"Thumma radadnahu asfala safileen","latinId":"Ṡumma radadnāhu asfala sāfilīn(a).","words":[{"a":"ثُمَّ","en":"Then","id":"Then","t":"thumma"},{"a":"رَدَدْنَـٰهُ","en":"We returned him","id":"We returned him","t":"radadnāhu"},{"a":"أَسْفَلَ","en":"(to the) lowest","id":"(to the) lowest","t":"asfala"},{"a":"سَـٰفِلِينَ","en":"(of the) low","id":"(of the) low","t":"sāfilīna"}]},{"n":6,"key":"95:6","arabic":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍ","page":597,"juz":30,"en":"Except for those who believe and do righteous deeds, for they will have a reward uninterrupted.","id":"kecuali orang-orang yang beriman dan mengerjakan kebajikan; maka mereka akan mendapat pahala yang tidak ada putus-putusnya.","latinEn":"Illa allatheena amanoowaAAamiloo assalihati falahum ajrun ghayrumamnoon","latinId":"Illal-lażīna āmanū wa ‘amiluṣ-ṣāliḥāti falahum ajrun gairu mamnūn(in).","words":[{"a":"إِلَّا","en":"Except","id":"Except","t":"illā"},{"a":"ٱلَّذِينَ","en":"those who","id":"those who","t":"alladhīna"},{"a":"ءَامَنُوا۟","en":"believe","id":"believe","t":"āmanū"},{"a":"وَعَمِلُوا۟","en":"and do","id":"and do","t":"waʿamilū"},{"a":"ٱلصَّـٰلِحَـٰتِ","en":"righteous deeds","id":"righteous deeds","t":"l-ṣāliḥāti"},{"a":"فَلَهُمْ","en":"then for them","id":"then for them","t":"falahum"},{"a":"أَجْرٌ","en":"(is a) reward","id":"(is a) reward","t":"ajrun"},{"a":"غَيْرُ","en":"never","id":"never","t":"ghayru"},{"a":"مَمْنُونٍۢ","en":"ending","id":"ending","t":"mamnūnin"}]},{"n":7,"key":"95:7","arabic":"فَمَا يُكَذِّبُكَ بَعْدُ بِٱلدِّينِ","page":597,"juz":30,"en":"So what yet causes you to deny the Recompense?","id":"Maka apa yang menyebabkan (mereka) mendustakanmu (tentang) hari pembalasan setelah (adanya keterangan-keterangan) itu?","latinEn":"Fama yukaththibuka baAAdu biddeen","latinId":"Famā yukażżibuka ba‘du bid-dīn(i).","words":[{"a":"فَمَا","en":"Then what","id":"Then what","t":"famā"},{"a":"يُكَذِّبُكَ","en":"causes you to deny","id":"causes you to deny","t":"yukadhibuka"},{"a":"بَعْدُ","en":"after (this)","id":"after (this)","t":"baʿdu"},{"a":"بِٱلدِّينِ","en":"the judgment","id":"the judgment","t":"bil-dīni"}]},{"n":8,"key":"95:8","arabic":"أَلَيْسَ ٱللَّهُ بِأَحْكَمِ ٱلْحَـٰكِمِينَ","page":597,"juz":30,"en":"Is not Allāh the most just of judges?","id":"Bukankah Allah Hakim yang paling adil?","latinEn":"Alaysa Allahu bi-ahkami alhakimeen","latinId":"Alaisallāhu bi'aḥkamil-ḥākimīn(a).","words":[{"a":"أَلَيْسَ","en":"Is not","id":"Is not","t":"alaysa"},{"a":"ٱللَّهُ","en":"Allah","id":"Allah","t":"l-lahu"},{"a":"بِأَحْكَمِ","en":"(the) Most Just","id":"(the) Most Just","t":"bi-aḥkami"},{"a":"ٱلْحَـٰكِمِينَ","en":"(of) the Judges","id":"(of) the Judges","t":"l-ḥākimīna"}]}]}