{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**/*.{css,json,md,mjs,scss,toml,mjs,ts,tsx,yaml,yml}",
      "!**/{.astro,.react-router}/**/*",
      "!**/app/app/routeTree.gen.ts",
      "!**/build/**/*",
      "!**/databases/**/{data,schema}_migrations/**/*",
      "!**/public/openapi/*.json",
      "!**/public/quran/**/*",
      "!**/secure/**/*.v*.json",
      "!node_modules",
      "!package.json"
    ]
  },
  "vcs": {
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "bracketSameLine": true,
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "json": {
    "formatter": {
      "lineWidth": 120
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "enabled": true,
      "lineWidth": 120,
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "complexity": {
        "noBannedTypes": "off"
      },
      "correctness": {
        "noEmptyPattern": "off",
        "noUnusedPrivateClassMembers": "off",
        "noUnusedFunctionParameters": "off",
        "noUnusedVariables": "off"
      },
      "style": {
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noExplicitAny": "off"
      }
    }
  }
}