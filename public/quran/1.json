{"version":2,"surah":1,"verses":[{"n":1,"key":"1:1","arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ","page":1,"juz":1,"en":"In the name of Allāh, the Entirely Merciful, the Especially Merciful.","id":"Dengan nama Allah Yang Maha Pengasih, Maha Penyayang.","latinEn":"Bismi Allahi arrahmani arraheem","latinId":"Bismillāhir-raḥmānir-raḥīm(i).","words":[{"a":"بِسْمِ","en":"In (the) name","id":"In (the) name","t":"bis'mi"},{"a":"ٱللَّهِ","en":"(of) Allah","id":"(of) Allah","t":"l-lahi"},{"a":"ٱلرَّحْمَـٰنِ","en":"the Most Gracious","id":"the Most Gracious","t":"l-raḥmāni"},{"a":"ٱلرَّحِيمِ","en":"the Most Merciful","id":"the Most Merciful","t":"l-raḥīmi"}]},{"n":2,"key":"1:2","arabic":"ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَـٰلَمِينَ","page":1,"juz":1,"en":"[All] praise is [due] to Allāh, Lord of the worlds -","id":"Segala puji bagi Allah, Tuhan seluruh alam,","latinEn":"Alhamdu lillahi rabbi alAAalameen","latinId":"Al-ḥamdu lillāhi rabbil-‘ālamīn(a).","words":[{"a":"ٱلْحَمْدُ","en":"All praises and thanks","id":"All praises and thanks","t":"al-ḥamdu"},{"a":"لِلَّهِ","en":"(be) to Allah","id":"(be) to Allah","t":"lillahi"},{"a":"رَبِّ","en":"the Lord","id":"the Lord","t":"rabbi"},{"a":"ٱلْعَـٰلَمِينَ","en":"of the universe","id":"of the universe","t":"l-ʿālamīna"}]},{"n":3,"key":"1:3","arabic":"ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ","page":1,"juz":1,"en":"The Entirely Merciful, the Especially Merciful,","id":"Yang Maha Pengasih, Maha Penyayang,","latinEn":"Arrahmani arraheem","latinId":"Ar-raḥmānir-raḥīm(i).","words":[{"a":"ٱلرَّحْمَـٰنِ","en":"The Most Gracious","id":"The Most Gracious","t":"al-raḥmāni"},{"a":"ٱلرَّحِيمِ","en":"the Most Merciful","id":"the Most Merciful","t":"l-raḥīmi"}]},{"n":4,"key":"1:4","arabic":"مَـٰلِكِ يَوْمِ ٱلدِّينِ","page":1,"juz":1,"en":"Sovereign of the Day of Recompense.","id":"Pemilik hari pembalasan.","latinEn":"Maliki yawmi addeen","latinId":"Māliki yaumid-dīn(i).","words":[{"a":"مَـٰلِكِ","en":"(The) Master","id":"(The) Master","t":"māliki"},{"a":"يَوْمِ","en":"(of the) Day","id":"(of the) Day","t":"yawmi"},{"a":"ٱلدِّينِ","en":"(of the) Judgment","id":"(of the) Judgment","t":"l-dīni"}]},{"n":5,"key":"1:5","arabic":"إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ","page":1,"juz":1,"en":"It is You we worship and You we ask for help.","id":"Hanya kepada Engkaulah kami menyembah dan hanya kepada Engkaulah kami mohon pertolongan.","latinEn":"Iyyaka naAAbudu wa-iyyaka nastaAAeen","latinId":"Iyyāka na‘budu wa iyyāka nasta‘īn(u),","words":[{"a":"إِيَّاكَ","en":"You Alone","id":"You Alone","t":"iyyāka"},{"a":"نَعْبُدُ","en":"we worship","id":"we worship","t":"naʿbudu"},{"a":"وَإِيَّاكَ","en":"and You Alone","id":"and You Alone","t":"wa-iyyāka"},{"a":"نَسْتَعِينُ","en":"we ask for help","id":"we ask for help","t":"nastaʿīnu"}]},{"n":6,"key":"1:6","arabic":"ٱهْدِنَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ","page":1,"juz":1,"en":"Guide us to the straight path -","id":"Tunjukilah kami jalan yang lurus,","latinEn":"Ihdina assirata almustaqeem","latinId":"Ihdinaṣ-ṣirāṭal-mustaqīm(a).","words":[{"a":"ٱهْدِنَا","en":"Guide us","id":"Guide us","t":"ih'dinā"},{"a":"ٱلصِّرَٰطَ","en":"(to) the path","id":"(to) the path","t":"l-ṣirāṭa"},{"a":"ٱلْمُسْتَقِيمَ","en":"the straight","id":"the straight","t":"l-mus'taqīma"}]},{"n":7,"key":"1:7","arabic":"صِرَٰطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا ٱلضَّآلِّينَ","page":1,"juz":1,"en":"The path of those upon whom You have bestowed favor, not of those who have earned [Your] anger or of those who are astray.","id":"(yaitu) jalan orang-orang yang telah Engkau beri nikmat kepadanya; bukan (jalan) mereka yang dimurkai, dan bukan (pula jalan) mereka yang sesat.","latinEn":"Sirata allatheena anAAamta AAalayhim ghayri almaghdoobi AAalayhim wala addalleen","latinId":"Ṣirāṭal-lażīna an‘amta ‘alaihim, gairil-magḍūbi ‘alaihim wa laḍ-ḍāllīn(a).","words":[{"a":"صِرَٰطَ","en":"(The) path","id":"(The) path","t":"ṣirāṭa"},{"a":"ٱلَّذِينَ","en":"(of) those","id":"(of) those","t":"alladhīna"},{"a":"أَنْعَمْتَ","en":"You have bestowed (Your) Favors","id":"You have bestowed (Your) Favors","t":"anʿamta"},{"a":"عَلَيْهِمْ","en":"on them","id":"on them","t":"ʿalayhim"},{"a":"غَيْرِ","en":"not (of)","id":"not (of)","t":"ghayri"},{"a":"ٱلْمَغْضُوبِ","en":"those who earned (Your) wrath","id":"those who earned (Your) wrath","t":"l-maghḍūbi"},{"a":"عَلَيْهِمْ","en":"on themselves","id":"on themselves","t":"ʿalayhim"},{"a":"وَلَا","en":"and not","id":"and not","t":"walā"},{"a":"ٱلضَّآلِّينَ","en":"(of) those who go astray","id":"(of) those who go astray","t":"l-ḍālīna"}]}]}