{"version":2,"surah":100,"verses":[{"n":1,"key":"100:1","arabic":" وَٱلْعَـٰدِيَـٰتِ ضَبْحًا","page":599,"juz":30,"en":"By the racers, panting,","id":"Demi kuda perang yang berlari kencang terengah-engah,","latinEn":"WalAAadiyati dabha","latinId":"Wal-‘ādiyāti ḍabḥā(n).","words":[{"a":"وَٱلْعَـٰدِيَـٰتِ","en":"By the racers","id":"By the racers","t":"wal-ʿādiyāti"},{"a":"ضَبْحًۭا","en":"panting","id":"panting","t":"ḍabḥan"}]},{"n":2,"key":"100:2","arabic":"فَٱلْمُورِيَـٰتِ قَدْحًا","page":599,"juz":30,"en":"And the producers of sparks [when] striking","id":"dan kuda yang memercikkan bunga api (dengan pukulan kuku kakinya),","latinEn":"Falmooriyati qadha","latinId":"Fal-mūriyāti qadḥā(n).","words":[{"a":"فَٱلْمُورِيَـٰتِ","en":"And the producers of sparks","id":"And the producers of sparks","t":"fal-mūriyāti"},{"a":"قَدْحًۭا","en":"striking","id":"striking","t":"qadḥan"}]},{"n":3,"key":"100:3","arabic":"فَٱلْمُغِيرَٰتِ صُبْحًا","page":599,"juz":30,"en":"And the chargers at dawn,","id":"dan kuda yang menyerang (dengan tiba-tiba) pada waktu pagi,","latinEn":"Falmugheerati subha","latinId":"Fal-mugīrāti ṣubḥā(n).","words":[{"a":"فَٱلْمُغِيرَٰتِ","en":"And the chargers","id":"And the chargers","t":"fal-mughīrāti"},{"a":"صُبْحًۭا","en":"(at) dawn","id":"(at) dawn","t":"ṣub'ḥan"}]},{"n":4,"key":"100:4","arabic":"فَأَثَرْنَ بِهِۦ نَقْعًا","page":599,"juz":30,"en":"Stirring up thereby [clouds of] dust,","id":"sehingga menerbangkan debu,","latinEn":"Faatharna bihi naqAAa","latinId":"Fa'aṡarna bihī naq‘ā(n).","words":[{"a":"فَأَثَرْنَ","en":"Then raise","id":"Then raise","t":"fa-atharna"},{"a":"بِهِۦ","en":"thereby","id":"thereby","t":"bihi"},{"a":"نَقْعًۭا","en":"dust","id":"dust","t":"naqʿan"}]},{"n":5,"key":"100:5","arabic":"فَوَسَطْنَ بِهِۦ جَمْعًا","page":599,"juz":30,"en":"Arriving thereby in the center collectively,","id":"lalu menyerbu ke tengah-tengah kumpulan musuh,","latinEn":"Fawasatna bihi jamAAa","latinId":"Fawasaṭna bihī jam‘ā(n).","words":[{"a":"فَوَسَطْنَ","en":"Then penetrate (in the) center","id":"Then penetrate (in the) center","t":"fawasaṭna"},{"a":"بِهِۦ","en":"thereby","id":"thereby","t":"bihi"},{"a":"جَمْعًا","en":"collectively","id":"collectively","t":"jamʿan"}]},{"n":6,"key":"100:6","arabic":"إِنَّ ٱلْإِنسَـٰنَ لِرَبِّهِۦ لَكَنُودٌ","page":600,"juz":30,"en":"Indeed mankind, to his Lord, is ungrateful.","id":"sungguh, manusia itu sangat ingkar, (tidak bersyukur) kepada Tuhannya,","latinEn":"Inna al-insana lirabbihi lakanood","latinId":"Innal-insāna lirabbihī lakanūd(un).","words":[{"a":"إِنَّ","en":"Indeed","id":"Indeed","t":"inna"},{"a":"ٱلْإِنسَـٰنَ","en":"mankind","id":"mankind","t":"l-insāna"},{"a":"لِرَبِّهِۦ","en":"to his Lord","id":"to his Lord","t":"lirabbihi"},{"a":"لَكَنُودٌۭ","en":"(is) surely ungrateful","id":"(is) surely ungrateful","t":"lakanūdun"}]},{"n":7,"key":"100:7","arabic":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌ","page":600,"juz":30,"en":"And indeed, he is to that a witness.","id":"dan sesungguhnya dia (manusia) menyaksikan (mengakui) keingkarannya,","latinEn":"Wa-innahu AAala thalikalashaheed","latinId":"Wa innahū ‘alā żālika lasyahīd(un).","words":[{"a":"وَإِنَّهُۥ","en":"And indeed, he","id":"And indeed, he","t":"wa-innahu"},{"a":"عَلَىٰ","en":"on","id":"on","t":"ʿalā"},{"a":"ذَٰلِكَ","en":"that","id":"that","t":"dhālika"},{"a":"لَشَهِيدٌۭ","en":"surely (is) a witness","id":"surely (is) a witness","t":"lashahīdun"}]},{"n":8,"key":"100:8","arabic":"وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ","page":600,"juz":30,"en":"And indeed he is, in love of wealth, intense.","id":"dan sesungguhnya cintanya kepada harta benar-benar berlebihan.","latinEn":"Wa-innahu lihubbi alkhayri lashadeed","latinId":"Wa innahū liḥubbil-khairi lasyadīd(un).","words":[{"a":"وَإِنَّهُۥ","en":"And indeed he","id":"And indeed he","t":"wa-innahu"},{"a":"لِحُبِّ","en":"in (the) love","id":"in (the) love","t":"liḥubbi"},{"a":"ٱلْخَيْرِ","en":"(of) wealth","id":"(of) wealth","t":"l-khayri"},{"a":"لَشَدِيدٌ","en":"(is) surely intense","id":"(is) surely intense","t":"lashadīdun"}]},{"n":9,"key":"100:9","arabic":"۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ","page":600,"juz":30,"en":"But does he not know that when the contents of the graves are scattered","id":"Maka tidakkah dia mengetahui apabila apa yang di dalam kubur dikeluarkan,","latinEn":"Afala yaAAlamu itha buAAthira mafee alquboor","latinId":"Afalā ya‘lamu iżā bu‘ṡira mā fil-qubūr(i).","words":[{"a":"۞ أَفَلَا","en":"But does not","id":"But does not","t":"afalā"},{"a":"يَعْلَمُ","en":"he know","id":"he know","t":"yaʿlamu"},{"a":"إِذَا","en":"when","id":"when","t":"idhā"},{"a":"بُعْثِرَ","en":"will be scattered","id":"will be scattered","t":"buʿ'thira"},{"a":"مَا","en":"what","id":"what","t":"mā"},{"a":"فِى","en":"(is) in","id":"(is) in","t":"fī"},{"a":"ٱلْقُبُورِ","en":"the graves","id":"the graves","t":"l-qubūri"}]},{"n":10,"key":"100:10","arabic":"وَحُصِّلَ مَا فِى ٱلصُّدُورِ","page":600,"juz":30,"en":"And that within the breasts is obtained,","id":"dan apa yang tersimpan di dalam dada dikeluarkan?","latinEn":"Wahussila ma fee assudoor","latinId":"Wa ḥuṣṣila mā fiṣ-ṣudūr(i).","words":[{"a":"وَحُصِّلَ","en":"And is made apparent","id":"And is made apparent","t":"waḥuṣṣila"},{"a":"مَا","en":"what","id":"what","t":"mā"},{"a":"فِى","en":"(is) in","id":"(is) in","t":"fī"},{"a":"ٱلصُّدُورِ","en":"the breasts","id":"the breasts","t":"l-ṣudūri"}]},{"n":11,"key":"100:11","arabic":"إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍ لَّخَبِيرٌۢ","page":600,"juz":30,"en":"Indeed, their Lord with them, that Day, is [fully] Aware.","id":"sungguh, Tuhan mereka pada hari itu Mahateliti terhadap keadaan mereka.","latinEn":"Inna rabbahum bihim yawma-ithinlakhabeer","latinId":"Inna rabbahum bihim yauma'iżil lakhabīr(un).","words":[{"a":"إِنَّ","en":"Indeed","id":"Indeed","t":"inna"},{"a":"رَبَّهُم","en":"their Lord","id":"their Lord","t":"rabbahum"},{"a":"بِهِمْ","en":"about them","id":"about them","t":"bihim"},{"a":"يَوْمَئِذٍۢ","en":"that Day","id":"that Day","t":"yawma-idhin"},{"a":"لَّخَبِيرٌۢ","en":"(is) surely All-Aware","id":"(is) surely All-Aware","t":"lakhabīrun"}]}]}