{"version":2,"surah":109,"verses":[{"n":1,"key":"109:1","arabic":" قُلْ يَـٰٓأَيُّهَا ٱلْكَـٰفِرُونَ","page":603,"juz":30,"en":"Say, \"O disbelievers,","id":"Katakanlah (Muhammad), \"Wahai orang-orang kafir!","latinEn":"Qul ya ayyuha alkafiroon","latinId":"Qul yā ayyuhal-kāfirūn(a).","words":[{"a":"قُلْ","en":"Say","id":"Say","t":"qul"},{"a":"يَـٰٓأَيُّهَا","en":"O","id":"O","t":"yāayyuhā"},{"a":"ٱلْكَـٰفِرُونَ","en":"disbelievers","id":"disbelievers","t":"l-kāfirūna"}]},{"n":2,"key":"109:2","arabic":"لَآ أَعْبُدُ مَا تَعْبُدُونَ","page":603,"juz":30,"en":"I do not worship what you worship.","id":"aku tidak akan menyembah apa yang kamu sembah,","latinEn":"La aAAbudu ma taAAbudoon","latinId":"Lā a‘budu mā ta‘budūn(a).","words":[{"a":"لَآ","en":"Not","id":"Not","t":"lā"},{"a":"أَعْبُدُ","en":"I worship","id":"I worship","t":"aʿbudu"},{"a":"مَا","en":"what","id":"what","t":"mā"},{"a":"تَعْبُدُونَ","en":"you worship","id":"you worship","t":"taʿbudūna"}]},{"n":3,"key":"109:3","arabic":"وَلَآ أَنتُمْ عَـٰبِدُونَ مَآ أَعْبُدُ","page":603,"juz":30,"en":"Nor are you worshippers of what I worship.","id":"dan kamu bukan penyembah apa yang aku sembah,","latinEn":"Wala antum AAabidoona maaAAbud","latinId":"Wa lā antum ‘ābidūna mā a‘bud(u).","words":[{"a":"وَلَآ","en":"And not","id":"And not","t":"walā"},{"a":"أَنتُمْ","en":"you","id":"you","t":"antum"},{"a":"عَـٰبِدُونَ","en":"(are) worshippers","id":"(are) worshippers","t":"ʿābidūna"},{"a":"مَآ","en":"(of) what","id":"(of) what","t":"mā"},{"a":"أَعْبُدُ","en":"I worship","id":"I worship","t":"aʿbudu"}]},{"n":4,"key":"109:4","arabic":"وَلَآ أَنَا۠ عَابِدٌ مَّا عَبَدتُّمْ","page":603,"juz":30,"en":"Nor will I be a worshipper of what you worship.","id":"dan aku tidak pernah menjadi penyembah apa yang kamu sembah,","latinEn":"Wala ana AAabidun maAAabadtum","latinId":"Wa lā ana ‘ābidum mā ‘abattum.","words":[{"a":"وَلَآ","en":"And not","id":"And not","t":"walā"},{"a":"أَنَا۠","en":"I am","id":"I am","t":"anā"},{"a":"عَابِدٌۭ","en":"a worshipper","id":"a worshipper","t":"ʿābidun"},{"a":"مَّا","en":"(of) what","id":"(of) what","t":"mā"},{"a":"عَبَدتُّمْ","en":"you worship","id":"you worship","t":"ʿabadttum"}]},{"n":5,"key":"109:5","arabic":"وَلَآ أَنتُمْ عَـٰبِدُونَ مَآ أَعْبُدُ","page":603,"juz":30,"en":"Nor will you be worshippers of what I worship.","id":"dan kamu tidak pernah (pula) menjadi penyembah apa yang aku sembah.","latinEn":"Wala antum AAabidoona maaAAbud","latinId":"Wa lā antum ‘ābidūna mā a‘bud(u).","words":[{"a":"وَلَآ","en":"And not","id":"And not","t":"walā"},{"a":"أَنتُمْ","en":"you","id":"you","t":"antum"},{"a":"عَـٰبِدُونَ","en":"(are) worshippers","id":"(are) worshippers","t":"ʿābidūna"},{"a":"مَآ","en":"(of) what","id":"(of) what","t":"mā"},{"a":"أَعْبُدُ","en":"I worship","id":"I worship","t":"aʿbudu"}]},{"n":6,"key":"109:6","arabic":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ","page":603,"juz":30,"en":"For you is your religion, and for me is my religion.\"","id":"Untukmu agamamu, dan untukku agamaku.\"","latinEn":"Lakum deenukum waliya deen","latinId":"Lakum dīnukum wa liya dīn(i).","words":[{"a":"لَكُمْ","en":"For you","id":"For you","t":"lakum"},{"a":"دِينُكُمْ","en":"(is) your religion","id":"(is) your religion","t":"dīnukum"},{"a":"وَلِىَ","en":"and for me","id":"and for me","t":"waliya"},{"a":"دِينِ","en":"(is) my religion","id":"(is) my religion","t":"dīni"}]}]}