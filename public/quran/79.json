{"version":2,"surah":79,"verses":[{"n":1,"key":"79:1","arabic":" وَٱلنَّـٰزِعَـٰتِ غَرْقًا","page":583,"juz":30,"en":"By those [angels] who extract with violence","id":"Demi (malaikat) yang mencabut (nyawa) dengan keras.","latinEn":"WannaziAAati gharqa","latinId":"Wan-nāzi‘āti garqā(n).","words":[{"a":"وَٱلنَّـٰزِعَـٰتِ","en":"By those who extract","id":"By those who extract","t":"wal-nāziʿāti"},{"a":"غَرْقًۭا","en":"violently","id":"violently","t":"gharqan"}]},{"n":2,"key":"79:2","arabic":"وَٱلنَّـٰشِطَـٰتِ نَشْطًا","page":583,"juz":30,"en":"And [by] those who remove with ease","id":"Demi (malaikat) yang mencabut (nyawa) dengan lemah lembut.","latinEn":"Wannashitati nashta","latinId":"Wan-nāsyiṭāti nasyṭā(n).","words":[{"a":"وَٱلنَّـٰشِطَـٰتِ","en":"And those who draw out","id":"And those who draw out","t":"wal-nāshiṭāti"},{"a":"نَشْطًۭا","en":"gently","id":"gently","t":"nashṭan"}]},{"n":3,"key":"79:3","arabic":"وَٱلسَّـٰبِحَـٰتِ سَبْحًا","page":583,"juz":30,"en":"And [by] those who glide [as if] swimming","id":"Demi (malaikat) yang turun dari langit dengan cepat,","latinEn":"Wassabihati sabha","latinId":"Was-sābiḥāti sabḥā(n).","words":[{"a":"وَٱلسَّـٰبِحَـٰتِ","en":"And those who glide","id":"And those who glide","t":"wal-sābiḥāti"},{"a":"سَبْحًۭا","en":"swimming","id":"swimming","t":"sabḥan"}]},{"n":4,"key":"79:4","arabic":"فَٱلسَّـٰبِقَـٰتِ سَبْقًا","page":583,"juz":30,"en":"And those who race each other in a race","id":"dan (malaikat) yang mendahului dengan kencang,","latinEn":"Fassabiqati sabqa","latinId":"Fas-sābiqāti sabqā(n).","words":[{"a":"فَٱلسَّـٰبِقَـٰتِ","en":"And those who race each other","id":"And those who race each other","t":"fal-sābiqāti"},{"a":"سَبْقًۭا","en":"(in) a race","id":"(in) a race","t":"sabqan"}]},{"n":5,"key":"79:5","arabic":"فَٱلْمُدَبِّرَٰتِ أَمْرًا","page":583,"juz":30,"en":"And those who arrange [each] matter,","id":"dan (malaikat) yang mengatur urusan (dunia).","latinEn":"Falmudabbirati amra","latinId":"Fal-mudabbirāti amrā(n).","words":[{"a":"فَٱلْمُدَبِّرَٰتِ","en":"And those who arrange","id":"And those who arrange","t":"fal-mudabirāti"},{"a":"أَمْرًۭا","en":"(the) matter","id":"(the) matter","t":"amran"}]},{"n":6,"key":"79:6","arabic":"يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ","page":583,"juz":30,"en":"On the Day the blast [of the Horn] will convulse [creation],","id":"(Sungguh, kamu akan dibangkitkan) pada hari ketika tiupan pertama mengguncangkan alam,","latinEn":"Yawma tarjufu arrajifa","latinId":"Yauma tarjufur-rājifah(tu).","words":[{"a":"يَوْمَ","en":"(The) Day","id":"(The) Day","t":"yawma"},{"a":"تَرْجُفُ","en":"will quake","id":"will quake","t":"tarjufu"},{"a":"ٱلرَّاجِفَةُ","en":"the quaking one","id":"the quaking one","t":"l-rājifatu"}]},{"n":7,"key":"79:7","arabic":"تَتْبَعُهَا ٱلرَّادِفَةُ","page":583,"juz":30,"en":"There will follow it the subsequent [one].","id":"(tiupan pertama) itu diiringi oleh tiupan kedua.","latinEn":"TatbaAAuha arradifa","latinId":"Tatba‘uhar-rādifah(tu).","words":[{"a":"تَتْبَعُهَا","en":"Follows it","id":"Follows it","t":"tatbaʿuhā"},{"a":"ٱلرَّادِفَةُ","en":"the subsequent","id":"the subsequent","t":"l-rādifatu"}]},{"n":8,"key":"79:8","arabic":"قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌ","page":583,"juz":30,"en":"Hearts, that Day, will tremble,","id":"Hati manusia pada waktu itu merasa sangat takut,","latinEn":"Quloobun yawma-ithin wajifa","latinId":"Qulūbuy yauma'iżiw wājifah(tun).","words":[{"a":"قُلُوبٌۭ","en":"Hearts","id":"Hearts","t":"qulūbun"},{"a":"يَوْمَئِذٍۢ","en":"that Day","id":"that Day","t":"yawma-idhin"},{"a":"وَاجِفَةٌ","en":"will palpitate","id":"will palpitate","t":"wājifatun"}]},{"n":9,"key":"79:9","arabic":"أَبْصَـٰرُهَا خَـٰشِعَةٌ","page":583,"juz":30,"en":"Their eyes humbled.","id":"pandangannya tunduk.","latinEn":"Absaruha khashiAAa","latinId":"Abṣāruhā khāsyi‘ah(tun).","words":[{"a":"أَبْصَـٰرُهَا","en":"Their eyes","id":"Their eyes","t":"abṣāruhā"},{"a":"خَـٰشِعَةٌۭ","en":"humbled","id":"humbled","t":"khāshiʿatun"}]},{"n":10,"key":"79:10","arabi