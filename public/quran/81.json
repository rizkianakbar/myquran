{"version":2,"surah":81,"verses":[{"n":1,"key":"81:1","arabic":" إِذَا ٱلشَّمْسُ كُوِّرَتْ","page":586,"juz":30,"en":"When the sun is wrapped up [in darkness]","id":"Apabila matahari digulung,","latinEn":"Itha ashshamsu kuwwirat","latinId":"Iżasy-syamsu kuwwirat.","words":[{"a":"إِذَا","en":"When","id":"When","t":"idhā"},{"a":"ٱلشَّمْسُ","en":"the sun","id":"the sun","t":"l-shamsu"},{"a":"كُوِّرَتْ","en":"is wrapped up","id":"is wrapped up","t":"kuwwirat"}]},{"n":2,"key":"81:2","arabic":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ","page":586,"juz":30,"en":"And when the stars fall, dispersing,","id":"dan apabila bintang-bintang berjatuhan,","latinEn":"Wa-itha annujoomu inkadarat","latinId":"Wa iżan-nujūmunkadarat.","words":[{"a":"وَإِذَا","en":"And when","id":"And when","t":"wa-idhā"},{"a":"ٱلنُّجُومُ","en":"the stars","id":"the stars","t":"l-nujūmu"},{"a":"ٱنكَدَرَتْ","en":"fall, losing their luster","id":"fall, losing their luster","t":"inkadarat"}]},{"n":3,"key":"81:3","arabic":"وَإِذَا ٱلْجِبَالُ سُيِّرَتْ","page":586,"juz":30,"en":"And when the mountains are removed","id":"dan apabila gunung-gunung dihancurkan,","latinEn":"Wa-itha aljibalu suyyirat","latinId":"Wa iżal-jibālu suyyirat.","words":[{"a":"وَإِذَا","en":"And when","id":"And when","t":"wa-idhā"},{"a":"ٱلْجِبَالُ","en":"the mountains","id":"the mountains","t":"l-jibālu"},{"a":"سُيِّرَتْ","en":"are moved away","id":"are moved away","t":"suyyirat"}]},{"n":4,"key":"81:4","arabic":"وَإِذَا ٱلْعِشَارُ عُطِّلَتْ","page":586,"juz":30,"en":"And when full-term she-camels are neglected","id":"dan apabila unta-unta yang bunting ditinggalkan (tidak terurus),","latinEn":"Wa-itha alAAisharu AAuttilat","latinId":"Wa iżal-‘isyāru ‘uṭṭilat.","words":[{"a":"وَإِذَا","en":"And when","id":"And when","t":"wa-idhā"},{"a":"ٱلْعِشَارُ","en":"the full-term she-camels","id":"the full-term she-camels","t":"l-ʿishāru"},{"a":"عُطِّلَتْ","en":"(are) left untended","id":"(are) left untended","t":"ʿuṭṭilat"}]},{"n":5,"key":"81:5","arabic":"وَإِذَا ٱلْوُحُوشُ حُشِرَتْ","page":586,"juz":30,"en":"And when the wild beasts are gathered","id":"dan apabila binatang-binatang liar dikumpulkan,","latinEn":"Wa-itha alwuhooshu hushirat","latinId":"Wa iżal-wuḥūsy ḥusyirat.","words":[{"a":"وَإِذَا","en":"And when","id":"And when","t":"wa-idhā"},{"a":"ٱلْوُحُوشُ","en":"the wild beasts","id":"the wild beasts","t":"l-wuḥūshu"},{"a":"حُشِرَتْ","en":"are gathered","id":"are gathered","t":"ḥushirat"}]},{"n":6,"key":"81:6","arabic":"وَإِذَا ٱلْبِحَارُ سُجِّرَتْ","page":586,"juz":30,"en":"And when the seas are filled with flame","id":"dan apabila lautan dipanaskan,","latinEn":"Wa-itha albiharu sujjirat","latinId":"Wa iżal-biḥāru sujjirat.","words":[{"a":"وَإِذَا","en":"And when","id":"And when","t":"wa-idhā"},{"a":"ٱلْبِحَارُ","en":"the seas","id":"the seas","t":"l-biḥāru"},{"a":"سُجِّرَتْ","en":"are made to overflow","id":"are made to overflow","t":"sujjirat"}]},{"n":7,"key":"81:7","arabic":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ","page":586,"juz":30,"en":"And when the souls are paired","id":"dan apabila roh-roh dipertemukan (dengan tubuh),","latinEn":"Wa-itha annufoosu zuwwijat","latinId":"Wa iżan-nufūsu zuwwijat.","words":[{"a":"وَإِذَا","en":"And when","id":"And when","t":"wa-idhā"},{"a":"ٱلنُّفُوسُ","en":"the souls","id":"the souls","t":"l-nufūsu"},{"a":"زُوِّجَتْ","en":"are paired","id":"are paired","t":"zuwwijat"}]},{"n":8,"key":"81:8","arabic":"وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ","page":586,"juz":30,"en":"And when the girl [who was] buried alive is asked","id":"dan apabila bayi-bayi perempuan yang dikubur hidup-hidup ditanya,","latinEn":"Wa-itha almawoodatu su-ilat","latinId":"Wa iżal-mau'ūdatu su'ilat.","words":[{"a":"وَإِذَا","en":"And when","id":"And when","t":"wa-idhā"},{"a":"ٱلْمَوْءُۥدَةُ","en":"the female infant buried alive","id":"the female infant buried alive","t":"l-mawūdatu"},{"a":"سُئِلَتْ","en":"is asked","id":"is asked","t":"su-ilat"}]},{"n":9,"key":"81:9","arabic":"بِأَىِّ ذَنۢبٍ قُتِلَتْ","page":586,"juz":30,"en":"For