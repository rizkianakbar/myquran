[{"a":"وَإِذَا","en":"And when","id":"And when","t":"wa-idhā"},{"a":"ٱلْجَنَّةُ","en":"Paradise","id":"Paradise","t":"l-janatu"},{"a":"أُزْلِفَتْ","en":"is brought near","id":"is brought near","t":"uz'lifat"}]},{"n":14,"key":"81:14","arabic":"عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ","page":586,"juz":30,"en":"A soul will [then] know what it has brought [with it].","id":"setiap jiwa akan mengetahui apa yang telah dikerjakannya.","latinEn":"AAalimat nafsun ma ahdarat","latinId":"‘Alimat nafsum mā aḥḍarat.","words":[{"a":"عَلِمَتْ","en":"Will know","id":"Will know","t":"ʿalimat"},{"a":"نَفْسٌۭ","en":"a soul","id":"a soul","t":"nafsun"},{"a":"مَّآ","en":"what","id":"what","t":"mā"},{"a":"أَحْضَرَتْ","en":"it has brought","id":"it has brought","t":"aḥḍarat"}]},{"n":15,"key":"81:15","arabic":"فَلَآ أُقْسِمُ بِٱلْخُنَّسِ","page":586,"juz":30,"en":"So I swear by the retreating stars -","id":"Aku bersumpah demi bintang-bintang,","latinEn":"Fala oqsimu bilkhunnas","latinId":"Falā uqsimu bil-khunnas(i).","words":[{"a":"فَلَآ","en":"But nay","id":"But nay","t":"falā"},{"a":"أُقْسِمُ","en":"I swear","id":"I swear","t":"uq'simu"},{"a":"بِٱلْخُنَّسِ","en":"by the retreating planets","id":"by the retreating planets","t":"bil-khunasi"}]},{"n":16,"key":"81:16","arabic":"ٱلْجَوَارِ ٱلْكُنَّسِ","page":586,"juz":30,"en":"Those that run [their courses] and disappear [i.e., set]","id":"yang beredar dan terbenam,","latinEn":"Aljawari alkunnas","latinId":"Al-jawāril-kunnas(i).","words":[{"a":"ٱلْجَوَارِ","en":"Those that run","id":"Those that run","t":"al-jawāri"},{"a":"ٱلْكُنَّسِ","en":"(and) disappear","id":"(and) disappear","t":"l-kunasi"}]},{"n":17,"key":"81:17","arabic":"وَٱلَّيْلِ إِذَا عَسْعَسَ","page":586,"juz":30,"en":"And by the night as it closes in","id":"demi malam apabila telah larut,","latinEn":"Wallayli itha AAasAAas","latinId":"Wal-laili iżā ‘as‘as(a).","words":[{"a":"وَٱلَّيْلِ","en":"And the night","id":"And the night","t":"wa-al-layli"},{"a":"إِذَا","en":"when","id":"when","t":"idhā"},{"a":"عَسْعَسَ","en":"it departs","id":"it departs","t":"ʿasʿasa"}]},{"n":18,"key":"81:18","arabic":"وَٱلصُّبْحِ إِذَا تَنَفَّسَ","page":586,"juz":30,"en":"And by the dawn when it breathes [i.e., stirs]","id":"dan demi subuh apabila telah menyinsing,","latinEn":"Wassubhi ithatanaffas","latinId":"Waṣ-ṣubḥi iżā tanaffas(a).","words":[{"a":"وَٱلصُّبْحِ","en":"And the dawn","id":"And the dawn","t":"wal-ṣub'ḥi"},{"a":"إِذَا","en":"when","id":"when","t":"idhā"},{"a":"تَنَفَّسَ","en":"it breathes","id":"it breathes","t":"tanaffasa"}]},{"n":19,"key":"81:19","arabic":"إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ","page":586,"juz":30,"en":"[That] indeed, it [i.e., the Qur’ān] is a word [conveyed by] a noble messenger [i.e., Gabriel]","id":"sesungguhnya (Alquran) itu benar-benar firman (Allah yang dibawa oleh) utusan yang mulia (Jibril),","latinEn":"Innahu laqawlu rasoolin kareem","latinId":"Innahū laqaulu rasūlin karīm(in).","words":[{"a":"إِنَّهُۥ","en":"Indeed, it","id":"Indeed, it","t":"innahu"},{"a":"لَقَوْلُ","en":"(is) surely a word","id":"(is) surely a word","t":"laqawlu"},{"a":"رَسُولٍۢ","en":"(of) a Messenger","id":"(of) a Messenger","t":"rasūlin"},{"a":"كَرِيمٍۢ","en":"noble","id":"noble","t":"karīmin"}]},{"n":20,"key":"81:20","arabic":"ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ","page":586,"juz":30,"en":"[Who is] possessed of power and with the Owner of the Throne, secure [in position],","id":"yang memiliki kekuatan, memiliki kedudukan tinggi di sisi (Allah) yang memiliki Arasy,","latinEn":"Thee quwwatin AAinda theealAAarshi makeen","latinId":"Żī quwwatin ‘inda żil-‘arsyi makīn(in).","words":[{"a":"ذِى","en":"Possessor of","id":"Possessor of","t":"dhī"},{"a":"قُوَّةٍ","en":"power","id":"power","t":"quwwatin"},{"a":"عِندَ","en":"with","id":"with","t":"ʿinda"},{"a":"ذِى","en":"(the) Owner of","id":"(the) Owner of","t":"dhī"},{"a":"ٱلْعَرْشِ","en":"the Throne","id":"the Throne","t":"l-ʿarshi"},{"a":"مَكِينٍۢ","en":"secure","id":"secure","t":"makīnin"}]},{"n":21,"key":"81:21","arabic":"مُّطَاعٍ ثَمَّ أَمِينٍ","page":586,"juz":30,"en":"Obeyed there [in the heavens] and trustworthy.","id":"yang di sana (di alam malaikat) ditaati dan dipercaya.","latinEn":"MutaAAin thamma ameen","latinId":"Muṭā‘in ṡamma amīn(in).","words":[{"a":"مُّطَاعٍۢ","en":"One to be obeyed","id":"One to be obeyed","t":"muṭāʿin"},{"a":"ثَمَّ","en":"and","id":"and","t":"thamma"},{"a":"أَمِينٍۢ","en":"trustworthy","id":"trustworthy","t":"amīnin"}]},{"n":22,"key":"81:22","arabic":"وَمَا صَاحِبُكُم بِمَجْنُونٍ","page":586,"juz":30,"en":"And your companion [i.e., Prophet Muḥammad (ﷺ) ] is not [at all] mad.","id":"Dan temanmu (Muhammad) itu bukanlah orang gila.","latinEn":"Wama sahibukum bimajnoon","latinId":"Wa mā ṣāḥibukum bimajnūn(in).","words":[{"a":"وَمَا","en":"And not","id":"And not","t":"wamā"},{"a":"صَاحِبُكُم","en":"(is) your companion","id":"(is) your companion","t":"ṣāḥibukum"},{"a":"بِمَجْنُونٍۢ","en":"mad","id":"mad","t":"bimajnūnin"}]},{"n":23,"key":"81:23","arabic":"وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ","page":586,"juz":30,"en":"And he has already seen him [i.e., Gabriel] in the clear horizon.","id":"Dan sungguh, dia (Muhammad) telah melihatnya (Jibril) di ufuk yang terang.","latinEn":"Walaqad raahu bilofuqialmubeen","latinId":"Wa laqad ra'āhu bil-ufuqil-mubīn(i).","words":[{"a":"وَلَقَدْ","en":"And certainly","id":"And certainly","t":"walaqad"},{"a":"رَءَاهُ","en":"he saw him","id":"he saw him","t":"raāhu"},{"a":"بِٱلْأُفُقِ","en":"in the horizon","id":"in the horizon","t":"bil-ufuqi"},{"a":"ٱلْمُبِينِ","en":"the clear","id":"the clear","t":"l-mubīni"}]},{"n":24,"key":"81:24","arabic":"وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍ","page":586,"juz":30,"en":"And he [i.e., Muḥammad (ﷺ)] is not a withholder of [knowledge of] the unseen.","id":"Dan Dia (Muhammad) bukanlah seorang yang kikir (enggan) untuk menerangkan yang gaib.","latinEn":"Wama huwa AAala alghaybi bidaneen","latinId":"Wa mā huwa ‘alal-gaibi biḍanīn(in).","words":[{"a":"وَمَا","en":"And not","id":"And not","t":"wamā"},{"a":"هُوَ","en":"he (is)","id":"he (is)","t":"huwa"},{"a":"عَلَى","en":"on","id":"on","t":"ʿalā"},{"a":"ٱلْغَيْبِ","en":"the unseen","id":"the unseen","t":"l-ghaybi"},{"a":"بِضَنِينٍۢ","en":"a withholder","id":"a withholder","t":"biḍanīnin"}]},{"n":25,"key":"81:25","arabic":"وَمَا هُوَ بِقَوْلِ شَيْطَـٰنٍ رَّجِيمٍ","page":586,"juz":30,"en":"And it [i.e., the Qur’ān] is not the word of a devil, expelled [from the heavens].","id":"Dan (Alquran) itu bukanlah perkataan setan yang terkutuk,","latinEn":"Wama huwa biqawli shaytaninrajeem","latinId":"Wa mā huwa biqauli syaiṭānir rajīm(in).","words":[{"a":"وَمَا","en":"And not","id":"And not","t":"wamā"},{"a":"هُوَ","en":"it","id":"it","t":"huwa"},{"a":"بِقَوْلِ","en":"(is the) word","id":"(is the) word","t":"biqawli"},{"a":"شَيْطَـٰنٍۢ","en":"(of) Shaitaan","id":"(of) Shaitaan","t":"shayṭānin"},{"a":"رَّجِيمٍۢ","en":"accursed","id":"accursed","t":"rajīmin"}]},{"n":26,"key":"81:26","arabic":"فَأَيْنَ تَذْهَبُونَ","page":586,"juz":30,"en":"So where are you going?","id":"maka ke manakah kamu akan pergi?","latinEn":"Faayna tathhaboon","latinId":"Fa aina tażhabūn(a).","words":[{"a":"فَأَيْنَ","en":"So where","id":"So where","t":"fa-ayna"},{"a":"تَذْهَبُونَ","en":"are you going","id":"are you going","t":"tadhhabūna"}]},{"n":27,"key":"81:27","arabic":"إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَـٰلَمِينَ","page":586,"juz":30,"en":"It is not except a reminder to the worlds","id":"(Alquran) itu tidak lain adalah peringatan bagi seluruh alam,","latinEn":"In huwa illa thikrun lilAAalameen","latinId":"In huwa illā żikrul lil-‘ālamīn(a).","words":[{"a":"إِنْ","en":"Not","id":"Not","t":"in"},{"a":"هُوَ","en":"it","id":"it","t":"huwa"},{"a":"إِلَّا","en":"(is) except","id":"(is) except","t":"illā"},{"a":"ذِكْرٌۭ","en":"a reminder","id":"a reminder","t":"dhik'run"},{"a":"لِّلْعَـٰلَمِينَ","en":"to the worlds","id":"to the worlds","t":"lil'ʿālamīna"}]},{"n":28,"key":"81:28","arabic":"لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ","page":586,"juz":30,"en":"For whoever wills among you to take a right course.","id":"(yaitu) bagi siapa di antara kamu yang menghendaki menempuh jalan yang lurus.","latinEn":"Liman shaa minkum an yastaqeem","latinId":"Liman syā'a minkum ay yastaqīm(a).","words":[{"a":"لِمَن","en":"For whoever","id":"For whoever","t":"liman"},{"a":"شَآءَ","en":"wills","id":"wills","t":"shāa"},{"a":"مِنكُمْ","en":"among you","id":"among you","t":"minkum"},{"a":"أَن","en":"to","id":"to","t":"an"},{"a":"يَسْتَقِيمَ","en":"take a straight way","id":"take a straight way","t":"yastaqīma"}]},{"n":29,"key":"81:29","arabic":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَـٰلَمِينَ","page":586,"juz":30,"en":"And you do not will except that Allāh wills - Lord of the worlds.","id":"Dan kamu tidak dapat menghendaki (menempuh jalan itu) kecuali apabila dikehendaki Allah, Tuhan seluruh alam.","latinEn":"Wama tashaoona illa anyashaa Allahu rabbu alAAalameen","latinId":"Wa mā tasyā'ūna illā ay yasyā'allāhu rabbul-‘ālamīn(a).","words":[{"a":"وَمَا","en":"And not","id":"And not","t":"wamā"},{"a":"تَشَآءُونَ","en":"you will","id":"you will","t":"tashāūna"},{"a":"إِلَّآ","en":"except","id":"except","t":"illā"},{"a":"أَن","en":"that","id":"that","t":"an"},{"a":"يَشَآءَ","en":"wills","id":"wills","t":"yashāa"},{"a":"ٱللَّهُ","en":"Allah","id":"Allah","t":"l-lahu"},{"a":"رَبُّ","en":"Lord","id":"Lord","t":"rabbu"},{"a":"ٱلْعَـٰلَمِينَ","en":"(of) the worlds","id":"(of) the worlds","t":"l-ʿālamīna"}]}]}