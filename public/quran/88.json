{"version":2,"surah":88,"verses":[{"n":1,"key":"88:1","arabic":" هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَـٰشِيَةِ","page":592,"juz":30,"en":"Has there reached you the report of the Overwhelming [event]?","id":"Sudahkah sampai kepadamu berita tentang (hari Kiamat)?","latinEn":"Hal ataka hadeethu alghashiyat","latinId":"Hal atāka ḥadīṡul-gāsyiyah(ti).","words":[{"a":"هَلْ","en":"Has","id":"Has","t":"hal"},{"a":"أَتَىٰكَ","en":"(there) come to you","id":"(there) come to you","t":"atāka"},{"a":"حَدِيثُ","en":"(the) news","id":"(the) news","t":"ḥadīthu"},{"a":"ٱلْغَـٰشِيَةِ","en":"(of) the Overwhelming","id":"(of) the Overwhelming","t":"l-ghāshiyati"}]},{"n":2,"key":"88:2","arabic":"وُجُوهٌ يَوْمَئِذٍ خَـٰشِعَةٌ","page":592,"juz":30,"en":"[Some] faces, that Day, will be humbled,","id":"Pada hari itu banyak wajah yang tertunduk hina,","latinEn":"Wujoohun yawma-ithin khashiAAa","latinId":"Wujūhuy yauma'iżin khāsyi‘ah(tun).","words":[{"a":"وُجُوهٌۭ","en":"Faces","id":"Faces","t":"wujūhun"},{"a":"يَوْمَئِذٍ","en":"that Day","id":"that Day","t":"yawma-idhin"},{"a":"خَـٰشِعَةٌ","en":"(will be) humbled","id":"(will be) humbled","t":"khāshiʿatun"}]},{"n":3,"key":"88:3","arabic":"عَامِلَةٌ نَّاصِبَةٌ","page":592,"juz":30,"en":"Working [hard] and exhausted.","id":"(karena) bekerja keras lagi kepayahan,","latinEn":"AAamilatun nasiba","latinId":"‘Amilatun nāṣibah(tun).","words":[{"a":"عَامِلَةٌۭ","en":"Laboring","id":"Laboring","t":"ʿāmilatun"},{"a":"نَّاصِبَةٌۭ","en":"exhausted","id":"exhausted","t":"nāṣibatun"}]},{"n":4,"key":"88:4","arabic":"تَصْلَىٰ نَارًا حَامِيَةً","page":592,"juz":30,"en":"They will [enter to] burn in an intensely hot Fire.","id":"mereka memasuki api yang sangat panas (neraka),","latinEn":"Tasla naran hamiya","latinId":"Taṣlā nāran ḥāmiyah(tan).","words":[{"a":"تَصْلَىٰ","en":"They will burn","id":"They will burn","t":"taṣlā"},{"a":"نَارًا","en":"(in) a Fire","id":"(in) a Fire","t":"nāran"},{"a":"حَامِيَةًۭ","en":"intensely hot","id":"intensely hot","t":"ḥāmiyatan"}]},{"n":5,"key":"88:5","arabic":"تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍ","page":592,"juz":30,"en":"They will be given drink from a boiling spring.","id":"diberi minum dari sumber mata air yang sangat panas.","latinEn":"Tusqa min AAaynin aniya","latinId":"Tusqā min ‘ainin āniyah(tin).","words":[{"a":"تُسْقَىٰ","en":"They will be given to drink","id":"They will be given to drink","t":"tus'qā"},{"a":"مِنْ","en":"from","id":"from","t":"min"},{"a":"عَيْنٍ","en":"a spring","id":"a spring","t":"ʿaynin"},{"a":"ءَانِيَةٍۢ","en":"boiling","id":"boiling","t":"āniyatin"}]},{"n":6,"key":"88:6","arabic":"لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍ","page":592,"juz":30,"en":"For them there will be no food except from a poisonous, thorny plant","id":"Tidak ada makanan bagi mereka selain dari pohon yang berduri,","latinEn":"Laysa lahum taAAamun illamin dareeAA","latinId":"Laisa lahum ṭa‘āmun illā min ḍarī‘(in).","words":[{"a":"لَّيْسَ","en":"Not is","id":"Not is","t":"laysa"},{"a":"لَهُمْ","en":"for them","id":"for them","t":"lahum"},{"a":"طَعَامٌ","en":"food","id":"food","t":"ṭaʿāmun"},{"a":"إِلَّا","en":"except","id":"except","t":"illā"},{"a":"مِن","en":"from","id":"from","t":"min"},{"a":"ضَرِيعٍۢ","en":"a bitter thorny plant","id":"a bitter thorny plant","t":"ḍarīʿin"}]},{"n":7,"key":"88:7","arabic":"لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍ","page":592,"juz":30,"en":"Which neither nourishes nor avails against hunger.","id":"yang tidak menggemukkan dan tidak menghilangkan lapar.","latinEn":"La yusminu wala yughnee minjooAA","latinId":"Lā yusminu wa lā yugnī min jū‘(in).","words":[{"a":"لَّا","en":"Not","id":"Not","t":"lā"},{"a":"يُسْمِنُ","en":"it nourishes","id":"it nourishes","t":"yus'minu"},{"a":"وَلَا","en":"and not","id":"and not","t":"walā"},{"a":"يُغْنِى","en":"it avails","id":"it avails","t":"yugh'nī"},{"a":"مِن","en":"from","id":"from","t":"min"},{"a":"جُوعٍۢ","en":"hunger","id":"hunger","t":"jūʿin"}]},{"n":8,"key":"88:8","arabic":"وُجُوهٌ يَوْمَئِذٍ نَّاعِمَةٌ","page":592,"juz":30,"en":"[Other] faces, that Day, will show pleasure.","id":"Pada hari itu banyak (pula) wajah yang berseri-seri,","latinEn":"Wujoohun yawma-ithin naAAima","latinId":"Wujūhuy yauma'iżin nā‘imah(tun).","words":[{"a":"وُجُوهٌۭ","en":"Faces","id":"Faces","t":"wujūhun"},{"a":"يَوْمَئِذٍۢ","en":"that Day","id":"that Day","t":"yawma-idhin"},{"a":"نَّاعِمَةٌۭ","en":"(will be) joyful","id":"(will be) joyful","t":"nāʿimatun"}]},{"n":9,"key":"88:9","arabic":"لِّسَعْيِهَا رَاضِيَةٌ","page":592,"juz":30,"en":"With their effort [they are] satisfied","id":"merasa senang karena usahanya (sendiri),","latinEn":"LisaAAyiha radiya","latinId":"Lisa‘yihā rāḍiyah(tun).","words":[{"a":"لِّسَعْيِهَا","en":"With their effort","id":"With their effort","t":"lisaʿyihā"},{"a":"رَاضِيَةٌۭ","en":"satisfied","id":"satisfied","t":"rāḍiyatun"}]},{"n":10,"key":"88:10","arabic":"فِى جَنَّةٍ عَالِيَةٍ","page":592,"juz":30,"en":"In an elevated garden,","id":"(mereka) dalam surga yang tinggi,","latinEn":"Fee jannatin AAaliya","latinId":"Fī jannatin ‘āliyah(tin).","words":[{"a":"فِى","en":"In","id":"In","t":"fī"},{"a":"جَنَّةٍ","en":"a garden","id":"a garden","t":"jannatin"},{"a":"عَالِيَةٍۢ","en":"elevated","id":"elevated","t":"ʿāliyatin"}]},{"n":11,"key":"88:11","arabic":"لَّا تَسْمَعُ فِيهَا لَـٰغِيَةً","page":592,"juz":30,"en":"Wherein they will hear no unsuitable speech.","id":"di sana (kamu) tidak mendengar perkataan yang tidak berguna.","latinEn":"La tasmaAAu feeha laghiya","latinId":"Lā tasama‘u fīhā lāgiyah(tan).","words":[{"a":"لَّا","en":"Not","id":"Not","t":"lā"},{"a":"تَسْمَعُ","en":"they will hear","id":"they will hear","t":"tasmaʿu"},{"a":"فِيهَا","en":"therein","id":"therein","t":"fīhā"},{"a":"لَـٰغِيَةًۭ","en":"vain talk","id":"vain talk","t":"lāghiyatan"}]},{"n":12,"key":"88:12","arabic":"فِيهَا عَيْنٌ جَارِيَةٌ","page":592,"juz":30,"en":"Within it is a flowing spring.","id":"Di sana ada mata air yang mengalir.","latinEn":"Feeha AAaynun jariya","latinId":"Fīhā ‘ainun jāriyah(tun).","words":[{"a":"فِيهَا","en":"Therein","id":"Therein","t":"fīhā"},{"a":"عَيْنٌۭ","en":"(will be) a spring","id":"(will be) a spring","t":"ʿaynun"},{"a":"جَارِيَةٌۭ","en":"flowing","id":"flowing","t":"jāriyatun"}]},{"n":13,"key":"88:13","arabic":"فِيهَا سُرُرٌ مَّرْفُوعَةٌ","page":592,"juz":30,"en":"Within it are couches raised high","id":"Di sana ada dipan-dipan yang ditinggikan,","latinEn":"Feeha sururun marfooAAa","latinId":"Fīhā sururum marfū‘ah(tun).","words":[{"a":"فِيهَا","en":"Therein","id":"Therein","t":"fīhā"},{"a":"سُرُرٌۭ","en":"(will be) thrones","id":"(will be) thrones","t":"sururun"},{"a":"مَّرْفُوعَةٌۭ","en":"raised high","id":"raised high","t":"marfūʿatun"}]},{"n":14,"key":"88:14","arabic":"وَأَكْوَابٌ مَّوْضُوعَةٌ","page":592,"juz":30,"en":"And cups put in place","id":"dan gelas-gelas yang tersedia (di dekatnya),","latinEn":"Waakwabun mawdooAAa","latinId":"Wa akwābum mauḍū‘ah(tun).","words":[{"a":"وَأَكْوَابٌۭ","en":"And cups","id":"And cups","t":"wa-akwābun"},{"a":"مَّوْضُوعَةٌۭ","en":"put in place","id":"put in place","t":"mawḍūʿatun"}]},{"n":15,"key":"88:15","arabic":"وَنَمَارِقُ مَصْفُوفَةٌ","page":592,"juz":30,"en":"And cushions lined up","id":"dan bantal-bantal sandaran yang tersusun,","latinEn":"Wanamariqu masfoofa","latinId":"Wa namāriqu maṣfūfah(tun).","words":[{"a":"وَنَمَارِقُ","en":"And cushions","id":"And cushions","t":"wanamāriqu"},{"a":"مَصْفُوفَةٌۭ","en":"lined up","id":"lined up","t":"maṣfūfatun"}]},{"n":16,"key":"88:16","arabic":"وَزَرَابِىُّ مَبْثُوثَةٌ","page":592,"juz":30,"en":"And carpets spread around.","id":"dan permadani-permadani yang terhampar.","latinEn":"Wazarabiyyu mabthootha","latinId":"Wa zarābiyyu mabṡūṡah(tun).","words":[{"a":"وَزَرَابِىُّ","en":"And carpets","id":"And carpets","t":"wazarābiyyu"},{"a":"مَبْثُوثَةٌ","en":"spread out","id":"spread out","t":"mabthūthatun"}]},{"n":17,"key":"88:17","arabic":"أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ","page":592,"juz":30,"en":"Then do they not look at the camels - how they are created?","id":"Maka tidakkah mereka memperhatikan unta, bagaimana diciptakan?","latinEn":"Afala yanthuroona ilaal-ibili kayfa khuliqat","latinId":"Afalā yanẓurūna ilal-ibili kaifa khuliqat.","words":[{"a":"أَفَلَا","en":"Then do not","id":"Then do not","t":"afalā"},{"a":"يَنظُرُونَ","en":"they look","id":"they look","t":"yanẓurūna"},{"a":"إِلَى","en":"towards","id":"towards","t":"ilā"},{"a":"ٱلْإِبِلِ","en":"the camels","id":"the camels","t":"l-ibili"},{"a":"كَيْفَ","en":"how","id":"how","t":"kayfa"},{"a":"خُلِقَتْ","en":"they are created","id":"they are created","t":"khuliqat"}]},{"n":18,"key":"88:18","arabic":"وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ","page":592,"juz":30,"en":"And at the sky - how it is raised?","id":"Dan langit, bagaimana ditinggikan?","latinEn":"Wa-ila assama-i kayfarufiAAat","latinId":"Wa ilas-samā'i kaifa rufi‘at.","words":[{"a":"وَإِلَى","en":"And towards","id":"And towards","t":"wa-ilā"},{"a":"ٱلسَّمَآءِ","en":"the sky","id":"the sky","t":"l-samāi"},{"a":"كَيْفَ","en":"how","id":"how","t":"kayfa"},{"a":"رُفِعَتْ","en":"it is raised","id":"it is raised","t":"rufiʿat"}]},{"n":19,"key":"88:19","arabic":"وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ","page":592,"juz":30,"en":"And at the mountains - how they are erected?","id":"Dan gunung-gunung bagaimana ditegakkan?","latinEn":"Wa-ila aljibali kayfa nusibat","latinId":"Wa ilal-jibāli kaifa nuṣibat.","words":[{"a":"وَإِلَى","en":"And towards","id":"And towards","t":"wa-ilā"},{"a":"ٱلْجِبَالِ","en":"the mountains","id":"the mountains","t":"l-jibāli"},{"a":"كَيْفَ","en":"how","id":"how","t":"kayfa"},{"a":"نُصِبَتْ","en":"they are fixed","id":"they are fixed","t":"nuṣibat"}]},{"n":20,"key":"88:20","arabic":"وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ","page":592,"juz":30,"en":"And at the earth - how it is spread out?","id":"Dan bumi bagaimana dihamparkan?","latinEn":"Wa-ila al-ardi kayfa sutihat","latinId":"Wa ilal-arḍi kaifa suṭiḥat.","words":[{"a":"وَإِلَى","en":"And towards","id":"And towards","t":"wa-ilā"},{"a":"ٱلْأَرْضِ","en":"the earth","id":"the earth","t":"l-arḍi"},{"a":"كَيْفَ","en":"how","id":"how","t":"kayfa"},{"a":"سُطِحَتْ","en":"it is spread out","id":"it is spread out","t":"suṭiḥat"}]},{"n":21,"key":"88:21","arabic":"فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌ","page":592,"juz":30,"en":"So remind, [O Muḥammad]; you are only a reminder.","id":"Maka berilah peringatan, karena sesungguhnya engkau (Muhammad) hanyalah pemberi peringatan.","latinEn":"Fathakkir innama anta muthakkir","latinId":"Fa żakkir, innamā anta mużakkir(un).","words":[{"a":"فَذَكِّرْ","en":"So remind","id":"So remind","t":"fadhakkir"},{"a":"إِنَّمَآ","en":"only","id":"only","t":"innamā"},{"a":"أَنتَ","en":"you","id":"you","t":"anta"},{"a":"مُذَكِّرٌۭ","en":"(are) a reminder","id":"(are) a reminder","t":"mudhakkirun"}]},{"n":22,"key":"88:22","arabic":"لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ","page":592,"juz":30,"en":"You are not over them a controller.","id":"Engkau bukanlah orang yang berkuasa atas mereka,","latinEn":"Lasta AAalayhim bimusaytir","latinId":"Lasta ‘alaihim bimusaiṭir(in).","words":[{"a":"لَّسْتَ","en":"You are not","id":"You are not","t":"lasta"},{"a":"عَلَيْهِم","en":"over them","id":"over them","t":"ʿalayhim"},{"a":"بِمُصَيْطِرٍ","en":"a controller","id":"a controller","t":"bimuṣayṭirin"}]},{"n":23,"key":"88:23","arabic":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ","page":593,"juz":30,"en":"However, he who turns away and disbelieves","id":"kecuali (jika ada) orang yang berpaling dan kafir,","latinEn":"Illa man tawalla wakafar","latinId":"Illā man tawallā wa kafar(a).","words":[{"a":"إِلَّا","en":"But","id":"But","t":"illā"},{"a":"مَن","en":"whoever","id":"whoever","t":"man"},{"a":"تَوَلَّىٰ","en":"turns away","id":"turns away","t":"tawallā"},{"a":"وَكَفَرَ","en":"and disbelieves","id":"and disbelieves","t":"wakafara"}]},{"n":24,"key":"88:24","arabic":"فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ","page":593,"juz":30,"en":"Then Allāh will punish him with the greatest punishment.","id":"maka Allah akan mengazabnya dengan azab yang besar.","latinEn":"FayuAAaththibuhu Allahu alAAathabaal-akbar","latinId":"Fa yu‘ażżibuhullāhul-‘ażābal-akbar(a).","words":[{"a":"فَيُعَذِّبُهُ","en":"Then will punish him","id":"Then will punish him","t":"fayuʿadhibuhu"},{"a":"ٱللَّهُ","en":"Allah","id":"Allah","t":"l-lahu"},{"a":"ٱلْعَذَابَ","en":"(with) the punishment","id":"(with) the punishment","t":"l-ʿadhāba"},{"a":"ٱلْأَكْبَرَ","en":"greatest","id":"greatest","t":"l-akbara"}]},{"n":25,"key":"88:25","arabic":"إِنَّ إِلَيْنَآ إِيَابَهُمْ","page":593,"juz":30,"en":"Indeed, to Us is their return.","id":"Sungguh, kepada Kami lah mereka kembali,","latinEn":"Inna ilayna iyabahum","latinId":"Inna ilainā iyābahum.","words":[{"a":"إِنَّ","en":"Indeed","id":"Indeed","t":"inna"},{"a":"إِلَيْنَآ","en":"to Us","id":"to Us","t":"ilaynā"},{"a":"إِيَابَهُمْ","en":"(will be) their return","id":"(will be) their return","t":"iyābahum"}]},{"n":26,"key":"88:26","arabic":"ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم","page":593,"juz":30,"en":"Then indeed, upon Us is their account.","id":"kemudian sesungguhnya (kewajiban) Kami lah membuat perhitungan atas mereka.","latinEn":"Thumma inna AAalayna hisabahum","latinId":"Ṡumma inna ‘alainā ḥisābahum.","words":[{"a":"ثُمَّ","en":"Then","id":"Then","t":"thumma"},{"a":"إِنَّ","en":"indeed","id":"indeed","t":"inna"},{"a":"عَلَيْنَا","en":"upon Us","id":"upon Us","t":"ʿalaynā"},{"a":"حِسَابَهُم","en":"(is) their account","id":"(is) their account","t":"ḥisābahum"}]}]}