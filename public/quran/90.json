{"version":2,"surah":90,"verses":[{"n":1,"key":"90:1","arabic":" لَآ أُقْسِمُ بِهَـٰذَا ٱلْبَلَدِ","page":594,"juz":30,"en":"I swear by this city [i.e., Makkah]","id":"Aku bersumpah dengan negeri ini (Mekkah),","latinEn":"La oqsimu bihatha albalad","latinId":"Lā uqsimu bihāżal-balad(i).","words":[{"a":"لَآ","en":"Nay","id":"Nay","t":"lā"},{"a":"أُقْسِمُ","en":"I swear","id":"I swear","t":"uq'simu"},{"a":"بِهَـٰذَا","en":"by this","id":"by this","t":"bihādhā"},{"a":"ٱلْبَلَدِ","en":"city","id":"city","t":"l-baladi"}]},{"n":2,"key":"90:2","arabic":"وَأَنتَ حِلٌّۢ بِهَـٰذَا ٱلْبَلَدِ","page":594,"juz":30,"en":"And you, [O Muḥammad], are free of restriction in this city","id":"dan engkau (Muhammad), bertempat di negeri (Mekkah) ini,","latinEn":"Waanta hillun bihatha albalad","latinId":"Wa anta ḥillum bihāżal-balad(i).","words":[{"a":"وَأَنتَ","en":"And you","id":"And you","t":"wa-anta"},{"a":"حِلٌّۢ","en":"(are) free (to dwell)","id":"(are) free (to dwell)","t":"ḥillun"},{"a":"بِهَـٰذَا","en":"in this","id":"in this","t":"bihādhā"},{"a":"ٱلْبَلَدِ","en":"city","id":"city","t":"l-baladi"}]},{"n":3,"key":"90:3","arabic":"وَوَالِدٍ وَمَا وَلَدَ","page":594,"juz":30,"en":"And [by] the father and that which was born [of him],","id":"dan demi (pertalian) bapak dan anaknya.","latinEn":"Wawalidin wama walad","latinId":"Wa wālidiw wa mā walad(a).","words":[{"a":"وَوَالِدٍۢ","en":"And the begetter","id":"And the begetter","t":"wawālidin"},{"a":"وَمَا","en":"and what","id":"and what","t":"wamā"},{"a":"وَلَدَ","en":"he begot","id":"he begot","t":"walada"}]},{"n":4,"key":"90:4","arabic":"لَقَدْ خَلَقْنَا ٱلْإِنسَـٰنَ فِى كَبَدٍ","page":594,"juz":30,"en":"We have certainly created man into hardship.","id":"Sungguh, Kami telah menciptakan manusia berada dalam susah payah.","latinEn":"Laqad khalaqna al-insana feekabad","latinId":"Laqad khalaqnal-insāna fī kabad(in).","words":[{"a":"لَقَدْ","en":"Certainly","id":"Certainly","t":"laqad"},{"a":"خَلَقْنَا","en":"We have created","id":"We have created","t":"khalaqnā"},{"a":"ٱلْإِنسَـٰنَ","en":"man","id":"man","t":"l-insāna"},{"a":"فِى","en":"(to be) in","id":"(to be) in","t":"fī"},{"a":"كَبَدٍ","en":"hardship","id":"hardship","t":"kabadin"}]},{"n":5,"key":"90:5","arabic":"أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌ","page":594,"juz":30,"en":"Does he think that never will anyone overcome him?","id":"Apakah dia (manusia) itu mengira bahwa tidak ada sesuatu pun yang berkuasa atasnya?","latinEn":"Ayahsabu an lan yaqdira AAalayhi ahad","latinId":"Ayaḥsabu allay yaqdira ‘alaihi  aḥad(un).","words":[{"a":"أَيَحْسَبُ","en":"Does he think","id":"Does he think","t":"ayaḥsabu"},{"a":"أَن","en":"that","id":"that","t":"an"},{"a":"لَّن","en":"not","id":"not","t":"lan"},{"a":"يَقْدِرَ","en":"has power","id":"has power","t":"yaqdira"},{"a":"عَلَيْهِ","en":"over him","id":"over him","t":"ʿalayhi"},{"a":"أَحَدٌۭ","en":"anyone","id":"anyone","t":"aḥadun"}]},{"n":6,"key":"90:6","arabic":"يَقُولُ أَهْلَكْتُ مَالًا لُّبَدًا","page":594,"juz":30,"en":"He says, \"I have spent wealth in abundance.\"","id":"Dia mengatakan, \"Aku telah menghabiskan harta yang banyak.\"","latinEn":"Yaqoolu ahlaktu malan lubada","latinId":"Yaqūlu ahlaktu mālal lubadā(n).","words":[{"a":"يَقُولُ","en":"He will say","id":"He will say","t":"yaqūlu"},{"a":"أَهْلَكْتُ","en":"I have squandered","id":"I have squandered","t":"ahlaktu"},{"a":"مَالًۭا","en":"wealth","id":"wealth","t":"mālan"},{"a":"لُّبَدًا","en":"abundant","id":"abundant","t":"lubadan"}]},{"n":7,"key":"90:7","arabic":"أَيَحْسَبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌ","page":594,"juz":30,"en":"Does he think that no one has seen him?","id":"Apakah dia mengira bahwa tidak ada sesuatu pun yang melihatnya?","latinEn":"Ayahsabu an lam yarahu ahad","latinId":"Ayaḥsabu allam yarahū aḥad(un).","words":[{"a":"أَيَحْسَبُ","en":"Does he think","id":"Does he think","t":"ayaḥsabu"},{"a":"أَن","en":"that","id":"that","t":"an"},{"a":"لَّمْ","en":"not","id":"not","t":"lam"},{"a":"يَرَهُۥٓ","en":"sees him","id":"sees him","t":"yarahu"},{"a":"أَحَدٌ","en":"anyone","id":"anyone","t":"aḥadun"}]},{"n":8,"key":"90:8","arabic":"أَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ","page":594,"juz":30,"en":"Have We not made for him two eyes?","id":"Bukankah Kami telah menjadikan untuknya sepasang mata,","latinEn":"Alam najAAal lahu AAaynayn","latinId":"Alam naj‘al lahū ‘ainain(i).","words":[{"a":"أَلَمْ","en":"Have not","id":"Have not","t":"alam"},{"a":"نَجْعَل","en":"We made","id":"We made","t":"najʿal"},{"a":"لَّهُۥ","en":"for him","id":"for him","t":"lahu"},{"a":"عَيْنَيْنِ","en":"two eyes","id":"two eyes","t":"ʿaynayni"}]},{"n":9,"key":"90:9","arabic":"وَلِسَانًا وَشَفَتَيْنِ","page":594,"juz":30,"en":"And a tongue and two lips?","id":"dan lidah dan sepasang bibir?","latinEn":"Walisanan washafatayn","latinId":"Wa lisānaw wa syafatain(i).","words":[{"a":"وَلِسَانًۭا","en":"And a tongue","id":"And a tongue","t":"walisānan"},{"a":"وَشَفَتَيْنِ","en":"and two lips","id":"and two lips","t":"washafatayni"}]},{"n":10,"key":"90:10","arabic":"وَهَدَيْنَـٰهُ ٱلنَّجْدَيْنِ","page":594,"juz":30,"en":"And have shown him the two ways?","id":"Dan Kami telah menunjukkan kepadanya dua jalan (kebajikkan dan kejahatan).","latinEn":"Wahadaynahu annajdayn","latinId":"Wa hadaināhun-najdain(i).","words":[{"a":"وَهَدَيْنَـٰهُ","en":"And shown him","id":"And shown him","t":"wahadaynāhu"},{"a":"ٱلنَّجْدَيْنِ","en":"the two ways","id":"the two ways","t":"l-najdayni"}]},{"n":11,"key":"90:11","arabic":"فَلَا ٱقْتَحَمَ ٱلْعَقَبَةَ","page":594,"juz":30,"en":"But he has not broken through the difficult pass.","id":"Tetapi dia tidak menempuh jalan yang mendaki dan sukar?","latinEn":"Fala iqtahama alAAaqaba","latinId":"Falaqtaḥamal-‘aqabah(ta).","words":[{"a":"فَلَا","en":"But not","id":"But not","t":"falā"},{"a":"ٱقْتَحَمَ","en":"he has attempted","id":"he has attempted","t":"iq'taḥama"},{"a":"ٱلْعَقَبَةَ","en":"the steep path","id":"the steep path","t":"l-ʿaqabata"}]},{"n":12,"key":"90:12","arabic":"وَمَآ أَدْرَىٰكَ مَا ٱلْعَقَبَةُ","page":594,"juz":30,"en":"And what can make you know what is [breaking through] the difficult pass?","id":"Dan tahukah kamu apakah jalan yang mendaki dan sukar itu?","latinEn":"Wama adraka maalAAaqaba","latinId":"Wa mā adrāka mal-‘aqabah(tu).","words":[{"a":"وَمَآ","en":"And what","id":"And what","t":"wamā"},{"a":"أَدْرَىٰكَ","en":"can make you know","id":"can make you know","t":"adrāka"},{"a":"مَا","en":"what","id":"what","t":"mā"},{"a":"ٱلْعَقَبَةُ","en":"the steep path (is)","id":"the steep path (is)","t":"l-ʿaqabatu"}]},{"n":13,"key":"90:13","arabic":"فَكُّ رَقَبَةٍ","page":594,"juz":30,"en":"It is the freeing of a slave","id":"(Yaitu) membebaskan budak (hamba sahaya),","latinEn":"Fakku raqaba","latinId":"Fakku raqabah(tin).","words":[{"a":"فَكُّ","en":"(It is) freeing","id":"(It is) freeing","t":"fakku"},{"a":"رَقَبَةٍ","en":"a neck","id":"a neck","t":"raqabatin"}]},{"n":14,"key":"90:14","arabic":"أَوْ إِطْعَـٰمٌ فِى يَوْمٍ ذِى مَسْغَبَةٍ","page":594,"juz":30,"en":"Or feeding on a day of severe hunger","id":"atau memberi makan pada hari terjadi kelaparan,","latinEn":"Aw itAAamun fee yawmin theemasghaba","latinId":"Au iṭ‘āmun fī yaumin żī masgabah(tin).","words":[{"a":"أَوْ","en":"Or","id":"Or","t":"aw"},{"a":"إِطْعَـٰمٌۭ","en":"feeding","id":"feeding","t":"iṭ'ʿāmun"},{"a":"فِى","en":"in","id":"in","t":"fī"},{"a":"يَوْمٍۢ","en":"a day","id":"a day","t":"yawmin"},{"a":"ذِى","en":"of","id":"of","t":"dhī"},{"a":"مَسْغَبَةٍۢ","en":"severe hunger","id":"severe hunger","t":"masghabatin"}]},{"n":15,"key":"90:15","arabic":"يَتِيمًا ذَا مَقْرَبَةٍ","page":594,"juz":30,"en":"An orphan of near relationship","id":"(kepada) anak yatim yang ada hubungan kerabat,","latinEn":"Yateeman tha maqraba","latinId":"Yatīman żā maqrabah(tin).","words":[{"a":"يَتِيمًۭا","en":"An orphan","id":"An orphan","t":"yatīman"},{"a":"ذَا","en":"of","id":"of","t":"dhā"},{"a":"مَقْرَبَةٍ","en":"near relationship","id":"near relationship","t":"maqrabatin"}]},{"n":16,"key":"90:16","arabic":"أَوْ مِسْكِينًا ذَا مَتْرَبَةٍ","page":594,"juz":30,"en":"Or a needy person in misery","id":"atau orang miskin yang sangat fakir.","latinEn":"Aw miskeenan tha matraba","latinId":"Au miskīnan żā matrabah(tin).","words":[{"a":"أَوْ","en":"Or","id":"Or","t":"aw"},{"a":"مِسْكِينًۭا","en":"a needy person","id":"a needy person","t":"mis'kīnan"},{"a":"ذَا","en":"in","id":"in","t":"dhā"},{"a":"مَتْرَبَةٍۢ","en":"misery","id":"misery","t":"matrabatin"}]},{"n":17,"key":"90:17","arabic":"ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُوا۟ وَتَوَاصَوْا۟ بِٱلصَّبْرِ وَتَوَاصَوْا۟ بِٱلْمَرْحَمَةِ","page":594,"juz":30,"en":"And then being among those who believed and advised one another to patience and advised one another to compassion.","id":"Kemudian dia termasuk orang-orang yang beriman, dan saling berpesan untuk bersabar dan saling berpesan untuk berkasih sayang.","latinEn":"Thumma kana mina allatheena amanoowatawasaw bissabri watawasaw bilmarhama","latinId":"Ṡumma kāna minal-lażīna āmanū wa tawāṣau biṣ-ṣabri wa tawāṣau bil-marḥamah(ti).","words":[{"a":"ثُمَّ","en":"Then","id":"Then","t":"thumma"},{"a":"كَانَ","en":"he is","id":"he is","t":"kāna"},{"a":"مِنَ","en":"of","id":"of","t":"mina"},{"a":"ٱلَّذِينَ","en":"those who","id":"those who","t":"alladhīna"},{"a":"ءَامَنُوا۟","en":"believe","id":"believe","t":"āmanū"},{"a":"وَتَوَاصَوْا۟","en":"and enjoin (each other)","id":"and enjoin (each other)","t":"watawāṣaw"},{"a":"بِٱلصَّبْرِ","en":"to patience","id":"to patience","t":"bil-ṣabri"},{"a":"وَتَوَاصَوْا۟","en":"and enjoin (each other)","id":"and enjoin (each other)","t":"watawāṣaw"},{"a":"بِٱلْمَرْحَمَةِ","en":"to compassion","id":"to compassion","t":"bil-marḥamati"}]},{"n":18,"key":"90:18","arabic":"أُو۟لَـٰٓئِكَ أَصْحَـٰبُ ٱلْمَيْمَنَةِ","page":594,"juz":30,"en":"Those are the companions of the right.","id":"Mereka (orang-orang yang beriman dan saling berpesan itu) adalah golongan kanan.","latinEn":"Ola-ika as-habualmaymana","latinId":"Ulā'ika aṣḥābul-maimanah(ti).","words":[{"a":"أُو۟لَـٰٓئِكَ","en":"Those","id":"Those","t":"ulāika"},{"a":"أَصْحَـٰبُ","en":"(are the) companions","id":"(are the) companions","t":"aṣḥābu"},{"a":"ٱلْمَيْمَنَةِ","en":"(of) the right (hand)","id":"(of) the right (hand)","t":"l-maymanati"}]},{"n":19,"key":"90:19","arabic":"وَٱلَّذِينَ كَفَرُوا۟ بِـَٔايَـٰتِنَا هُمْ أَصْحَـٰبُ ٱلْمَشْـَٔمَةِ","page":595,"juz":30,"en":"But they who disbelieved in Our signs - those are the companions of the left.","id":"Dan orang-orang yang kafir kepada ayat-ayat Kami, mereka itu adalah golongan kiri.","latinEn":"Wallatheena kafaroo bi-ayatinahum as-habu almash-ama","latinId":"Wal-lażīna kafarū bi'āyātinā hum aṣḥābul-masy'amah(ti).","words":[{"a":"وَٱلَّذِينَ","en":"But those who","id":"But those who","t":"wa-alladhīna"},{"a":"كَفَرُوا۟","en":"disbelieve","id":"disbelieve","t":"kafarū"},{"a":"بِـَٔايَـٰتِنَا","en":"in Our Verses","id":"in Our Verses","t":"biāyātinā"},{"a":"هُمْ","en":"they","id":"they","t":"hum"},{"a":"أَصْحَـٰبُ","en":"(are the) companions","id":"(are the) companions","t":"aṣḥābu"},{"a":"ٱلْمَشْـَٔمَةِ","en":"(of) the left (hand)","id":"(of) the left (hand)","t":"l-mashamati"}]},{"n":20,"key":"90:20","arabic":"عَلَيْهِمْ نَارٌ مُّؤْصَدَةٌۢ","page":595,"juz":30,"en":"Over them will be fire closed in.","id":"Mereka berada dalam neraka yang ditutup rapat.","latinEn":"AAalayhim narun mu/sada","latinId":"‘Alaihim nārum mu'ṣadah(tun).","words":[{"a":"عَلَيْهِمْ","en":"Over them","id":"Over them","t":"ʿalayhim"},{"a":"نَارٌۭ","en":"(will be the) Fire","id":"(will be the) Fire","t":"nārun"},{"a":"مُّؤْصَدَةٌۢ","en":"closed in","id":"closed in","t":"mu'ṣadatun"}]}]}