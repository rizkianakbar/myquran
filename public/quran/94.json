{"version":2,"surah":94,"verses":[{"n":1,"key":"94:1","arabic":" أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ","page":596,"juz":30,"en":"Did We not expand for you, [O Muḥammad], your breast?","id":"Bukankah kami telah melapangkan dadamu (Muhammad)?","latinEn":"Alam nashrah laka sadrak","latinId":"Alam nasyraḥ laka ṣadrak(a).","words":[{"a":"أَلَمْ","en":"Have not","id":"Have not","t":"alam"},{"a":"نَشْرَحْ","en":"We expanded","id":"We expanded","t":"nashraḥ"},{"a":"لَكَ","en":"for you","id":"for you","t":"laka"},{"a":"صَدْرَكَ","en":"your breast","id":"your breast","t":"ṣadraka"}]},{"n":2,"key":"94:2","arabic":"وَوَضَعْنَا عَنكَ وِزْرَكَ","page":596,"juz":30,"en":"And We removed from you your burden","id":"dan kami pun telah menurunkan beban darimu,","latinEn":"WawadaAAna AAanka wizrak","latinId":"Wa waḍa‘nā ‘anka wizrak(a).","words":[{"a":"وَوَضَعْنَا","en":"And We removed","id":"And We removed","t":"wawaḍaʿnā"},{"a":"عَنكَ","en":"from you","id":"from you","t":"ʿanka"},{"a":"وِزْرَكَ","en":"your burden","id":"your burden","t":"wiz'raka"}]},{"n":3,"key":"94:3","arabic":"ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ","page":597,"juz":30,"en":"Which had weighed upon your back","id":"yang memberatkan punggungmu,","latinEn":"Allathee anqada thahrak","latinId":"Allażī anqaḍa ẓahrak(a).","words":[{"a":"ٱلَّذِىٓ","en":"Which","id":"Which","t":"alladhī"},{"a":"أَنقَضَ","en":"weighed upon","id":"weighed upon","t":"anqaḍa"},{"a":"ظَهْرَكَ","en":"your back","id":"your back","t":"ẓahraka"}]},{"n":4,"key":"94:4","arabic":"وَرَفَعْنَا لَكَ ذِكْرَكَ","page":597,"juz":30,"en":"And raised high for you your repute.","id":"dan kami tinggikan sebutan (nama)mu bagimu.","latinEn":"WarafaAAna laka thikrak","latinId":"Wa rafa‘nā laka żikrak(a).","words":[{"a":"وَرَفَعْنَا","en":"And We raised high","id":"And We raised high","t":"warafaʿnā"},{"a":"لَكَ","en":"for you","id":"for you","t":"laka"},{"a":"ذِكْرَكَ","en":"your reputation","id":"your reputation","t":"dhik'raka"}]},{"n":5,"key":"94:5","arabic":"فَإِنَّ مَعَ ٱلْعُسْر