{"version":2,"surah":96,"verses":[{"n":1,"key":"96:1","arabic":" ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ","page":597,"juz":30,"en":"Recite in the name of your Lord who created","id":"Bacalah dengan (menyebut) nama Tuhanmu yang menciptakan,","latinEn":"Iqra/ bi-ismi rabbika allathee khalaq","latinId":"Iqra' bismi rabbikal-lażī khalaq(a).","words":[{"a":"ٱقْرَأْ","en":"Read","id":"Read","t":"iq'ra"},{"a":"بِٱسْمِ","en":"in (the) name","id":"in (the) name","t":"bi-is'mi"},{"a":"رَبِّكَ","en":"(of) your Lord","id":"(of) your Lord","t":"rabbika"},{"a":"ٱلَّذِى","en":"the One Who","id":"the One Who","t":"alladhī"},{"a":"خَلَقَ","en":"created","id":"created","t":"khalaqa"}]},{"n":2,"key":"96:2","arabic":"خَلَقَ ٱلْإِنسَـٰنَ مِنْ عَلَقٍ","page":597,"juz":30,"en":"Created man from a clinging substance.","id":"Dia telah menciptakan manusia dari segumpal darah.","latinEn":"Khalaqa al-insana min AAalaq","latinId":"Khalaqal-insāna min ‘alaq(in).","words":[{"a":"خَلَقَ","en":"He created","id":"He created","t":"khalaqa"},{"a":"ٱلْإِنسَـٰنَ","en":"man","id":"man","t":"l-insāna"},{"a":"مِنْ","en":"from","id":"from","t":"min"},{"a":"عَلَقٍ","en":"a clinging substance","id":"a clinging substance","t":"ʿalaqin"}]},{"n":3,"key":"96:3","arabic":"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ","page":597,"juz":30,"en":"Recite, and your Lord is the most Generous -","id":"Bacalah, dan Tuhanmulah Yang Mahamulia.","latinEn":"Iqra/ warabbuka al-akram","latinId":"Iqra' wa rabbukal-akram(u).","words":[{"a":"ٱقْرَأْ","en":"Read","id":"Read","t":"iq'ra"},{"a":"وَرَبُّكَ","en":"and your Lord","id":"and your Lord","t":"warabbuka"},{"a":"ٱلْأَكْرَمُ","en":"(is) the Most Generous","id":"(is) the Most Generous","t":"l-akramu"}]},{"n":4,"key":"96:4","arabic":"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ","page":597,"juz":30,"en":"Who taught by the pen","id":"Yang mengajar (manusia) dengan pena.","latinEn":"Allathee AAallama bilqalam","latinId":"Allażī ‘allama bil-qalam(i).","words":[{"a":"ٱلَّذِى","en":"The One Who","id":"The One Who","t":"alladhī"},{"a":"عَلَّمَ","en":"taught","id":"taught","t":"ʿallama"},{"a":"بِٱلْقَلَمِ","en":"by the pen","id":"by the pen","t":"bil-qalami"}]},{"n":5,"key":"96:5","arabic":"عَلَّمَ ٱلْإِنسَـٰنَ مَا لَمْ يَعْلَمْ","page":597,"juz":30,"en":"Taught man that which he knew not.","id":"Dia mengajarkan manusia apa yang tidak diketahuinya.","latinEn":"AAallama al-insana ma lamyaAAlam","latinId":"‘Allamal-insāna mā lam ya‘lam.","words":[{"a":"عَلَّمَ","en":"Taught","id":"Taught","t":"ʿallama"},{"a":"ٱلْإِنسَـٰنَ","en":"man","id":"man","t":"l-insāna"},{"a":"مَا","en":"what","id":"what","t":"mā"},{"a":"لَمْ","en":"not","id":"not","t":"lam"},{"a":"يَعْلَمْ","en":"he knew","id":"he knew","t":"yaʿlam"}]},{"n":6,"key":"96:6","arabic":"كَلَّآ إِنَّ ٱلْإِنسَـٰنَ لَيَطْغَىٰٓ","page":597,"juz":30,"en":"No! [But] indeed, man transgresses","id":"Sekali-sekali tidak! Sungguh, manusia itu benar-benar melampaui batas,","latinEn":"Kalla inna al-insana layatgha","latinId":"Kallā innal-insāna layaṭgā.","words":[{"a":"كَلَّآ","en":"Nay","id":"Nay","t":"kallā"},{"a":"إِنَّ","en":"Indeed","id":"Indeed","t":"inna"},{"a":"ٱلْإِنسَـٰنَ","en":"man","id":"man","t":"l-insāna"},{"a":"لَيَطْغَىٰٓ","en":"surely transgresses","id":"surely transgresses","t":"layaṭghā"}]},{"n":7,"key":"96:7","arabic":"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ","page":597,"juz":30,"en":"Because he sees himself self-sufficient.","id":"apabila melihat dirinya serba cukup.","latinEn":"An raahu istaghna","latinId":"Ar ra'āhustagnā.","words":[{"a":"أَن","en":"That","id":"That","t":"an"},{"a":"رَّءَاهُ","en":"he sees himself","id":"he sees himself","t":"raāhu"},{"a":"ٱسْتَغْنَىٰٓ","en":"self-sufficient","id":"self-sufficient","t":"is'taghnā"}]},{"n":8,"key":"96:8","arabic":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ","page":597,"juz":30,"en":"Indeed, to your Lord is the return.","id":"Sungguh, hanya kepada Tuhanmulah tempat kembali(mu).","latinEn":"Inna ila rabbika arrujAAa","latinId":"Inna ilā rabbikar-ruj‘ā.","words":[{"a":"إِنَّ","en":"Indeed","id":"Indeed","t":"inna"},{"a":"إِلَىٰ","en":"to","id":"to","t":"ilā"},{"a":"رَبِّكَ","en":"your Lord","id":"your Lord","t":"rabbika"},{"a":"ٱلرُّجْعَىٰٓ","en":"(is) the return","id":"(is) the return","t":"l-ruj'ʿā"}]},{"n":9,"key":"96:9","arabic":"أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ","page":597,"juz":30,"en":"Have you seen the one who forbids","id":"Bagaimana pendapatmu tentang orang yang melarang?","latinEn":"Araayta allathee yanha","latinId":"Ara'aital-lażī yanhā.","words":[{"a":"أَرَءَيْتَ","en":"Have you seen","id":"Have you seen","t":"ara-ayta"},{"a":"ٱلَّذِى","en":"the one who","id":"the one who","t":"alladhī"},{"a":"يَنْهَىٰ","en":"forbids","id":"forbids","t":"yanhā"}]},{"n":10,"key":"96:10","arabic":"عَبْدًا إِذَا صَلَّىٰٓ","page":597,"juz":30,"en":"A servant when he prays?","id":"seorang hamba ketika dia melaksanakan salat,","latinEn":"AAabdan itha salla","latinId":"‘Abdan iżā ṣallā.","words":[{"a":"عَبْدًا","en":"A slave","id":"A slave","t":"ʿabdan"},{"a":"إِذَا","en":"when","id":"when","t":"idhā"},{"a":"صَلَّىٰٓ","en":"he prays","id":"he prays","t":"ṣallā"}]},{"n":11,"key":"96:11","arabic":"أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ","page":597,"juz":30,"en":"Have you seen if he is upon guidance","id":"bagaimana pendapatmu jika dia (yang dilarang salat itu) berada di atas kebenaran (petunjuk),","latinEn":"Araayta in kana AAala alhuda","latinId":"Ara'aita in kāna ‘alal-hudā.","words":[{"a":"أَرَءَيْتَ","en":"Have you seen","id":"Have you seen","t":"ara-ayta"},{"a":"إِن","en":"if","id":"if","t":"in"},{"a":"كَانَ","en":"he is","id":"he is","t":"kāna"},{"a":"عَلَى","en":"upon","id":"upon","t":"ʿalā"},{"a":"ٱلْهُدَىٰٓ","en":"[the] guidance","id":"[the] guidance","t":"l-hudā"}]},{"n":12,"key":"96:12","arabic":"أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ","page":597,"juz":30,"en":"Or enjoins righteousness?","id":"atau dia menyuruh bertakwa (kepada Allah)?","latinEn":"Aw amara bittaqwa","latinId":"Au amara bit-taqwā.","words":[{"a":"أَوْ","en":"Or","id":"Or","t":"aw"},{"a":"أَمَرَ","en":"he enj